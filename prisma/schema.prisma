// Database schema.
//
// Project-wide conventions:
//   - snake_case table and column names (@map / @@map), PascalCase models.
//   - Every timestamp is `timestamptz` (@db.Timestamptz), never `timestamp`.
//   - Money is `Decimal(12,2)`, never Float.
//   - `relationJoins` enabled: without it Prisma splits every relation into
//     several queries and merges them in the application — the classic N+1.
//
// Domain nouns with no English equivalent keep their Spanish name (`cedula`,
// `ruc`, `acess`), the same way nobody translates IBAN.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

// Prisma 7 removed `url` from the datasource. The migration connection now
// lives in `prisma.config.ts`, and the runtime client receives a driver
// adapter (@prisma/adapter-pg) built by the application.
// Real benefit: the connection pool is yours to control, not Prisma's.
datasource db {
  provider = "postgresql"
}

/// System user (clinical and administrative staff).
///
/// NOT the patient: a patient is a separate clinical entity. Merging them
/// forces you later to split two concepts with completely different lifecycles
/// and permissions.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Login identifier. Stored lowercase so signing in does not depend on how
  /// the user typed it.
  email String @unique @db.VarChar(255)

  /// Argon2id. The algorithm and its parameters travel inside the hash itself,
  /// so they can be hardened later without migrating existing rows.
  passwordHash String @map("password_hash") @db.VarChar(255)

  firstName String @map("first_name") @db.VarChar(120)
  lastName  String @map("last_name") @db.VarChar(120)

  /// Practitioner's cedula. Required by RDACAA reporting and for signing.
  ///
  /// `app_user_cedula_valid` (manual migration) refuses anything that is not a
  /// real cedula: ten digits, an existing province, third digit below 6 and a
  /// matching check digit. NULL stays legitimate and is the majority case —
  /// reception and billing staff have an account and no clinical profile.
  cedula String? @unique @db.VarChar(10)

  /// ACESS registration of the health professional. Without it they cannot
  /// sign prescriptions or medical certificates.
  acessRegistration String?   @map("acess_registration") @db.VarChar(32)
  acessExpiresOn    DateTime? @map("acess_expires_on") @db.Date

  active Boolean @default(true)

  // --- Second factor ---
  /// TOTP secret encrypted with AES-256-GCM. Never stored in clear text.
  mfaSecretEncrypted String?   @map("mfa_secret_encrypted") @db.Text
  mfaEnabledAt       DateTime? @map("mfa_enabled_at") @db.Timestamptz(6)

  /// AU-037. Secret of a second-factor change that has been STARTED and not
  /// yet confirmed, encrypted the same way.
  ///
  /// A COLUMN OF ITS OWN, and that is the requirement rather than a
  /// convenience: the factor in `mfa_secret_encrypted` has to keep working
  /// until the new one is confirmed. Reusing that column would mean a person
  /// who closes the tab halfway — or whose scan fails — is left with no second
  /// factor at all and no way to enrol another one. It is cleared in the same
  /// statement that installs the new secret, and that claim is what arbitrates
  /// two simultaneous changes.
  mfaPendingSecretEncrypted String? @map("mfa_pending_secret_encrypted") @db.Text

  /// Last consumed TOTP time step. Stops an intercepted code from being reused
  /// during the 30 seconds it remains valid.
  mfaLastStep BigInt? @map("mfa_last_step")

  /// AU-041. How many times every session of this account has been closed.
  /// Bumped by `revokeLiveSessions` (account scope) and compared, under a
  /// shared row lock, when a new session family is issued: a sign-in that
  /// read its credentials before a revocation cannot open a session after it.
  sessionEpoch Int @default(0) @map("session_epoch")

  // --- Brute force defence ---
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  backupCodes   BackupCode[]
  roleGrants    UserRoleGrant[] @relation("GrantHolder")
  grantsIssued  UserRoleGrant[] @relation("GrantIssuer")

  /// AU-021: the single-use links that let this person set their first
  /// password, and the ones they sent to somebody else.
  credentialInvitations     CredentialInvitation[] @relation("InvitationHolder")
  credentialInvitationsSent CredentialInvitation[] @relation("InvitationIssuer")

  /// Clinical profile. Optional: receptionists and billing staff have an
  /// account but no clinical role.
  practitioner Practitioner?

  /// AG-035, D-005: the overbookings this person AUTHORISED. Not the ones they
  /// booked — `agenda_entry.created_by_id` carries no relation, and keeping
  /// the two apart is the control itself (AG-103).
  overbookingsAuthorised AgendaEntry[] @relation("OverbookingAuthoriser")
  encountersAnnulled     Encounter[]   @relation("EncounterAnnuller")
  encountersDiscontinued Encounter[]   @relation("EncounterDiscontinuer")

  /// PA-039: the priority group records this person wrote, and the ones they
  /// closed. Two relations because they are two acts by two people at two
  /// moments, and «¿quién lo cerró?» is a question the closing has to answer
  /// as much as the recording does.
  priorityGroupsRecorded PatientPriorityGroup[] @relation("PriorityGroupRecorder")
  priorityGroupsClosed   PatientPriorityGroup[] @relation("PriorityGroupCloser")
  patientCorrections     PatientChangeHistory[] @relation("PatientChangeAuthor")

  /// PA-044. Merges and undos this person performed. `performed_by` is NOT
  /// NULL and carries a foreign key: merging joins two people's clinical
  /// records, and a trail nobody answers for is not a weaker trail, it is a
  /// useless one.
  patientMerges PatientMerge[] @relation("PatientMergeAuthor")

  /// EN-087. The «sin alergias conocidas» assertions this person made. The
  /// standard demands a named clinician behind each one, so this relation is
  /// the requirement rather than a convenience.
  allergyAbsencesAsserted PatientAllergyAbsence[] @relation("AllergyAbsenceAsserter")

  /// EN-086, EN-143, EN-085. Who wrote each nursing and background datum:
  /// D-048 puts the authorship IN the datum, not in the form that carries it.
  allergiesRecorded PatientAllergy[]  @relation("AllergyRecorder")
  allergiesRefuted  PatientAllergy[]  @relation("AllergyRefuter")
  vitalsRecorded    EncounterVitals[] @relation("VitalsRecorder")
  vitalsCorrected   EncounterVitals[] @relation("VitalsCorrector")
  historyRecorded   PatientHistory[]  @relation("HistoryRecorder")
  historyRefuted    PatientHistory[]  @relation("HistoryRefuter")

  /// AG-064. The waiting-list calls this person made. `RESTRICT` on the way
  /// back: the trail names whoever called, and an account is deactivated, never
  /// deleted (AU-024).
  waitlistContacts WaitlistContactAttempt[] @relation("WaitlistContactRecorder")

  /// Ley 77 art. 10. Who made the emergency call on arrival. Named, because
  /// art. 13 turns «nobody assessed them» into a criminal matter.
  emergencyFlagsRaised           AgendaEntry[]                @relation("EmergencyFlagger")
  prescriptionsDiscarded         Prescription[]               @relation("PrescriptionDiscarder")
  subjectStatusChanges           AgendaSubjectStatusHistory[] @relation("SubjectStatusChanger")
  chargeItemsVoided              ChargeItem[]                 @relation("ChargeVoider")
  billableServicesTaxReviewed    BillableService[]            @relation("TaxRateReviewer")
  agendaEntriesEmergencyAssessed AgendaEntry[]                @relation("EmergencyAssessor")

  /// Money. Two lists over `charge_item` and not one, because raising a charge
  /// and authorising a discount above the role's ceiling are two acts by two
  /// people — the second pair of eyes only counts if it is a different pair.
  chargeItemsCreated  ChargeItem[] @relation("ChargeItemAuthor")
  discountsAuthorised ChargeItem[] @relation("ChargeItemDiscountAuthoriser")
  invoicesIssued      Invoice[]    @relation("InvoiceIssuer")
  creditNotesIssued   CreditNote[] @relation("CreditNoteIssuer")

  /// DOC-002, DOC-030, DOC-056. The printable side of the system: the
  /// artefacts this person emitted, the template versions they published and
  /// the identity images they uploaded. All three are `RESTRICT` on the way
  /// back — an account is deactivated, never deleted (AU-024), and an archive
  /// whose author disappeared cannot answer «¿quién emitió esto?».
  documentRendersIssued      DocumentRender[]   @relation("DocumentRenderIssuer")
  documentTemplatesPublished DocumentTemplate[] @relation("DocumentTemplatePublisher")
  documentImagesUploaded     DocumentImage[]    @relation("DocumentImageUploader")

  @@index([email])
  @@map("app_user")
}

/// A permission the code actually checks.
///
/// The CATALOGUE is anchored to the code — a permission only means something
/// if some route asks for it, so you cannot invent one here and expect it to
/// protect anything. It is mirrored into this table so that role assignments
/// have referential integrity and so the admin interface can list what exists
/// without importing TypeScript. A test asserts the table and the code agree.
model Permission {
  code String @id @db.VarChar(64)

  /// Grouping for the administration screen: patient, agenda, record, billing.
  resource    String @db.VarChar(32)
  /// What it allows, in Spanish, for whoever assigns it.
  description String @db.VarChar(255)

  roles RolePermission[]

  @@index([resource])
  @@map("permission")
}

/// A role, as DATA.
///
/// Deliberately not an enum. A clinic hires an external auditor, splits
/// nursing into ward and outpatient, or brings in a health-insurance
/// liaison — none of which should require a migration and a deploy.
model Role {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Stable identifier used in seeds and logs. Uppercase, no spaces.
  code        String  @unique @db.VarChar(48)
  name        String  @db.VarChar(120)
  description String? @db.Text

  /// Ships with the product. Its permissions remain editable, but it cannot be
  /// deleted: an empty role table would lock everyone out, including whoever
  /// would fix it.
  isSystem Boolean @default(false) @map("is_system")
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions   RolePermission[]
  grants        UserRoleGrant[]
  discountLimit RoleDiscountLimit?

  @@map("role")
}

/// Which permissions a role carries. Editable by an administrator.
model RolePermission {
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionCode String     @map("permission_code") @db.VarChar(64)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedById String?  @map("granted_by_id") @db.Uuid

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

/// A one-off grant that `syncAuthorisation` has already made on THIS database.
///
/// «Once» cannot be inferred from the grants themselves: a permission missing
/// from a role may never have been granted, or may have been taken away by the
/// clinic, and only the second is a decision to respect. The row is what tells
/// them apart (AU-042).
model AuthorisationOneOff {
  name      String   @id @db.VarChar(64)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  /// What it granted, `ROLE → permission`: the audit trail of who started
  /// writing in the clinical record because of it.
  granted   String[] @default([])

  @@map("authorisation_one_off")
}

/// A role held by a user, scoped to one site or granted globally.
///
/// Permissions are NOT stored: they are derived from the role in code. A
/// permission only means something if some route checks it, and an editable
/// permission table produces rows that protect nothing. Roles are data — a
/// clinic adds an external auditor without a deploy — but the permission
/// catalogue is part of the code's contract.
model UserRoleGrant {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  /// Restrict, not Cascade: a grant is revoked, never deleted, so a cascade
  /// here could only ever fail — and it would fail with a message about role
  /// grants when the caller was trying to delete a user. Staff accounts are
  /// deactivated, not removed.
  user   User   @relation("GrantHolder", fields: [userId], references: [id], onDelete: Restrict)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// NULL means every site. A receptionist is hired at one site; the clinic
  /// director is not.
  siteId String? @map("site_id") @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// Who granted it. Nullable only for the seed, which has no author.
  grantedById String? @map("granted_by_id") @db.Uuid
  grantedBy   User?   @relation("GrantIssuer", fields: [grantedById], references: [id], onDelete: Restrict)

  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// Revoked, never deleted: who could do what and when is part of the audit
  /// trail, and a deleted row cannot answer that.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@index([roleId])
  @@map("user_role_grant")
}

/// Refresh token with rotation and reuse detection.
///
/// Tokens from the same sign-in form a FAMILY. If an already-used one arrives,
/// somebody holds a copy: the whole family is revoked. That turns a stolen
/// token into an alarm instead of a silent breach.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Groups every token derived from the same sign-in.
  familyId String @map("family_id") @db.Uuid

  /// SHA-256 of the token, never the token itself. If the database is stolen,
  /// active sessions are not.
  tokenHash String @unique @map("token_hash") @db.Char(64)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// Why it was revoked: ROTATION (normal use), REUSE (attack detected),
  /// SIGN_OUT, or PASSWORD_CHANGE.
  revocationReason String? @map("revocation_reason") @db.VarChar(32)

  ip        String? @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_token")
}

/// Single-use recovery codes.
///
/// Without these, a doctor who loses their phone is locked out of the medical
/// records. In an emergency that is not a usability problem, it is a patient
/// safety problem.
model BackupCode {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hashed with Argon2id like a password: it is a credential.
  codeHash String @map("code_hash") @db.VarChar(255)

  usedAt DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, usedAt])
  @@map("backup_code")
}

/// The first credential of an account, as a single-use link (AU-021, D-013).
///
/// AU-021 forbids the administrator choosing somebody else's password. D-013
/// settled how the first one reaches them instead: the system mails a link to
/// the institutional address and the person sets their own, so nobody else
/// ever knows it.
///
/// Like `RefreshToken`, only the SHA-256 of the token is stored — a stolen
/// dump contains no usable credential — and the token itself exists for the
/// length of one HTTP response.
///
/// NOT IN THIS FILE, and it cannot be: `credential_invitation_one_live_per_user`
/// is a PARTIAL unique index (`WHERE used_at IS NULL`) which `schema.prisma`
/// has no way to express. It is what makes a re-send invalidate the previous
/// link instead of adding a second one (AU-027), and it is on the protected
/// list of `scripts/check-migrations.mts` so nothing proposes dropping it.
model CredentialInvitation {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  /// Cascade, like `RefreshToken`: this is a credential artefact, not clinical
  /// evidence. An invitation outliving its account would be a live way to set
  /// the password of an account that no longer exists.
  user   User   @relation("InvitationHolder", fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, never the token. 64 hex characters, always.
  tokenHash String @unique @map("token_hash") @db.Char(64)

  /// 72 hours after issue. The number lives in one constant in the code,
  /// `CREDENTIAL_INVITATION_TTL_HOURS`, not in a database default: two
  /// definitions of one deadline is one that gets forgotten.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// NULL means live. It stops being live for two reasons and deliberately
  /// answers the same to both: the person redeemed it (AU-021), or somebody
  /// re-sent the invitation and this one was superseded (AU-027).
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Who invited them. NULL only for a seed, which has no author.
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("InvitationIssuer", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("credential_invitation")
}

/// Access log for personal and health data.
///
/// Required by Ecuador's LOPDP: you must be able to answer who read which
/// medical record, when, and from where. It is the primary evidence before the
/// data protection authority.
///
/// Append-only by design. Immutability is NOT enforced here but with a
/// PostgreSQL trigger in a separate migration: a convention that only lives in
/// application code is not auditable.
model AccessAudit {
  id BigInt @id @default(autoincrement())

  /// When the access happened. Always timestamptz.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// Who. Internal user identifier, NEVER their cedula.
  userId String? @map("user_id") @db.Uuid

  /// What was touched: resource type and its internal identifier.
  resourceType String @map("resource_type") @db.VarChar(64)
  resourceId   String @map("resource_id") @db.VarChar(64)

  /// What was done: READ, CREATE, UPDATE, EXPORT, PRINT...
  action String @db.VarChar(32)

  /// From where. The IP is personal data under LOPDP: it is stored because it
  /// is necessary to investigate improper access, and it is declared in the
  /// processing activities register.
  ip        String? @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)

  /// Correlation with the OpenTelemetry trace: lets you reconstruct the whole
  /// request from a single audit entry.
  traceId String? @map("trace_id") @db.VarChar(32)

  /// Reason stated during an emergency access (break-the-glass).
  /// Mandatory free text in that flow: a dropdown gets filled in on autopilot.
  emergencyReason String? @map("emergency_reason") @db.Text

  /// D-017, AG-097, CF-066. The state of the resource before the mutation and
  /// after it, so the trail says «desde qué valor» and not only who and when.
  ///
  /// ⚠️ WHICH RESOURCE TYPES MAY CARRY THESE IS DECIDED BY A `CHECK` THAT THIS
  /// FILE CANNOT DESCRIBE: `access_audit_payload_only_for_declared_resources`,
  /// in `20260814161031_access_audit_previous_value`. Today the whitelist is
  /// exactly `'configuration'`. Clinical resource types are NOT on it and must
  /// not be added — this table is append-only and never purged, so a chart's
  /// contents landing here could never be removed. Read the migration's header
  /// before touching either column.
  ///
  /// Null on every read, which is almost every row: a NULL lives in the row's
  /// null bitmap and costs no space.
  before Json? @db.JsonB
  after  Json? @db.JsonB

  /// AG-073. From which resource the access was reached — today, the
  /// appointment a chart was opened from (`agenda_entry`). Identifiers only.
  /// Both or neither: `access_audit_context_both_or_neither`, in
  /// `20260930140057_access_audit_context`.
  contextType String? @map("context_type") @db.VarChar(64)
  contextId   String? @map("context_id") @db.VarChar(64)

  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("access_audit")
}

// ===========================================================================
// CLINICAL CORE
//
// Rule of thumb: a value set only our code cares about is a Prisma enum; a
// value set the ministry publishes, versions and expects back in a report is a
// row in `catalog_concept`. Ministries change code lists far more often than
// we change state machines.
// ===========================================================================

enum PatientSex {
  MALE
  FEMALE
  /// Deliberately outside the RDACAA export mapping: the ministry form only
  /// accepts H/M. The export layer decides how to collapse these; the record
  /// itself must not lie about what was documented.
  INTERSEX
  UNKNOWN

  @@map("patient_sex")
}

enum IdentifierType {
  CEDULA
  PASSPORT
  REFUGEE_CARD
  FOREIGN_ID
  /// Newborn or unidentified patient. Never globally unique on its own.
  PROVISIONAL

  @@map("identifier_type")
}

enum IdentifierUse {
  OFFICIAL
  OLD
  TEMP

  @@map("identifier_use")
}

enum AgendaEntryKind {
  APPOINTMENT
  BLOCK

  @@map("agenda_entry_kind")
}

enum AgendaStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  FULFILLED
  CANCELLED
  NO_SHOW
  /// Only valid for kind = BLOCK, and a BLOCK only ever holds BOOKED, BLOCKED
  /// or CANCELLED. Enforced by `agenda_entry_kind_status_coherence` in a manual
  /// migration: the other five statuses assert something about a patient, and a
  /// block has none.
  BLOCKED
  /// The patient CAME and left before being attended. It exists because both
  /// alternatives were lies: NO_SHOW asserts they never came — and poisons the
  /// no-show rate of AG-080 that AG-032 went to lengths to keep honest — and
  /// closing the visit asserts an encounter that may never have been opened.
  LEFT_WITHOUT_BEING_SEEN
  /// The entry should never have existed. Voiding a real appointment and
  /// deleting one created by mistake are different events, and counting them
  /// together corrupts the cancellation metric.
  ENTERED_IN_ERROR

  @@map("agenda_status")
}

/// WHERE THE PATIENT IS, which is a different axis from what the clinical act
/// is doing (`EncounterStatus`). HL7 FHIR R5 split the two that R4 had merged,
/// and this is the split the day board needs: a patient can be RECEIVING_CARE
/// while the encounter is ON_HOLD because they went down for an X-ray.
///
/// It hangs off `agenda_entry` and NOT off `encounter` on purpose: the patient
/// is in the waiting room before any encounter exists, and a walk-in gets an
/// agenda entry too (AG-029). On the encounter, the board could not show the
/// person who has just arrived.
enum PatientSubjectStatus {
  ARRIVED
  IN_PREPARATION
  READY
  RECEIVING_CARE
  /// Out of the building and EXPECTED BACK within this same visit.
  ON_LEAVE
  DEPARTED

  @@map("patient_subject_status")
}

/// How the clinic was asked for the appointment. A closed list because AG-080
/// reports the no-show rate grouped by it: as free text it accepted 'telefono'
/// and 'Phone' as different channels.
enum BookingChannel {
  PHONE
  WALK_IN
  WEB
  REFERRAL

  @@map("booking_channel")
}

enum CareModality {
  MORBIDITY
  PREVENTION

  @@map("care_modality")
}

enum CareSetting {
  INTRAMURAL
  EXTRAMURAL

  @@map("care_setting")
}

enum VisitSequence {
  FIRST_TIME
  SUBSEQUENT

  @@map("visit_sequence")
}

/// The ADMINISTRATIVE state of the clinical ACT, the other half of the pair
/// with `PatientSubjectStatus`.
///
/// Before this column, "open" meant `ended_at IS NULL`. That works for two
/// states and breaks at five, and five is what the flow has. What it could not
/// express is the stretch that costs the clinic money: the doctor has signed
/// and the patient is still at the cashier.
enum EncounterStatus {
  OPEN
  /// Suspended and EXPECTED BACK — the patient stepped out for a test and
  /// returns to this same encounter.
  ON_HOLD
  /// Begun and NOT able to be completed, for a reason that may be the clinic's
  /// — an emergency call, a power cut — and not only the patient's. Folding it
  /// into ABANDONED erases an operational problem worth seeing.
  DISCONTINUED
  /// CLINICALLY complete and signed, administratively pending: charges,
  /// invoice, documents to hand over, next appointment.
  DISCHARGED
  /// Everything done. The patient has left and the account is settled.
  COMPLETED
  /// Should never have existed, and deliberately distinct from a real closure
  /// so that it does not count as one.
  ENTERED_IN_ERROR

  @@map("encounter_status")
}

/// EN-129, EN-167. Where an interruption came from: a clinical fact about the
/// patient, or an operational failure of the clinic. Counted apart.
enum EncounterDiscontinuedOrigin {
  PATIENT
  ESTABLISHMENT

  @@map("encounter_discontinued_origin")
}

enum DischargeCondition {
  ALIVE
  REFERRED
  DECEASED
  ABANDONED

  @@map("discharge_condition")
}

/// RDACAA: presuntivo vs definitivo.
enum DiagnosisCertainty {
  PRESUMPTIVE
  DEFINITIVE

  @@map("diagnosis_certainty")
}

/// RDACAA: first time vs subsequent, PER DIAGNOSIS — not per encounter. A
/// patient can get a first-time diabetes diagnosis during a subsequent visit
/// for hypertension.
enum DiagnosisOccurrence {
  FIRST_TIME
  SUBSEQUENT

  @@map("diagnosis_occurrence")
}

enum NoteStatus {
  DRAFT
  SIGNED
  SUPERSEDED
  /// Retracted with no replacement. Different from SUPERSEDED, which always
  /// points at the version that took over.
  ENTERED_IN_ERROR

  @@map("note_status")
}

enum ViolenceScreeningResult {
  NOT_APPLIED
  NO_SIGNS
  SUSPECTED
  CONFIRMED

  @@map("violence_screening_result")
}

enum ViolenceType {
  PHYSICAL
  PSYCHOLOGICAL
  SEXUAL
  NEGLECT
  ECONOMIC

  @@map("violence_type")
}

enum PrescriptionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  /// Un borrador que se tecleó mal y nunca salió de la consulta.
  ///
  /// ⚠️ NO es `CANCELLED`, y por eso existe. Anular una receta EMITIDA es un
  /// acto con peso: el papel está en la mano del paciente y la farmacia puede
  /// haber dispensado contra él. Descartar un borrador es limpieza — nada
  /// salió de la sala. Juntar los dos dejaría «esta receta se anuló» sin poder
  /// contestar cuál de los dos ocurrió.
  DISCARDED

  @@map("prescription_status")
}

enum ServiceOrderCategory {
  LABORATORY
  IMAGING
  PROCEDURE

  @@map("service_order_category")
}

enum ServiceOrderPriority {
  ROUTINE
  URGENT
  STAT

  @@map("service_order_priority")
}

enum ServiceOrderItemStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("service_order_item_status")
}

enum DiagnosticReportStatus {
  PARTIAL
  FINAL
  CORRECTED
  CANCELLED

  @@map("diagnostic_report_status")
}

enum AbnormalFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH

  @@map("abnormal_flag")
}

enum CertificateType {
  ATTENDANCE
  MEDICAL_REST
  FITNESS
  DISABILITY_SUPPORT

  @@map("certificate_type")
}

enum ReferralDirection {
  REFERRAL
  DERIVATION
  COUNTER_REFERRAL

  @@map("referral_direction")
}

enum ReferralStatus {
  ISSUED
  ACCEPTED
  REJECTED
  COMPLETED
  EXPIRED

  @@map("referral_status")
}

enum InterconsultationStatus {
  REQUESTED
  ANSWERED
  CANCELLED

  @@map("interconsultation_status")
}

enum WaitlistStatus {
  WAITING
  CONTACTED
  SCHEDULED
  EXPIRED
  CANCELLED

  @@map("waitlist_status")
}

/// AG-064. What happened on a contact attempt.
///
/// THREE VALUES BECAUSE THREE THINGS HAPPEN TO THE SLOT, not for the sake of
/// detail: nobody answering expires the entry (AG-066), a refusal closes it by
/// the patient's own decision, and an acceptance is the only confirmation that
/// authorises converting the entry into an appointment — which is the half of
/// AG-064 that says the slot is not reassigned without one.
enum WaitlistContactOutcome {
  NO_ANSWER
  ACCEPTED
  DECLINED

  @@map("waitlist_contact_outcome")
}

/// EN-064. Column 23 of the RDACAA: 1 standing, 2 lying down.
enum HeightPosition {
  STANDING
  LYING

  @@map("height_position")
}

/// EN-085. Whose history it is: the patient's own or a relative's.
enum PatientHistoryKind {
  PERSONAL
  FAMILY

  @@map("patient_history_kind")
}

enum AllergyCriticality {
  LOW
  HIGH
  UNABLE_TO_ASSESS

  @@map("allergy_criticality")
}

// ---------------------------------------------------------------------------
// CATALOGS
// ---------------------------------------------------------------------------

/// A code system: CIE-10, CNMB, INEC DPA, ethnicity, priority groups, tariff.
///
/// One generic machine instead of one table per catalogue. All of them need
/// validity periods, the official release that introduced each code, and
/// accent-insensitive search, and none needs typed columns badly enough to
/// justify duplicating that machinery five times.
model CatalogSystem {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// CIE10, CNMB, DPA, TARIFF, ETHNICITY, NATIONALITY, PRIORITY_GROUP,
  /// SERVICE_TYPE, SPECIALTY, GENDER_IDENTITY.
  code String @unique @db.VarChar(32)
  name String @db.VarChar(160)

  /// FHIR CodeSystem.url, so the translation layer never hardcodes a URI.
  canonicalUri String? @map("canonical_uri") @db.VarChar(255)

  /// Whether concepts form a tree (DPA and CIE-10 do; ethnicity does not).
  hierarchical Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  releases CatalogRelease[]
  concepts CatalogConcept[]

  @@map("catalog_system")
}

/// An official publication of a catalogue. Provenance, not versioning:
/// versioning lives on each concept's validity period.
model CatalogRelease {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  systemId String        @map("system_id") @db.Uuid
  system   CatalogSystem @relation(fields: [systemId], references: [id], onDelete: Restrict)

  version       String    @db.VarChar(64)
  publishedOn   DateTime? @map("published_on") @db.Date
  effectiveFrom DateTime  @map("effective_from") @db.Date
  sourceUrl     String?   @map("source_url") @db.VarChar(512)

  /// Checksum of the imported file. Proves which artefact produced the rows,
  /// which matters when the ministry silently republishes a spreadsheet under
  /// the same version number.
  sourceChecksum String? @map("source_checksum") @db.Char(64)

  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  introducedConcepts CatalogConcept[] @relation("ConceptIntroducedBy")
  retiredConcepts    CatalogConcept[] @relation("ConceptRetiredBy")

  @@unique([systemId, version])
  @@map("catalog_release")
}

/// One version of one code.
///
/// The surrogate `id` is the whole point: clinical rows reference THIS ROW, not
/// the code string, so "resolve a 2024 diagnosis against the 2024 catalogue"
/// stops being a query everyone forgets to write and becomes a foreign key.
///
/// It is also forced: PostgreSQL 18 only lets a temporal PRIMARY KEY be
/// referenced by a temporal FOREIGN KEY (PERIOD), and those support NO ACTION
/// only. Without the surrogate key there could be no foreign key at all.
model CatalogConcept {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  systemId String        @map("system_id") @db.Uuid
  system   CatalogSystem @relation(fields: [systemId], references: [id], onDelete: Restrict)

  /// Not unique on its own: unique per non-overlapping validity period, via
  /// `UNIQUE (system_id, code, valid_period WITHOUT OVERLAPS)` in a manual
  /// migration. Prisma cannot express that.
  code    String @db.VarChar(32)
  display String @db.VarChar(512)

  /// Self-reference for DPA and CIE-10 chapters. DPA codes are hierarchical by
  /// prefix (province = left(code,2), canton = left(code,4)), so no
  /// denormalised province/canton columns are needed anywhere.
  parentId String?          @map("parent_id") @db.Uuid
  parent   CatalogConcept?  @relation("ConceptTree", fields: [parentId], references: [id], onDelete: Restrict)
  children CatalogConcept[] @relation("ConceptTree")

  validFrom DateTime  @map("valid_from") @db.Date
  /// NULL means still in force.
  validTo   DateTime? @map("valid_to") @db.Date

  /// Turned into `GENERATED ALWAYS AS daterange(...) STORED` by a manual
  /// migration. STORED and not VIRTUAL because PostgreSQL 18 cannot index or
  /// constrain virtual columns. Declared here so Prisma never drops it.
  validPeriod Unsupported("daterange")?

  /// Catalogue-specific payload: ATC code for CNMB, chapter for CIE-10,
  /// amount for TARIFF.
  attributes Json? @db.JsonB

  introducedByReleaseId String?         @map("introduced_by_release_id") @db.Uuid
  introducedByRelease   CatalogRelease? @relation("ConceptIntroducedBy", fields: [introducedByReleaseId], references: [id], onDelete: Restrict)

  retiredByReleaseId String?         @map("retired_by_release_id") @db.Uuid
  retiredByRelease   CatalogRelease? @relation("ConceptRetiredBy", fields: [retiredByReleaseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  patientsEthnicity       Patient[]                  @relation("PatientEthnicity")
  patientsNationality     Patient[]                  @relation("PatientNationality")
  patientsResidence       Patient[]                  @relation("PatientResidenceParish")
  patientsGenderIdentity  Patient[]                  @relation("PatientGenderIdentity")
  patientsPeople          Patient[]                  @relation("PatientPeople")
  patientsOrientation     Patient[]                  @relation("PatientSexualOrientation")
  sites                   Site[]                     @relation("SiteParish")
  scheduleRules           PractitionerScheduleRule[]
  /// NO HAY `agendaEntries` NI `waitlistEntries` AQUÍ, y la ausencia es el
  /// arreglo: la cita registra su tipo de atención en `service_type` —el
  /// catálogo propio de la clínica, SP-020— y no en un concepto clínico del
  /// MSP. Con C4 lo hizo la cita; con
  /// `waitlist_service_type_follows_agenda`, la lista de espera, que se había
  /// quedado atrás y por eso AG-061 no podía comparar los dos tipos.
  encounterPriorityGroups EncounterPriorityGroup[]
  diagnoses               EncounterDiagnosis[]
  procedures              EncounterProcedure[]
  prescriptionItems       PrescriptionItem[]
  serviceOrderItems       ServiceOrderItem[]
  observationResults      ObservationResult[]        @relation("ObservationAnalyte")
  allergies               PatientAllergy[]
  referrals               Referral[]                 @relation("ReferralSpecialty")
  interconsultations      Interconsultation[]        @relation("InterconsultationSpecialty")
  billableServices        BillableService[]

  @@index([systemId, code])
  @@index([parentId])
  @@map("catalog_concept")
}

// ---------------------------------------------------------------------------
// ORGANISATION
// ---------------------------------------------------------------------------

/// The health establishment as the MSP knows it (OR-001): typology, unique
/// code and RUC. Owns one or more sites.
///
/// SEPARATE FROM `Site` since ADR-011. `Site` conflated the two because the
/// clinic starts with a single establishment, and the code the RDACAA demands
/// per attention (REQ-020) belongs to the establishment, not to the building.
/// Splitting them while there is one row costs a migration; with two years of
/// history it would not be possible.
model Establishment {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Unique establishment code issued by the MSP (OR-002).
  mspUnicode String @unique @map("msp_unicode") @db.VarChar(20)

  /// MSP typology of A.M. 00000079: what determines the reporting duties.
  typology  String  @db.VarChar(64)
  legalName String  @map("legal_name") @db.VarChar(160)
  /// Shape guaranteed by `establishment_ruc_format`; the rest of the SRI rule
  /// by the `Ruc` value object (OR-008, OR-009).
  ruc       String? @db.VarChar(13)

  active Boolean @default(true)

  /// DOC-057. The clinic's logo, printed at the head of every document and, on
  /// the RIDE, at the position the SRI's Anexo 2 marks. PNG or JPEG only, and
  /// re-encoded on the way in — never the bytes that arrived (DOC-050 to
  /// DOC-054). NULL is legitimate and is what a fresh installation looks like:
  /// the logo is not a mandatory field of any of the four documents (DOC-059).
  logoImageId String?        @map("logo_image_id") @db.Uuid
  logoImage   DocumentImage? @relation("EstablishmentLogo", fields: [logoImageId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "establishment_logo_image_fk")

  /// DOC-077. THE FISCAL LEGENDS THE RIDE HAS TO CARRY, from the SRI's Ficha
  /// Técnica Anexo 2. They are not decoration: their absence on a printed RIDE
  /// is what a review looks at, and until this migration there was not even a
  /// column for them.
  ///
  /// The two resolution numbers are NULLABLE STRINGS AND NOT BOOLEANS on
  /// purpose: the legend the SRI prints is «Contribuyente Especial Nro. 1234»,
  /// so a boolean would say the establishment is one and be unable to print
  /// which one. Present means yes, and `establishment_special_taxpayer_format`
  /// keeps the value to digits.
  keepsAccounting            Boolean     @default(false) @map("keeps_accounting")
  specialTaxpayerResolution  String?     @map("special_taxpayer_resolution") @db.VarChar(16)
  withholdingAgentResolution String?     @map("withholding_agent_resolution") @db.VarChar(16)
  rimpeRegime                RimpeRegime @default(NONE) @map("rimpe_regime")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sites Site[]

  @@map("establishment")
}

/// A physical site of the clinic. Not a tenant: the whole database belongs to
/// one clinic. It exists because RDACAA is reported per establishment code.
model Site {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Unique establishment code issued by the MSP. The single most important
  /// field for RDACAA reporting.
  mspUnicode String @unique @map("msp_unicode") @db.VarChar(20)

  /// NULLABLE only so the rows that predate `establishment` survived the
  /// migration; `seed-organization.mts` backfills them (OR-004).
  establishmentId String?        @map("establishment_id") @db.Uuid
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  name String  @db.VarChar(160)
  ruc  String? @db.VarChar(13)

  parishConceptId String?         @map("parish_concept_id") @db.Uuid
  parish          CatalogConcept? @relation("SiteParish", fields: [parishConceptId], references: [id], onDelete: Restrict)

  addressLine String? @map("address_line") @db.VarChar(255)
  phone       String? @db.VarChar(32)
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rooms           SiteRoom[]
  emissionPoints  EmissionPoint[]
  holidays        Holiday[]
  parameters      SiteParameter?
  workedHolidays  HolidaySiteException[]
  roleGrants      UserRoleGrant[]
  practitioners   PractitionerSite[]
  scheduleRules   PractitionerScheduleRule[]
  agendaEntries   AgendaEntry[]
  encounters      Encounter[]
  waitlistEntries WaitlistEntry[]
  serviceOrders   ServiceOrder[]
  priceLists      PriceList[]
  patientAccounts PatientAccount[]
  invoices        Invoice[]
  documentRenders DocumentRender[]

  @@map("site")
}

/// Consulting room (FHIR Location). It exists so two practitioners cannot be
/// assigned the same room at the same time — a second exclusion constraint.
model SiteRoom {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  name   String  @db.VarChar(80)
  active Boolean @default(true)

  agendaEntries AgendaEntry[]

  @@unique([siteId, name])
  /// Redundant as uniqueness — `id` is already the key — and REQUIRED as the
  /// TARGET of `agenda_entry_room_in_site`, the composite foreign key that
  /// moves OR-021 (AG-105) out of TypeScript and into the base. That foreign
  /// key itself CANNOT be expressed here: `siteId` already backs the `site`
  /// relation on `AgendaEntry`, and Prisma would read a second relation over
  /// the same scalar as a conflict. It lives in the migration, like the
  /// EXCLUDE constraints and the generated columns.
  @@unique([id, siteId], map: "site_room_id_site_unique")
  @@map("site_room")
}

/// SRI point of emission (OR-023). Stored here as DATA only: the sequential
/// numbering, the signature and the dialogue with the SRI belong to `billing`
/// (REQ-085, OR-025).
model EmissionPoint {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// Exactly three digits, leading zero significant: «001» is not 1.
  code        String  @db.Char(3)
  description String? @db.VarChar(120)
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoices    Invoice[]
  creditNotes CreditNote[]

  @@unique([siteId, code], map: "emission_point_code_unique_per_site")
  @@map("emission_point")
}

/// A non-working day, for one site or for all of them (CF-060).
///
/// `date` and not a timestamp: a holiday is a day of the civil calendar, not
/// an instant. Storing it as an instant would force picking an hour and then
/// resolving it back in `America/Guayaquil` to know which day it was.
///
/// The uniqueness of CF-061 CANNOT be expressed here: it is
/// `UNIQUE NULLS NOT DISTINCT (date, site_id)`, which Prisma has no syntax
/// for, and a plain `@@unique` would leave the "all sites" rows unconstrained
/// — precisely the row that does the most damage, since every site obeys it.
/// It lives in the migration, like the EXCLUDE constraints.
model Holiday {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  date DateTime @db.Date
  name String   @db.VarChar(160)

  /// NULL means EVERY site. That is the «alcance» of CF-060.
  ///
  /// Cascade, against this schema's general RESTRICT rule and deliberately: a
  /// holiday of a site is not clinical evidence, nothing references it, and it
  /// has no meaning apart from its site. See the migration's header.
  siteId String? @map("site_id") @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// AG-092. The sites that work this holiday anyway.
  workedBy HolidaySiteException[]

  @@index([date], map: "holiday_by_date")
  @@map("holiday")
}

/// AG-092. The site WORKS that holiday: A&E opens on 25 December without the
/// holiday ceasing to apply to every other site.
///
/// A row and not a flag on `holiday`, because «working for whom» is N sites per
/// holiday. The meaning is uniform for both scopes: on a local holiday it
/// reads the same and amounts to deleting it, which is why nothing restricts
/// this to national ones. See the migration's header.
model HolidaySiteException {
  holidayId String  @map("holiday_id") @db.Uuid
  holiday   Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([holidayId, siteId])
  @@index([siteId], map: "holiday_site_exception_by_site")
  @@map("holiday_site_exception")
}

/// What is done with cancelled appointments once they are old (D-001, D-004).
///
/// ONE value today, on purpose. D-004 settled that the system never deletes
/// clinical history and D-001 chose «no borrar» for cancelled appointments, so
/// `NEVER` is the only policy that exists. It is an enum rather than a boolean
/// so that a future `PURGE_AFTER_DAYS` is `ALTER TYPE … ADD VALUE` plus a
/// column instead of rewriting the column and every row.
enum CancelledRetentionPolicy {
  NEVER

  @@map("cancelled_retention_policy")
}

/// The operating numbers of one site (CF-062, D-001).
///
/// One row per site, written by the database itself when the site is created
/// (`trg_site_parameter_defaults`): `organization` owns the site and must not
/// know this module's tables (ADR-011), and a site inserted by a data import
/// has to end up just as parametrised as one created from the screen.
///
/// The ranges of CF-065 are CHECK constraints in the migration; Prisma cannot
/// express them, and they are what makes the guarantee survive a `psql`.
model SiteParameter {
  /// The primary key IS the site: one row per site, never two.
  siteId String @id @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// Minutes that must pass between now and the appointment (D-001: 0).
  minLeadMinutes Int @default(0) @map("min_lead_minutes")
  /// How far ahead the agenda may be booked (D-001: 180 days).
  maxLeadDays    Int @default(180) @map("max_lead_days")
  /// Deliberate overbookings allowed per practitioner and day (D-001: 2).
  overbookingCap Int @default(2) @map("overbooking_cap")

  /// D-021. The atom of the agenda: the increment this site dices its day
  /// into, and the number every configurable duration must be a multiple of
  /// (D-021: 10 minutes).
  slotAtomMinutes Int @default(10) @map("slot_atom_minutes")

  /// AG-031. The site accepts appointments that start in the past (recording
  /// after the fact). `false` by default on purpose — see the migration.
  allowPastBooking Boolean @default(false) @map("allow_past_booking")

  /// AG-039, AG-094. The site admits overbookings. `true` by default, which is
  /// the OPPOSITE choice to `allowPastBooking` and deliberate: the overbooking
  /// is the documented way of breaking the grid (D-005), and what keeps it
  /// from becoming the normal route is `overbookingCap`, not a switch nobody
  /// turned on.
  overbookingEnabled Boolean @default(true) @map("overbooking_enabled")

  /// AG-101, AG-094. Which permission authorises an overbooking here.
  ///
  /// A PERMISSION CODE STORED AS DATA, and the only one in this schema. What
  /// keeps it from being any string: the application refuses a code the
  /// CATALOGUE does not declare (`UNKNOWN_PERMISSION`) and one this
  /// installation has not seeded (`PERMISSION_NOT_INSTALLED`), and
  /// `trg_site_parameter_overbooking_permission` refuses a CHANGE to a code
  /// that is not in `permission` — a trigger and not a foreign key, because a
  /// key would also be checked on the INSERT that `trg_site_parameter_defaults`
  /// performs for every new site, tying site creation to the permission mirror
  /// being seeded. See the migration.
  overbookingPermission String @default("agenda:overbook") @map("overbooking_permission") @db.VarChar(64)

  /// AG-066, AG-094. How many contact attempts exhaust a waiting-list entry
  /// here. The last of the eight parameters AG-094 enumerates and the only one
  /// that never had a column, because E5 had not been opened.
  ///
  /// THE NUMBER IS THE USER'S DECISION and is pending in
  /// `DECISIONES-PENDIENTES.md`: D-001 fixed the starting values of the others
  /// and did not include this one. It ships as 3 so that every site HAS a
  /// value, and being per-site and editable without a deploy (REQ-145) is what
  /// makes a wrong default cost a screen instead of a migration.
  waitlistMaxContactAttempts Int @default(3) @map("waitlist_max_contact_attempts")

  /// D-A-001. OFF by default: no norm requires triage of an outpatient
  /// establishment — A.M. 00030-2020 art. 27 lists no emergency service in the
  /// «centro de especialidades» portfolio — and no validated scale exists for
  /// scheduled outpatient care. Switched on, the scale is Manchester, the
  /// vocabulary the Ecuadorian typology itself uses, never ESI, which defines
  /// itself as an emergency-department tool.
  triageEnabled Boolean @default(false) @map("triage_enabled")

  /// D-A-005. ON by default because this clinic's doctors do hold
  /// certificates. A PARAMETER and not a constant so a clinic without them is
  /// not left unable to work: for the electronic prescription,
  /// ARCSA-DE-2022-012-AKRG (Disposición General Décima) accepts «la signatura
  /// realizada en el sistema informático mediante el registro con usuario y
  /// clave de acceso».
  requireCertifiedSignature Boolean @default(true) @map("require_certified_signature")

  /// D-A-011. Fifteen years from the last encounter: 5 active + 10 passive.
  /// NOT setting a period is what breaches the LOPDP — art. 10.i obliges the
  /// controller to «establecer plazos para su supresión o revisión periódica»
  /// and art. 51 to declare them. Nothing is ever purged automatically: this
  /// drives the review, not a delete.
  recordRetentionYears Int @default(15) @map("record_retention_years") @db.SmallInt

  /// Late arrival is NOT a status. It is the difference between the
  /// appointment time and the check-in instant, both of which are already
  /// stored; this is only the threshold above which the difference means
  /// something, and the clinic decides it.
  lateArrivalGraceMinutes Int @default(15) @map("late_arrival_grace_minutes") @db.SmallInt

  /// AG-120. Qué permiso salta el umbral de llegada tardía, hermana de la que
  /// la sede ya usa para el sobrecupo. Por defecto la misma: dejar pasar a
  /// alguien fuera de plazo ES romper la rejilla, y una clínica que ya decidió
  /// quién puede una cosa ha contestado la otra. Cada sede puede cambiarla.
  lateArrivalOverridePermission String @default("agenda:overbook") @map("late_arrival_override_permission") @db.VarChar(64)

  cancelledRetention CancelledRetentionPolicy @default(NEVER) @map("cancelled_retention")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_parameter")
}

/// Clinical profile of a system user.
///
/// Separate from `app_user` because they are different things with different
/// lifecycles: `app_user` is an account (credentials, MFA, lockout);
/// `Practitioner` is a clinical role. Receptionists have the first, not both.
model Practitioner {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Professional code assigned by the MSP, required per attention by RDACAA.
  /// Cedula and ACESS registration already live on `app_user`, not duplicated.
  mspCode String? @map("msp_code") @db.VarChar(32)

  /// Whether this practitioner takes appointments. A pathologist has a clinical
  /// profile but no agenda.
  schedulable Boolean @default(true)
  active      Boolean @default(true)

  /// DOC-057, DOC-060. THE PRESCRIBER'S SEAL AND SIGNATURE, which art. 5 of the
  /// Resolución ACESS-2023-0030 demands TWICE — `d.iii` on the prescriber block
  /// and `e.iv` on the tear-off indications — and for which there was not even
  /// a column until this migration.
  ///
  /// PER PRACTITIONER AND NOT PER ESTABLISHMENT: the seal says who signed, not
  /// where. NULL is legitimate and prints a labelled empty box — the system
  /// cannot manufacture a seal, and a drawn one would be a forged one. Art.
  /// 5.d.iii is textual: «no se aceptarán rúbricas o trazos por firma».
  sealImageId String?        @map("seal_image_id") @db.Uuid
  sealImage   DocumentImage? @relation("PractitionerSeal", fields: [sealImageId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "practitioner_seal_image_fk")

  signatureImageId String?        @map("signature_image_id") @db.Uuid
  signatureImage   DocumentImage? @relation("PractitionerSignature", fields: [signatureImageId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "practitioner_signature_image_fk")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sites              PractitionerSite[]
  scheduleRules      PractitionerScheduleRule[]
  agendaEntries      AgendaEntry[]
  encounters         Encounter[]
  authoredNotes      ClinicalNote[]             @relation("NoteAuthor")
  signedNotes        ClinicalNote[]             @relation("NoteSigner")
  prescriptions      Prescription[]
  serviceOrders      ServiceOrder[]
  diagnosticReports  DiagnosticReport[]
  certificates       MedicalCertificate[]
  referralsIssued    Referral[]                 @relation("ReferralIssuer")
  interconsultAsked  Interconsultation[]        @relation("InterconsultRequester")
  interconsultAnswer Interconsultation[]        @relation("InterconsultResponder")
  waitlistEntries    WaitlistEntry[]
  specialties        PractitionerSpecialty[]
  durationExceptions DurationException[]

  /// D-A-010. NOT the same list as `encounters`: that one is who opened them,
  /// this one is who closed them, and keeping the two apart is what lets the
  /// substitute closure be seen at all.
  encountersClosed Encounter[] @relation("EncounterCloser")

  @@map("practitioner")
}

/// The clinic's specialty catalogue (D-008): MSP-preloaded, editable, never
/// deleted while referenced — deactivated instead (SP-003, SP-004).
model Specialty {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Stable English code: the contract for RDACAA and billing. Uniqueness is
  /// case-insensitive via a functional index in the manual migration; same
  /// for `name`, accent-insensitive (SP-006). Prisma cannot express either.
  code String @db.VarChar(64)
  name String @db.VarChar(160)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  practitioners    PractitionerSpecialty[]
  serviceTypes     ServiceType[]
  /// BI-158. The consultation services of this specialty, first-visit and
  /// subsequent. `RESTRICT`: a specialty somebody charges for is deactivated,
  /// never deleted.
  billableServices BillableService[]

  @@map("specialty")
}

/// A practitioner holds one or more specialties, exactly one primary — the
/// "at most one" lives in a partial unique index (SP-005); the "at least one"
/// is the service's job when assigning.
model PractitionerSpecialty {
  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  specialtyId String    @map("specialty_id") @db.Uuid
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([practitionerId, specialtyId])
  @@index([specialtyId])
  @@map("practitioner_specialty")
}

/// Attention type within a specialty, with its base duration (SP-020). The
/// 5..240-in-multiples-of-5 range is a CHECK in the manual migration (SP-021).
model ServiceType {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  specialtyId String    @map("specialty_id") @db.Uuid
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  name            String @db.VarChar(120)
  durationMinutes Int    @map("duration_minutes") @db.SmallInt

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  durationExceptions DurationException[]
  /// SP-025. Declared so the `RESTRICT` foreign key is visible from this side
  /// too: a type nobody booked can be deleted, one an appointment names cannot.
  agendaEntries      AgendaEntry[]
  /// AG-060. The same `RESTRICT`, for the people still waiting for that type:
  /// deleting it would leave them waiting for something that no longer exists.
  waitlistEntries    WaitlistEntry[]

  @@map("service_type")
}

/// One practitioner's own duration for one service type (D-007, SP-022): the
/// top of the resolution hierarchy, above the specialty·type base.
model DurationException {
  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  serviceTypeId String      @map("service_type_id") @db.Uuid
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  durationMinutes Int @map("duration_minutes") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([practitionerId, serviceTypeId])
  @@map("duration_exception")
}

/// FHIR PractitionerRole: which sites a practitioner works at.
model PractitionerSite {
  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([practitionerId, siteId])
  @@map("practitioner_site")
}

/// Weekly availability template (FHIR Schedule).
///
/// Slots are NOT stored: they are derived from this rule minus occupied
/// `agenda_entry` rows. Materialising every free slot creates millions of rows
/// whose only job is to be empty.
model PractitionerScheduleRule {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  serviceTypeConceptId String?         @map("service_type_concept_id") @db.Uuid
  serviceType          CatalogConcept? @relation(fields: [serviceTypeConceptId], references: [id], onDelete: Restrict)

  /// ISO-8601: 1 = Monday .. 7 = Sunday.
  weekday Int @db.SmallInt

  /// `time` and not `timestamptz`: this is a wall-clock rule ("Mondays from
  /// 08:00"), not an instant. The only deliberate exception to the timestamptz
  /// convention, and it is not a timestamp at all.
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  /// D-021: no slot length here. The grid is one atom per site
  /// (`SiteParameter.slotAtomMinutes`); the rule says WHEN the practitioner
  /// works, never how the day is diced.
  validFrom DateTime  @map("valid_from") @db.Date
  /// NULL means the rule is still in force (ST-041).
  validTo   DateTime? @map("valid_to") @db.Date

  active Boolean @default(true)

  /// Both are `GENERATED ALWAYS AS … STORED`, written by the manual migration
  /// `20260813031542_staff_schedule_rule_no_overlap`. STORED and not VIRTUAL
  /// because PostgreSQL 18 cannot index or constrain virtual columns, and they
  /// exist only to feed the `schedule_rule_no_overlap` EXCLUDE of ST-042:
  /// `&&` has no operator over `time`, so the span is rangified to minutes
  /// from midnight. Declared here so Prisma never reads them as surplus and
  /// proposes dropping them — same treatment as `CatalogConcept.validPeriod`.
  minutesRange Unsupported("int4range")? @map("minutes_range")
  validity     Unsupported("daterange")?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([practitionerId, weekday])
  @@index([siteId, weekday])
  @@map("practitioner_schedule_rule")
}

// ---------------------------------------------------------------------------
// PATIENT
// ---------------------------------------------------------------------------

model Patient {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Medical record number. THE identity anchor: assigned once, never changed,
  /// never dependent on a document the patient may not have. Every internal FK
  /// points at `id`; humans quote the `mrn`.
  mrn String @unique @db.VarChar(12)

  /// Ecuadorian names carry two surnames. A single `full_name` column makes
  /// sorting and ministry reporting impossible.
  familyName       String  @map("family_name") @db.VarChar(120)
  secondFamilyName String? @map("second_family_name") @db.VarChar(120)
  givenName        String  @map("given_name") @db.VarChar(120)
  secondGivenName  String? @map("second_given_name") @db.VarChar(120)

  sex PatientSex

  genderIdentityConceptId String?         @map("gender_identity_concept_id") @db.Uuid
  genderIdentity          CatalogConcept? @relation("PatientGenderIdentity", fields: [genderIdentityConceptId], references: [id], onDelete: Restrict)

  birthDate DateTime @map("birth_date") @db.Date

  /// Undocumented migrants arrive with an estimated age. Without this flag an
  /// estimate is reported to the ministry as a fact.
  birthDateEstimated Boolean @default(false) @map("birth_date_estimated")

  deceasedAt DateTime? @map("deceased_at") @db.Timestamptz(6)

  /// RDACAA ethnic self-identification. A catalogue and not an enum because
  /// INEC revises the categories, and every historical record must keep the
  /// wording it was recorded with.
  ethnicityConceptId String?         @map("ethnicity_concept_id") @db.Uuid
  ethnicity          CatalogConcept? @relation("PatientEthnicity", fields: [ethnicityConceptId], references: [id], onDelete: Restrict)

  nationalityConceptId String?         @map("nationality_concept_id") @db.Uuid
  nationality          CatalogConcept? @relation("PatientNationality", fields: [nationalityConceptId], references: [id], onDelete: Restrict)

  /// PA-056. RDACAA column 14, «Pueblos». THIRD STEP of a chain whose first two
  /// are above: ethnicity → indigenous nationality → people. The ministry's
  /// instructivo enables it ONLY when the indigenous nationality is «Kichwa»,
  /// and that condition is NOT here and cannot be: it depends on which row of
  /// the `NATIONALITY` catalogue is Kichwa, and a CHECK cannot query another
  /// table. `indigenous-people.ts` is the one place that decides.
  peopleConceptId String?         @map("people_concept_id") @db.Uuid
  people          CatalogConcept? @relation("PatientPeople", fields: [peopleConceptId], references: [id], onDelete: Restrict)

  /// PA-057, PA-058. RDACAA column 7, «Orientación sexual».
  ///
  /// ⚠️ SPECIAL CATEGORY DATA under the LOPDP, like the priority reason. It is
  /// WRITTEN with `patient:write` — it is typed at the desk on the same form as
  /// columns 6, 8 and 11 to 14 — and READ only behind `patient:sexual-
  /// orientation`, which `MEDICO` and `ADMIN` carry from the seed since
  /// 19-08-2026 (D-039), through a route of its own that leaves an audit row.
  /// It travels neither on the chart nor on the
  /// listing: adding it to either `select` removes that door with nothing
  /// failing.
  ///
  /// The «from 10 years of age» rule of the instructivo is enforced in the
  /// service, not here: the age is DERIVED (PA-030) and a CHECK over it would
  /// expire with the calendar.
  sexualOrientationConceptId String?         @map("sexual_orientation_concept_id") @db.Uuid
  sexualOrientation          CatalogConcept? @relation("PatientSexualOrientation", fields: [sexualOrientationConceptId], references: [id], onDelete: Restrict)

  /// PA-053. Country of nationality, ISO 3166-1 alpha-3. NOT the column above:
  /// `nationality_concept_id` is the RDACAA's nationality or indigenous people
  /// (Kichwa, Shuar, Awa), a field the ministry's form only enables when the
  /// ethnic self-identification is indigenous. This one says the person is
  /// Venezuelan.
  ///
  /// A CODE AND NOT A FOREIGN KEY, exactly like `issuing_country` three tables
  /// down: two representations of the same country in one database eventually
  /// disagree. The `COUNTRY` catalogue is where the screen CHOOSES from and
  /// where the NAME comes from; the code is what is stored. Its shape is held
  /// by `patient_country_of_nationality_format` — an import never sees the DTO.
  countryOfNationalityCode String? @map("country_of_nationality_code") @db.Char(3)

  /// INEC DPA parish (6 digits). Province and canton are prefixes of this code,
  /// so they are derived, never stored twice.
  residenceParishConceptId String?         @map("residence_parish_concept_id") @db.Uuid
  residenceParish          CatalogConcept? @relation("PatientResidenceParish", fields: [residenceParishConceptId], references: [id], onDelete: Restrict)

  residenceAddressLine String? @map("residence_address_line") @db.VarChar(255)
  phone                String? @db.VarChar(32)
  email                String? @db.VarChar(255)
  bloodType            String? @map("blood_type") @db.VarChar(3)

  /// Registered with no definitive document yet (newborn, unidentified).
  isProvisional Boolean @default(false) @map("is_provisional")

  /// Newborns are registered under their mother before they have a document of
  /// their own. Also the fastest way to find the record 20 minutes after birth.
  motherPatientId String?   @map("mother_patient_id") @db.Uuid
  mother          Patient?  @relation("PatientMother", fields: [motherPatientId], references: [id], onDelete: Restrict)
  children        Patient[] @relation("PatientMother")

  /// Duplicate resolution. The losing record is NEVER deleted: printed
  /// documents and external systems still quote its MRN.
  ///
  /// Three guarantees live in SQL and cannot be written here (PA-046):
  /// `patient_merged_into_not_self`, `patient_merged_at_matches_link`, and
  /// `trg_patient_merge_not_chained`, which refuses A→B→C in either direction
  /// and locks the target row so two concurrent merges cannot build a chain
  /// between them. Nor can the PARTIAL index `patient_absorbed_charts`
  /// (`WHERE merged_into_id IS NOT NULL`), which is how the link is walked
  /// backwards.
  mergedIntoId String?   @map("merged_into_id") @db.Uuid
  mergedInto   Patient?  @relation("PatientMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom   Patient[] @relation("PatientMerge")
  mergedAt     DateTime? @map("merged_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  identifiers     PatientIdentifier[]
  priorityGroups  PatientPriorityGroup[]
  changeHistory   PatientChangeHistory[]
  contacts        PatientContact[]
  allergies       PatientAllergy[]
  /// EN-087. The «sin alergias conocidas» assertions written on this chart.
  allergyAbsences PatientAllergyAbsence[]
  /// EN-085. Personal and family history that persists between attentions.
  history         PatientHistory[]
  agendaEntries   AgendaEntry[]
  encounters      Encounter[]
  waitlistEntries WaitlistEntry[]
  certificates    MedicalCertificate[]
  referrals       Referral[]
  mergesAsSource  PatientMerge[]          @relation("MergeSource")
  mergesAsTarget  PatientMerge[]          @relation("MergeTarget")
  accounts        PatientAccount[]
  /// `privacy`, PD-016, PD-036: read through `chartScope` like the rest of the person's history.
  consents            PatientConsent[]
  dataSubjectRequests DataSubjectRequest[]

  @@index([familyName, givenName])
  @@index([birthDate])
  @@map("patient")
}

/// FHIR Patient.identifier[].
///
/// A child table and not columns on `patient`, because identification in
/// Ecuador is genuinely 0..n over time: a refugee arrives with a passport and a
/// refugee card, and later gets a cedula. Flat columns force you to overwrite,
/// which destroys the trail behind documents already issued.
model PatientIdentifier {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  type IdentifierType

  /// ISO 3166-1 alpha-3. Two passports may share a number if issued by
  /// different countries, so the real key is (type, issuing_country, value).
  issuingCountry String @default("ECU") @map("issuing_country") @db.Char(3)

  value String @db.VarChar(32)

  use IdentifierUse @default(OFFICIAL)

  validFrom DateTime? @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  /// Denormalised from `patient.merged_into_id`, maintained by trigger. It
  /// exists only so the uniqueness index can be partial: index predicates
  /// cannot contain subqueries, and a merged record must release its cedula so
  /// the surviving record can keep it.
  patientMerged Boolean @default(false) @map("patient_merged")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([patientId, use])
  @@index([value])
  @@map("patient_identifier")
}

/// How the system learnt the patient belongs to the group (PA-038).
///
/// «Lo dijo el paciente» and «consta en el carné del CONADIS» are not the same
/// thing, and without the distinction nobody can tell which of the two they are
/// looking at when they decide a turn.
enum PriorityGroupOrigin {
  SELF_DECLARED
  ACCREDITED

  @@map("priority_group_origin")
}

/// A dated assessment that the patient belongs to a priority group of article
/// 35 of the Constitution (REQ-024, PA-033..PA-039, D-026, D-027).
///
/// ═══════════════════════════════════════════════════════════════════════════
/// ONE ROW PER ASSESSMENT, NEVER A BOOLEAN COLUMN ON `patient`
/// ═══════════════════════════════════════════════════════════════════════════
///
/// HL7 FHIR models pregnancy as an `Observation` — a dated assessment — and
/// says expressly that it must NOT be captured as a `Condition`. A column
/// `embarazada` is exactly the one that stays switched on for ever. Disability
/// and catastrophic illness ARE `Condition`: persistent states, which is why
/// closing one sets `ends_on` and never deletes the row (PA-037) — otherwise
/// «¿por qué esta persona tuvo prioridad en marzo?» has no answer.
///
/// And a row absorbs with an INSERT the category the ministry adds, where ten
/// booleans need a migration and leave every historical row at `false` where
/// the honest value is «no se valoró».
///
/// ⚠️ AGE IS NOT HERE, and its absence is the design (PA-035). «Adulto mayor»
/// and «niña, niño o adolescente» are derived from `birth_date` on the clinical
/// date; stored, they would be data that expires on a birthday nobody processes.
/// `patient_priority_group_recordable` is what makes that true in the database.
///
/// ⚠️ THE VALIDITY IS RESOLVED WHEN READ. No process marks rows as expired: a
/// pregnancy whose expected date of delivery has passed simply stops counting,
/// with nobody touching the row.
///
/// `date` and not `timestamptz` for the period, deliberately: «hasta el 15 de
/// marzo» is a calendar fact, like `birth_date` and like
/// `catalog_concept.valid_from`. An instant would make the answer depend on the
/// hour it was asked.
model PatientPriorityGroup {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// One of the RECORDABLE codes of `priority-groups.ts`. A `varchar` with a
  /// CHECK and not a native enum: the enumeration of TEN lives in the domain —
  /// every entry drives a branch there — and only EIGHT may be written, so an
  /// enum would have to contain the two derived ones and then permit storing
  /// them. See `patient_priority_group_recordable`.
  groupCode String @map("group_code") @db.VarChar(48)

  startsOn DateTime  @map("starts_on") @db.Date
  /// Expected date of delivery or end date. NULL means still open, which a
  /// pregnancy may never be (`patient_priority_group_pregnancy_has_end`).
  endsOn   DateTime? @map("ends_on") @db.Date

  origin PriorityGroupOrigin

  /// Which document accredits it: carné del CONADIS, certificado médico.
  /// Required when `origin = ACCREDITED`, refused as blank by a CHECK.
  evidenceDocument String? @map("evidence_document") @db.VarChar(160)

  /// PA-039. Who recorded it and when. NOT NULL: a record nobody can be held
  /// to is not a weaker record, it is a useless one.
  recordedById String   @map("recorded_by") @db.Uuid
  recordedBy   User     @relation("PriorityGroupRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  /// Who closed it and when, for the same reason. Both NULL or both set.
  closedById String?   @map("closed_by") @db.Uuid
  closedBy   User?     @relation("PriorityGroupCloser", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)

  @@index([patientId, startsOn])
  @@map("patient_priority_group")
}

/// What was corrected on a chart, from which value, by whom and when
/// (PA-031, D-032).
///
/// ⚠️ THE ONLY TRAIL IN THIS SYSTEM THAT IS DELIBERATELY NOT APPEND-ONLY.
/// `access_audit`, `patient_merge` and the signed-note chain all carry
/// immutability triggers; this one must not. It holds the chart's own
/// contents, and REQ-113 obliges us to be able to correct and erase those.
/// The access trail watches WHO LOOKED and is immutable for that reason —
/// which is exactly why `access_audit_payload_only_for_declared_resources`
/// refuses `'patient'` and why this table exists at all.
///
/// One row PER FIELD, not one per correction with a JSON payload: erasing one
/// datum under REQ-113 then deletes a row instead of editing a document that
/// also holds data which must be kept.
model PatientChangeHistory {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// The DOMAIN field name (`familyName`), not the column. Restricted by
  /// `patient_change_history_field_known`, whose list is the one repeated in
  /// `patient-corrections.ts`. `mrn` is absent on purpose: PA-002 says it
  /// never changes.
  field String @db.VarChar(64)

  /// Both sides as text. NULL means "had no value" / "was cleared", which is a
  /// real change. A CHECK refuses a row where both sides are the same.
  valueBefore String? @map("value_before")
  valueAfter  String? @map("value_after")

  changedById String   @map("changed_by") @db.Uuid
  changedBy   User     @relation("PatientChangeAuthor", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([patientId, changedAt(sort: Desc)])
  @@map("patient_change_history")
}

/// Emergency contact or legal representative (minors, incapacitated adults).
model PatientContact {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  fullName     String  @map("full_name") @db.VarChar(240)
  relationship String  @db.VarChar(80)
  phone        String? @db.VarChar(32)
  cedula       String? @db.VarChar(10)

  /// Legal representative for consent purposes, not merely someone to call.
  isLegalRepresentative Boolean @default(false) @map("is_legal_representative")
  isPrimary             Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientId])
  @@map("patient_contact")
}

/// FHIR AllergyIntolerance. Structured rather than buried in the form-002 JSON
/// because prescribing has to check it, and "check it" means a query, not a
/// human reading prose.
model PatientAllergy {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// CNMB concept when the allergen is a drug; NULL plus free text otherwise
  /// (foods, latex, insect stings).
  substanceConceptId String?         @map("substance_concept_id") @db.Uuid
  substance          CatalogConcept? @relation(fields: [substanceConceptId], references: [id], onDelete: Restrict)

  substanceText String             @map("substance_text") @db.VarChar(240)
  reaction      String?            @db.VarChar(512)
  criticality   AllergyCriticality @default(UNABLE_TO_ASSESS)

  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  /// EN-086. Who recorded it. Nullable only because the rows written before
  /// `20260930160703_patient_preparation` never had an author and nobody can
  /// invent one; `patient_allergy_names_its_author` (NOT VALID) demands it on
  /// every write since.
  recordedById String? @map("recorded_by") @db.Uuid
  recordedBy   User?   @relation("AllergyRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  /// Refuted allergies are marked, never deleted: knowing an allergy was ruled
  /// out is clinical information in its own right.
  refutedAt    DateTime? @map("refuted_at") @db.Timestamptz(6)
  refutedNotes String?   @map("refuted_notes") @db.Text
  /// EN-086. Who ruled it out. Same NOT VALID regime as `recordedBy`.
  refutedById  String?   @map("refuted_by") @db.Uuid
  refutedBy    User?     @relation("AllergyRefuter", fields: [refutedById], references: [id], onDelete: Restrict)

  @@index([patientId, refutedAt])
  @@map("patient_allergy")
}

/// EN-085. Personal and family history, per patient and not per note.
///
/// Inside a note's JSON a history entry is frozen with the note (EN-023):
/// right for the act, useless as the state of the patient — March's finding
/// would not show in April unless somebody re-read March. Sister of
/// `patient_allergy`, with the same regime: refuted, never deleted.
///
/// The guarantees live in `20260930160703_patient_preparation`:
/// `trg_patient_history_append_only` refuses DELETE, TRUNCATE and any UPDATE
/// other than refuting a live row once.
model PatientHistory {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  kind        PatientHistoryKind
  description String             @db.VarChar(500)
  /// Mandatory for FAMILY, absent for PERSONAL
  /// (`patient_history_family_names_relative`).
  relative    String?            @db.VarChar(80)

  recordedById String   @map("recorded_by") @db.Uuid
  recordedBy   User     @relation("HistoryRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  /// All three or none (`patient_history_refutation_is_whole`).
  refutedAt    DateTime? @map("refuted_at") @db.Timestamptz(6)
  refutedNotes String?   @map("refuted_notes") @db.Text
  refutedById  String?   @map("refuted_by") @db.Uuid
  refutedBy    User?     @relation("HistoryRefuter", fields: [refutedById], references: [id], onDelete: Restrict)

  @@index([patientId, refutedAt])
  @@map("patient_history")
}

/// EN-087, D-A-018. «Sin alergias conocidas», AFIRMADO POR UN CLÍNICO.
///
/// The `nilknown` of HL7's International Patient Summary, whose definition is
/// the reason this is a table and not a boolean on `patient`: «una afirmación
/// positiva por parte de un usuario clínico, y no una posición por defecto
/// afirmada por un sistema informático a falta de otra información». What has
/// to be kept is an ACT — who said it and when — because «sin alergias
/// conocidas (Dra. Villacís, 14-03-2026)» and «alergias: no registradas» are
/// two different things to read mid-consultation.
///
/// The guarantees live in `20260820171859_patient_allergy_absence` and NOT in
/// this file, which cannot describe them: the trigger that refuses UPDATE,
/// DELETE and TRUNCATE, and the one that refuses an assertion over a chart —
/// or a chart it absorbed — that still has an unrefuted allergy.
model PatientAllergyAbsence {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// EN-087. The clinician who asserted it. NOT NULL with a foreign key: this
  /// column is why the table exists. Without it the row says «el sistema no
  /// encontró nada», which is exactly what the standard forbids calling «sin
  /// alergias conocidas».
  assertedById String @map("asserted_by") @db.Uuid
  assertedBy   User   @relation("AllergyAbsenceAsserter", fields: [assertedById], references: [id], onDelete: Restrict)

  assertedAt DateTime @default(now()) @map("asserted_at") @db.Timestamptz(6)

  @@index([patientId, assertedAt(sort: Desc)], map: "patient_allergy_absence_by_chart")
  @@map("patient_allergy_absence")
}

/// What a `patient_merge` row records: the merge, or undoing it.
enum PatientMergeEvent {
  MERGE
  UNDO

  @@map("patient_merge_event")
}

/// Append-only log of EVENTS in duplicate resolution: one row per merge and
/// another per undo, pointing at the merge it undoes (PA-043 a PA-049).
///
/// UNDOING IS A NEW ROW, NEVER AN EDIT. The obvious alternative — `undone_at`
/// and `undone_by` on the merge row — needs a hole in the immutability trigger
/// to allow that one transition, and an append-only table "except for these
/// two columns" is a convention somebody has to remember, not a guarantee.
///
/// The guarantees live in `20260817204801_patient_merge_events` and NOT in
/// this file, which cannot describe them: the trigger that refuses UPDATE,
/// DELETE and TRUNCATE, and the one that refuses an undo row naming a
/// different pair of charts than the merge it claims to undo.
model PatientMerge {
  id BigInt @id @default(autoincrement())

  event PatientMergeEvent

  sourcePatientId String  @map("source_patient_id") @db.Uuid
  sourcePatient   Patient @relation("MergeSource", fields: [sourcePatientId], references: [id], onDelete: Restrict)

  targetPatientId String  @map("target_patient_id") @db.Uuid
  targetPatient   Patient @relation("MergeTarget", fields: [targetPatientId], references: [id], onDelete: Restrict)

  /// PA-047. The merge this row undoes. UNIQUE, so a merge is undone exactly
  /// once and «is this merge undone?» is a lookup instead of a guess from
  /// dates — which stops being answerable the day the same pair is merged
  /// again.
  undoesMergeId BigInt?       @unique(map: "patient_merge_undone_once") @map("undoes_merge_id")
  undoes        PatientMerge? @relation("MergeUndo", fields: [undoesMergeId], references: [id], onDelete: Restrict)
  undoneBy      PatientMerge? @relation("MergeUndo")

  /// PA-044. NOT NULL and with a foreign key: merging joins two people's
  /// clinical records, and the question to answer twelve months later is who
  /// did it.
  performedBy     String @map("performed_by") @db.Uuid
  performedByUser User   @relation("PatientMergeAuthor", fields: [performedBy], references: [id], onDelete: Restrict)

  performedAt DateTime @default(now()) @map("performed_at") @db.Timestamptz(6)

  /// PA-044, PA-047. Mandatory on BOTH events, and a CHECK refuses it blank:
  /// a mandatory reason is what tells this apart from a click.
  reason String @db.Text

  /// Snapshot of the source row and its children at merge time. Present on the
  /// MERGE row and absent on the UNDO one, tied to `event` by a CHECK: there is
  /// nothing to undo about an undo, and the chart cannot have changed while
  /// merged (PA-045), so a snapshot there would be invented.
  sourceSnapshot Json? @map("source_snapshot") @db.JsonB

  @@index([targetPatientId])
  @@index([sourcePatientId])
  @@map("patient_merge")
}

// ---------------------------------------------------------------------------
// AGENDA
// ---------------------------------------------------------------------------

/// Appointments AND calendar blocks in one table.
///
/// One table because they compete for the same resource — the practitioner's
/// time — and PostgreSQL cannot enforce an exclusion constraint across two
/// tables. Split them and "never book on top of a holiday" goes back to being
/// application logic, which is to say a race condition waiting for a Monday
/// morning with two receptionists.
///
/// The non-overlap guarantee lives in a manual migration:
///   EXCLUDE USING gist (practitioner_id WITH =,
///                       tstzrange(starts_at, ends_at, '[)') WITH &&)
///   WHERE (released_at IS NULL AND blocks_calendar)
model AgendaEntry {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  kind AgendaEntryKind

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  roomId String?   @map("room_id") @db.Uuid
  room   SiteRoom? @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /// NULL exactly when kind = BLOCK. Enforced by CHECK in a manual migration.
  patientId String?  @map("patient_id") @db.Uuid
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Restrict)

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  /// false = deliberate overbooking (an urgent case squeezed in). The exclusion
  /// constraint ignores these rows, so the rule gets broken on purpose and on
  /// the record instead of being worked around.
  blocksCalendar Boolean @default(true) @map("blocks_calendar")

  /// AG-035, AG-036, D-005. The constancy of an overbooking: WHO authorised it
  /// and WHY the grid was broken. Both are set exactly when
  /// `blocksCalendar` is false and both are null otherwise — guaranteed by
  /// `agenda_entry_overbooking_coherence` (manual migration), which Prisma
  /// cannot express.
  ///
  /// THE AUTHORISER IS NOT `createdById`, and that is the whole control: whoever
  /// books an overbooking may not authorise it (AG-103) unless they hold
  /// `agenda:overbook:self`. One column for both roles would make the rule
  /// unverifiable from the row.
  ///
  /// AND THE REASON IS NOT `reason`: that one is free text where reception
  /// writes the motive for the visit — health data no listing serves back
  /// (AG-072, AG-074). This one is administrative and travels in every listing.
  overbookingAuthorisedById String? @map("overbooking_authorised_by_id") @db.Uuid
  overbookingAuthorisedBy   User?   @relation("OverbookingAuthoriser", fields: [overbookingAuthorisedById], references: [id], onDelete: Restrict)
  overbookingReason         String? @map("overbooking_reason") @db.VarChar(512)

  /// NULL means the slot still occupies the calendar. A two-column predicate
  /// keeps the exclusion constraint stable when new statuses appear: adding
  /// RESCHEDULED to the enum must not force a rebuild of the GiST index.
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)

  status AgendaStatus @default(BOOKED)

  /// Where the PATIENT is — the axis `status` does not carry. The two columns
  /// move together or not at all
  /// (`agenda_entry_subject_status_carries_its_instant`), and neither is
  /// allowed on a BLOCK (`agenda_entry_subject_status_needs_a_patient`): a
  /// block is not a person.
  subjectStatus   PatientSubjectStatus? @map("subject_status")
  subjectStatusAt DateTime?             @map("subject_status_at") @db.Timestamptz(6)

  /// Ley de Derechos y Amparo del Paciente (Ley 77) art. 10: «El estado de
  /// emergencia del paciente será calificado por el centro de salud AL MOMENTO
  /// DE SU ARRIBO». Art. 1 names «Clínicas», so it reaches this
  /// establishment, and art. 13 backs it with prison.
  ///
  /// THIS IS NOT TRIAGE. It scores no severity and reorders no queue, and
  /// unlike triage (D-A-001) it is not optional and not conditional on triage
  /// being switched on. It is the record that the call was made, by whom, at
  /// what instant — and `agenda_entry_emergency_flag_names_who_and_when`
  /// refuses one without the other.
  /// THE ASSESSMENT ITSELF, and it is not the same column as its outcome.
  ///
  /// Recording only the flag conflates «assessed, and it was not an emergency»
  /// with «nobody assessed anybody» — and what art. 10 obliges the
  /// establishment to be able to prove is THAT THE CALL WAS MADE, the
  /// negatives as much as the positives. Proving it for the flagged patients
  /// says nothing about the one who was waved through, who is precisely the
  /// patient art. 13 turns into a prison sentence.
  emergencyAssessedAt   DateTime? @map("emergency_assessed_at") @db.Timestamptz(6)
  emergencyAssessedById String?   @map("emergency_assessed_by_id") @db.Uuid
  emergencyAssessedBy   User?     @relation("EmergencyAssessor", fields: [emergencyAssessedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "agenda_entry_emergency_assessment_fk")

  emergencyFlaggedAt   DateTime? @map("emergency_flagged_at") @db.Timestamptz(6)
  emergencyFlaggedById String?   @map("emergency_flagged_by_id") @db.Uuid
  emergencyFlaggedBy   User?     @relation("EmergencyFlagger", fields: [emergencyFlaggedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "agenda_entry_emergency_flag_fk")
  emergencyNote        String?   @map("emergency_note") @db.VarChar(500)

  /// Art. 9 forbids demanding any means of payment as a condition of being
  /// received and stabilised. Coverage verification therefore HAS to be
  /// skippable, and the skip has to leave a trace: otherwise the screen that
  /// blocks on payment is illegal in exactly the case that matters most.
  coverageCheckSkippedReason String? @map("coverage_check_skipped_reason") @db.VarChar(500)

  /// AG-116, AG-117. Cada desenlace con su instante y su motivo propio.
  ///
  /// ⚠️ `enteredInErrorReason` NO comparte columna con la anulación, y es la
  /// mitad importante: el motivo de una retractación no es el de una anulación,
  /// y una sola columna haría imposible saber DESDE LA FILA cuál de los dos
  /// actos ocurrió — que es justo lo que estos dos estados vienen a separar.
  leftWithoutBeingSeenAt     DateTime? @map("left_without_being_seen_at") @db.Timestamptz(6)
  leftWithoutBeingSeenReason String?   @map("left_without_being_seen_reason") @db.VarChar(500)
  enteredInErrorAt           DateTime? @map("entered_in_error_at") @db.Timestamptz(6)
  enteredInErrorReason       String?   @map("entered_in_error_reason") @db.VarChar(500)

  /// AG-134. Lo que la pizarra de rotulador tenía y el tablero electrónico
  /// perdió: los símbolos improvisados que el equipo se dejaba entre sí.
  ///
  /// ⚠️ NO es `reason`. Ahí escribe recepción el MOTIVO DE CONSULTA, que quedó
  /// fuera de toda lectura por ser dato de salud (AG-036, AG-072, AG-074). Una
  /// nota de tablero compartiendo esa columna devolvería un diagnóstico a una
  /// pantalla que da a la sala de espera.
  boardNote String? @map("board_note") @db.VarChar(120)

  subjectStatusHistory AgendaSubjectStatusHistory[]

  /// SP-028: el tipo de atención que recepción eligió al reservar, y con el
  /// que se resolvió la duración (SP-023). `RESTRICT` es lo que produce
  /// SP-025 — borrar un tipo con citas se rechaza en la base, no en TypeScript.
  serviceTypeId String?      @map("service_type_id") @db.Uuid
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  reason String? @db.VarChar(512)

  /// Required exactly when kind = APPOINTMENT (AG-029); NULL on a block, which
  /// nobody books. Enforced by `agenda_entry_booking_channel_coherence` in a
  /// manual migration — a CHECK and not NOT NULL, because half the rows may
  /// legitimately be empty.
  bookingChannel BookingChannel? @map("booking_channel")

  checkedInAt      DateTime? @map("checked_in_at") @db.Timestamptz(6)
  noShowAt         DateTime? @map("no_show_at") @db.Timestamptz(6)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationNote String?   @map("cancellation_note") @db.VarChar(512)

  /// AG-050, AG-051: la cita de la que ésta procede al reprogramar, y NULL en
  /// toda cita reservada directamente. Reprogramar no mueve el intervalo de la
  /// fila existente: la libera y crea ésta, que es la que apunta hacia atrás.
  ///
  /// DECLARADA COMO 1:N Y GARANTIZADA 1:1 POR LA BASE. El índice único es
  /// PARCIAL (`WHERE rescheduled_from_id IS NOT NULL`, migración
  /// `agenda_reschedule_link`) y Prisma no puede describir el predicado, así
  /// que `@unique` aquí generaría un índice distinto del que existe. La lista
  /// de abajo tiene, por tanto, cero o un elemento — nunca más.
  rescheduledFromId String?      @map("rescheduled_from_id") @db.Uuid
  rescheduledFrom   AgendaEntry? @relation("AgendaEntryReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  statusHistory  AgendaStatusHistory[]
  /// EN-168. DECLARADA 1:N Y GARANTIZADA «UNA VIVA» POR LA BASE: el índice
  /// único `encounter_one_live_per_agenda_entry` es parcial
  /// (`WHERE status <> 'ENTERED_IN_ERROR'`). Las demás son atenciones anuladas
  /// que siguen atadas a la cita como rastro (D-081).
  encounters     Encounter[]
  waitlistOrigin WaitlistEntry[]
  /// AG-051, el sentido de ida: la cita que sustituyó a ésta. Cero o una.
  rescheduledTo  AgendaEntry[]         @relation("AgendaEntryReschedule")

  @@index([practitionerId, startsAt])
  @@index([siteId, startsAt])
  @@index([patientId, startsAt(sort: Desc)])
  @@map("agenda_entry")
}

/// Append-only transition log. Without it, "the appointment showed up as
/// cancelled" has no answer.
///
/// AG-005, SC-005, D-022: append-only is enforced by the DATABASE, not by the
/// habits of this module. `trg_agenda_status_history_immutable` refuses UPDATE
/// and DELETE, `trg_agenda_status_history_no_truncate` refuses TRUNCATE, and
/// neither is expressible here — see the migration
/// `agenda_status_history_immutable`.
model AgendaStatusHistory {
  id BigInt @id @default(autoincrement())

  agendaEntryId String      @map("agenda_entry_id") @db.Uuid
  /// `Restrict` and not `Cascade` (D-022): deleting an appointment used to take
  /// its whole trail with it, in silence, which contradicts SPEC §5 — an
  /// appointment is not deleted, it is cancelled, released or marked.
  agendaEntry   AgendaEntry @relation(fields: [agendaEntryId], references: [id], onDelete: Restrict)

  fromStatus AgendaStatus? @map("from_status")
  toStatus   AgendaStatus  @map("to_status")

  changedById String?  @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  note        String?  @db.VarChar(512)

  @@index([agendaEntryId, changedAt])
  @@map("agenda_status_history")
}

model WaitlistEntry {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// NULL = any practitioner offering the requested service type.
  practitionerId String?       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  /// AG-060, AG-061. `service_type` Y NO `catalog_concept`, desde
  /// `waitlist_service_type_follows_agenda`: es la MISMA tabla que
  /// `agenda_entry.service_type_id` nombra desde C4, y sin eso la mitad de
  /// AG-061 que compara los dos tipos no podía ser cierta nunca. NULL
  /// significa «cualquiera», no «ninguno».
  serviceTypeId String?      @map("service_type_id") @db.Uuid
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  /// AG-060. Between which dates the appointment is of any use to the patient.
  ///
  /// NOT NULL SINCE `agenda_waitlist_contact_trail`, and both of them: AG-060
  /// lists the range among what an entry carries and marks only practitioner
  /// and service type as optional, and AG-065 — «CUANDO la fecha preferida
  /// máxima quede en el pasado, márquela EXPIRED» — never triggers on a NULL,
  /// so an entry without an upper bound would compete for every slot of the
  /// site forever. `waitlist_entry_preferred_range_valid` refuses an inverted
  /// range.
  preferredFrom DateTime @map("preferred_from") @db.Date
  preferredTo   DateTime @map("preferred_to") @db.Date

  status WaitlistStatus @default(WAITING)

  /// AG-064. Every contact attempt, with its instant, its author and what
  /// happened. THE COUNT AND THE LAST INSTANT ARE DERIVED FROM HERE — the
  /// `contact_attempts` and `last_contacted_at` columns this table used to
  /// carry were dropped, because two statements of one fact drift and only the
  /// cached one can be wrong.
  contactAttempts WaitlistContactAttempt[]

  /// AG-063. The appointment this entry became, and `status = SCHEDULED`, are
  /// the same fact: `waitlist_entry_conversion_complete` is a biconditional,
  /// `waitlist_entry_one_per_converted_entry` (partial unique index, invisible
  /// to Prisma) refuses two entries claiming one slot, and
  /// `trg_waitlist_entry_conversion_consented` refuses an appointment of
  /// another patient or a conversion with no recorded acceptance.
  convertedEntryId String?      @map("converted_entry_id") @db.Uuid
  convertedEntry   AgendaEntry? @relation(fields: [convertedEntryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// NO INDEX BY `(site_id, status, …)` DECLARED HERE, and it is not missing:
  /// AG-061 only ever asks for the OPEN candidates of a site, so the index is
  /// PARTIAL (`waitlist_entry_open_candidates`, `WHERE status IN ('WAITING',
  /// 'CONTACTED')`) and Prisma cannot describe the predicate — declaring it
  /// here would create a second, wider index instead. The priority the listing
  /// orders by is not stored either (PA-041): it is derived from the groups in
  /// force on the day the candidates are proposed.
  @@index([patientId])
  @@map("waitlist_entry")
}

/// AG-064. One call, with who made it, when, and what came of it.
///
/// A TABLE AND NOT A COUNTER, which is what `waitlist_entry` carried until
/// `agenda_waitlist_contact_trail`: with `contact_attempts = 3` nobody can say
/// when the first two were, who called, or what the patient answered — and
/// «¿por qué el cupo se lo llevó ella y no yo, que estaba antes?» is the
/// question a waiting list exists to be able to answer.
///
/// APPEND-ONLY, ENFORCED BY THE DATABASE (`trg_waitlist_contact_attempt_immutable`
/// and `trg_waitlist_contact_attempt_no_truncate`, neither expressible here):
/// a trail that can be rewritten after the slot was given away proves nothing.
model WaitlistContactAttempt {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  waitlistEntryId String        @map("waitlist_entry_id") @db.Uuid
  waitlistEntry   WaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Restrict)

  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)

  /// Who called. NOT NULL for the same reason as
  /// `patient_priority_group.recorded_by`: «se le llamó tres veces» with no
  /// name can neither be checked nor denied.
  recordedById String @map("recorded_by") @db.Uuid
  recordedBy   User   @relation("WaitlistContactRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  outcome WaitlistContactOutcome

  @@index([waitlistEntryId, attemptedAt(sort: Desc)], map: "waitlist_contact_attempt_by_entry")
  @@map("waitlist_contact_attempt")
}

// ---------------------------------------------------------------------------
// ENCOUNTER — the RDACAA row
// ---------------------------------------------------------------------------

model Encounter {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// Walk-ins have no appointment. At most ONE LIVE encounter per appointment
  /// (EN-168, D-081): `encounter_one_live_per_agenda_entry` is a PARTIAL unique
  /// index (`WHERE status <> 'ENTERED_IN_ERROR'`) that Prisma cannot express,
  /// so the relation is declared one-to-many and the migration holds the rule.
  /// An annulled encounter stays attached to its appointment as the trail.
  agendaEntryId String?      @map("agenda_entry_id") @db.Uuid
  agendaEntry   AgendaEntry? @relation(fields: [agendaEntryId], references: [id], onDelete: Restrict)

  startedAt DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)

  /// The administrative state of the act, which `endedAt` alone could only
  /// express as a boolean. The two are kept in lockstep IN BOTH DIRECTIONS by
  /// `encounter_status_matches_ended_at` (manual migration); without that
  /// check this column becomes a second source of truth and drifts from the
  /// timestamp it replaces.
  status EncounterStatus @default(OPEN)

  careModality CareModality
  careSetting  CareSetting  @default(INTRAMURAL)

  /// First-time vs subsequent AT THIS ESTABLISHMENT. Per-diagnosis
  /// first/subsequent is a different field on `encounter_diagnosis`.
  visitSequence VisitSequence

  /// RDACAA reports the age the patient HAD on the day of care. Computed once
  /// by a BEFORE INSERT trigger and frozen: derive it on the fly and
  /// reprocessing an old report yields different numbers, and fixing a mistyped
  /// birth date silently rewrites reports already filed with the ministry.
  ageYears  Int? @map("age_years") @db.SmallInt
  ageMonths Int? @map("age_months") @db.SmallInt
  ageDays   Int? @map("age_days") @db.SmallInt

  /// Required on DISCHARGED and COMPLETED by
  /// `encounter_discharged_states_state_a_condition` (manual migration):
  /// EN-009 demands a discharge condition to close, and a closed encounter
  /// without one is a clinical fact nobody stated. DISCONTINUED and
  /// ENTERED_IN_ERROR are exempt — nothing clinical concluded, so there is
  /// nothing to state.
  dischargeCondition DischargeCondition?

  /// D-A-010: whoever closes is whoever opened. STORED rather than derived
  /// from `practitionerId`, because the substitution rule has to be able to
  /// record that the closer was NOT the author — and when it was somebody
  /// else, `encounter_substitute_closure_states_reason` requires
  /// `closedBySubstituteReason`. That reason is the whole point of allowing
  /// the substitution.
  ///
  /// There is no automatic closure to fill these in: a nightly job closing
  /// yesterday's encounters would have to INVENT the discharge condition
  /// EN-009 demands. What replaces it is a list of what is still open, which
  /// `encounter_still_open_by_practitioner` serves.
  closedById               String?       @map("closed_by_id") @db.Uuid
  closedBy                 Practitioner? @relation("EncounterCloser", fields: [closedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "encounter_closed_by_fk")
  closedAt                 DateTime?     @map("closed_at") @db.Timestamptz(6)
  closedBySubstituteReason String?       @map("closed_by_substitute_reason") @db.VarChar(500)

  /// EN-166 (D-077, D-080). Why, who and when an encounter was annulled. All
  /// three exactly on `ENTERED_IN_ERROR` and never otherwise
  /// (`encounter_entered_in_error_states_who_why_when`). The author is a USER,
  /// not a practitioner: see `discontinuedById`.
  enteredInErrorReason String?   @map("entered_in_error_reason") @db.VarChar(500)
  enteredInErrorById   String?   @map("entered_in_error_by_id") @db.Uuid
  enteredInErrorBy     User?     @relation("EncounterAnnuller", fields: [enteredInErrorById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "encounter_entered_in_error_by_fk")
  enteredInErrorAt     DateTime? @map("entered_in_error_at") @db.Timestamptz(6)

  /// EN-167 (D-076, D-080, D-082). Why, where from, who and when an encounter
  /// was interrupted; all four exactly on `DISCONTINUED`
  /// (`encounter_discontinued_states_who_why_when`). A USER and not a
  /// practitioner because reception records the patient who leaves with the
  /// encounter open and no note (AG-148).
  discontinuedReason String?                      @map("discontinued_reason") @db.VarChar(512)
  discontinuedOrigin EncounterDiscontinuedOrigin? @map("discontinued_origin")
  discontinuedById   String?                      @map("discontinued_by_id") @db.Uuid
  discontinuedBy     User?                        @relation("EncounterDiscontinuer", fields: [discontinuedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "encounter_discontinued_by_fk")
  discontinuedAt     DateTime?                    @map("discontinued_at") @db.Timestamptz(6)

  /// D-085 §2. Why somebody other than the attending practitioner annulled or
  /// interrupted it (EN-147 applied to the exits). Only on those two states
  /// (`encounter_exit_substitute_reason_belongs_to_an_exit`).
  exitSubstituteReason String? @map("exit_substitute_reason") @db.VarChar(500)

  /// When this encounter was included in an RDACAA/PRAS submission. NULL means
  /// not yet reported, and drives the pending-report partial index.
  reportedAt DateTime? @map("reported_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vitals             EncounterVitals?
  violenceScreening  ViolenceScreening?
  priorityGroups     EncounterPriorityGroup[]
  diagnoses          EncounterDiagnosis[]
  procedures         EncounterProcedure[]
  notes              ClinicalNote[]
  prescriptions      Prescription[]
  serviceOrders      ServiceOrder[]
  certificates       MedicalCertificate[]
  referrals          Referral[]
  interconsultations Interconsultation[]
  accounts           PatientAccount[]
  chargeItems        ChargeItem[]

  /// `encounter_still_open_by_practitioner` is NOT here and cannot be: it is
  /// PARTIAL (`WHERE status IN ('OPEN','ON_HOLD')`), which is what keeps it
  /// small enough to be the working list of what nobody closed. Declared here
  /// it would index every encounter ever recorded. It lives in the migration.
  @@index([patientId, startedAt(sort: Desc)])
  @@index([practitionerId, startedAt(sort: Desc)])
  @@index([siteId, startedAt])
  @@map("encounter")
}

/// Anthropometry and vital signs. RDACAA mandates weight, height, head
/// circumference, abdominal circumference and BMI per attention.
model EncounterVitals {
  encounterId String    @id @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  weightKg                 Decimal? @map("weight_kg") @db.Decimal(6, 3)
  heightCm                 Decimal? @map("height_cm") @db.Decimal(5, 1)
  headCircumferenceCm      Decimal? @map("head_circumference_cm") @db.Decimal(5, 1)
  abdominalCircumferenceCm Decimal? @map("abdominal_circumference_cm") @db.Decimal(5, 1)

  /// Written by a BEFORE INSERT OR UPDATE trigger, never by the application.
  /// Not a PostgreSQL 18 generated column: Prisma does not model those and
  /// would try to INSERT into it, and a VIRTUAL column cannot be indexed — and
  /// BMI is filtered in nutritional screening.
  bmi Decimal? @db.Decimal(5, 2)

  systolicBp       Int?     @map("systolic_bp") @db.SmallInt
  diastolicBp      Int?     @map("diastolic_bp") @db.SmallInt
  heartRate        Int?     @map("heart_rate") @db.SmallInt
  respiratoryRate  Int?     @map("respiratory_rate") @db.SmallInt
  temperatureC     Decimal? @map("temperature_c") @db.Decimal(4, 1)
  oxygenSaturation Int?     @map("oxygen_saturation") @db.SmallInt

  measuredAt DateTime @default(now()) @map("measured_at") @db.Timestamptz(6)

  /// EN-064. How the height was taken; mandatory with a height
  /// (`encounter_vitals_height_needs_position`, NOT VALID for older rows).
  heightPosition HeightPosition? @map("height_position")

  /// EN-065. Both typed: correcting needs the site's altitude, which the
  /// schema does not hold. 1–25 g/dl, D-058's criterion.
  hemoglobinGDl          Decimal? @map("hemoglobin_g_dl") @db.Decimal(4, 1)
  hemoglobinCorrectedGDl Decimal? @map("hemoglobin_corrected_g_dl") @db.Decimal(4, 1)

  /// EN-163. The reason for the visit in the patient's own words, taken in
  /// preparation. NOT the 002's `motivoConsulta`, which the doctor writes.
  presentingComplaint String? @map("presenting_complaint") @db.VarChar(500)

  /// EN-143. Who TOOK the reading. Never changes once written
  /// (`trg_encounter_vitals_keeps_its_author`): a correction is not a taking.
  /// Nullable only for rows older than the column.
  recordedById String? @map("recorded_by") @db.Uuid
  recordedBy   User?   @relation("VitalsRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  /// EN-143. Who corrected it last, and when; both or neither.
  correctedById String?   @map("corrected_by") @db.Uuid
  correctedBy   User?     @relation("VitalsCorrector", fields: [correctedById], references: [id], onDelete: Restrict)
  correctedAt   DateTime? @map("corrected_at") @db.Timestamptz(6)

  @@map("encounter_vitals")
}

/// RDACAA priority and vulnerable groups, recorded per attention.
///
/// A join table instead of ten booleans: when the ministry adds a category this
/// absorbs it with an INSERT. Booleans need a schema migration and leave every
/// historical row with `false` where the honest value is "did not apply".
model EncounterPriorityGroup {
  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  conceptId String         @map("concept_id") @db.Uuid
  concept   CatalogConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@id([encounterId, conceptId])
  @@map("encounter_priority_group")
}

/// RDACAA violence screening.
///
/// Its own table, not four columns on `encounter`, because its access regime
/// differs: it is the most sensitive item in the record. A table can be REVOKEd
/// TODO: no REVOKE, no separate permission and no distinct flow exists yet.
/// The separation is a design intent, not a property the schema currently has.
/// and audited separately; a column cannot without column-level grants.
model ViolenceScreening {
  encounterId String    @id @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  result ViolenceScreeningResult @default(NOT_APPLIED)

  /// Several types can coexist in a single case.
  types ViolenceType[]

  screeningTool       String? @map("screening_tool") @db.VarChar(80)
  actionTaken         String? @map("action_taken") @db.Text
  reportedToAuthority Boolean @default(false) @map("reported_to_authority")

  screenedById String?  @map("screened_by_id") @db.Uuid
  screenedAt   DateTime @default(now()) @map("screened_at") @db.Timestamptz(6)

  @@map("violence_screening")
}

/// FHIR Condition.
model EncounterDiagnosis {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  /// The exact VERSION of the CIE-10 concept in force on the day of care. This
  /// makes historical resolution automatic instead of a query somebody has to
  /// remember to write.
  conceptId String         @map("concept_id") @db.Uuid
  concept   CatalogConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  /// Deliberately redundant with the catalogue. In fifteen years the catalogue
  /// may have been migrated, pruned or reloaded; the record must still say what
  /// was diagnosed. Same reason an invoice stores the price, not just the
  /// product id.
  cie10Code    String @map("cie10_code") @db.VarChar(10)
  cie10Display String @map("cie10_display") @db.VarChar(512)

  certainty  DiagnosisCertainty
  occurrence DiagnosisOccurrence

  /// 1 = principal diagnosis. Unique per encounter via a partial unique index.
  rank Int @default(1) @db.SmallInt

  /// Mandatory epidemiological notification (dengue, tuberculosis...).
  notifiable Boolean @default(false)

  note String? @db.Text

  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@index([encounterId])
  @@index([cie10Code, recordedAt])
  @@map("encounter_diagnosis")
}

/// FHIR Procedure.
model EncounterProcedure {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  conceptId String         @map("concept_id") @db.Uuid
  concept   CatalogConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  procedureCode    String @map("procedure_code") @db.VarChar(20)
  procedureDisplay String @map("procedure_display") @db.VarChar(512)

  quantity Int @default(1) @db.SmallInt

  /// Frozen tariff amount. Money is always Decimal(12,2), never Float.
  tariffAmount Decimal? @map("tariff_amount") @db.Decimal(12, 2)

  performedAt DateTime @default(now()) @map("performed_at") @db.Timestamptz(6)
  note        String?  @db.Text

  @@index([encounterId])
  @@map("encounter_procedure")
}

// ---------------------------------------------------------------------------
// CLINICAL NOTES — MSP forms
// ---------------------------------------------------------------------------

/// Append-only clinical note with an amendment chain.
///
/// A signed note is never edited; it is superseded by a new version stating who
/// amended it and why. Chosen over system-versioned tables (which PostgreSQL 18
/// still does not provide natively) and over SCD-2, because an amendment is a
/// CLINICAL ACT that must be readable, printable and citable in a legal
/// proceeding — not a side effect of how rows are stored.
model ClinicalNote {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Lineage identifier, constant across every version. Version 1 sets it to
  /// its own id.
  chainId String @map("chain_id") @db.Uuid
  version Int    @default(1) @db.SmallInt

  /// MSP form code: 002 (consulta externa), 005 (evolución y prescripciones),
  /// 007 (interconsulta), 053 / legacy 011 (referencia-contrarreferencia).
  /// Stored as data, not baked into the schema, so a renumbering by the
  /// ministry costs an UPDATE and not a migration.
  formCode    String @map("form_code") @db.VarChar(8)
  formVersion String @default("1") @map("form_version") @db.VarChar(16)

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  status NoteStatus @default(DRAFT)

  /// Narrative sections of the form. Typed columns carry everything the
  /// ministry reports on or the system queries; prose that is only displayed
  /// and printed lives here, validated against a JSON Schema keyed by
  /// (form_code, form_version).
  content Json @db.JsonB

  authorId String       @map("author_id") @db.Uuid
  author   Practitioner @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  signedById String?       @map("signed_by_id") @db.Uuid
  signedBy   Practitioner? @relation("NoteSigner", fields: [signedById], references: [id], onDelete: Restrict)
  signedAt   DateTime?     @map("signed_at") @db.Timestamptz(6)

  /// SHA-256 of the canonicalised content plus signing metadata. Proves the
  /// content has not changed since signature WITHOUT relying on the
  /// immutability trigger never having been disabled.
  contentHash String? @map("content_hash") @db.Char(64)

  supersedesId String?       @unique @map("supersedes_id") @db.Uuid
  supersedes   ClinicalNote? @relation("NoteAmendment", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy ClinicalNote? @relation("NoteAmendment")

  /// Mandatory free text when creating an amendment. A dropdown gets filled in
  /// on autopilot; a text box does not.
  amendmentReason String? @map("amendment_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  prescriptions Prescription[]

  @@index([encounterId, formCode])
  @@index([chainId, version])
  @@map("clinical_note")
}

// ---------------------------------------------------------------------------
// PRESCRIPTION (form 005)
// ---------------------------------------------------------------------------

model Prescription {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  /// The form-005 note this prescription was issued with, when there is one.
  noteId String?       @map("note_id") @db.Uuid
  note   ClinicalNote? @relation(fields: [noteId], references: [id], onDelete: Restrict)

  prescriberId String       @map("prescriber_id") @db.Uuid
  prescriber   Practitioner @relation(fields: [prescriberId], references: [id], onDelete: Restrict)

  status   PrescriptionStatus @default(DRAFT)
  issuedAt DateTime?          @map("issued_at") @db.Timestamptz(6)

  /// Short code printed on the prescription so a pharmacy can verify it without
  /// receiving any clinical data.
  verificationCode String? @unique @map("verification_code") @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items PrescriptionItem[]

  /// DOC-003. The archived artefacts of this prescription: the emitted PDF and
  /// any that superseded it (DOC-007). A REAL FOREIGN KEY and not a
  /// `(type, id)` pair, so the archive can never point at a prescription that
  /// does not exist.
  documentRenders DocumentRender[]

  /// Descartar exige decir quién, cuándo y por qué —los tres o ninguno, y la
  /// base lo exige—, por la misma razón que anular una cita: sin motivo, es
  /// una forma de hacer desaparecer lo que se escribió.
  discardedAt   DateTime? @map("discarded_at") @db.Timestamptz(6)
  discardedById String?   @map("discarded_by_id") @db.Uuid
  discardedBy   User?     @relation("PrescriptionDiscarder", fields: [discardedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "prescription_discarded_by_fk")
  discardReason String?   @map("discard_reason") @db.VarChar(500)

  @@index([encounterId])
  @@map("prescription")
}

/// FHIR MedicationRequest — one per line of the prescription.
model PrescriptionItem {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  prescriptionId String       @map("prescription_id") @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  /// CNMB concept version. NULL only when prescribing outside the CNMB, which
  /// then requires `offFormularyJustification` (enforced by CHECK).
  conceptId String?         @map("concept_id") @db.Uuid
  concept   CatalogConcept? @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  /// Frozen at prescription time, for the same reason as the CIE-10 display.
  genericName   String  @map("generic_name") @db.VarChar(240)
  presentation  String? @db.VarChar(160)
  concentration String? @db.VarChar(80)

  doseText      String   @map("dose_text") @db.VarChar(160)
  routeCode     String?  @map("route_code") @db.VarChar(32)
  frequencyText String   @map("frequency_text") @db.VarChar(160)
  durationDays  Int?     @map("duration_days") @db.SmallInt
  quantity      Decimal? @db.Decimal(10, 2)
  instructions  String?  @db.Text

  /// Prescribing outside the CNMB is allowed but must be justified in writing.
  offFormularyJustification String? @map("off_formulary_justification") @db.Text

  @@index([prescriptionId])
  @@map("prescription_item")
}

// ---------------------------------------------------------------------------
// ORDERS AND RESULTS
// ---------------------------------------------------------------------------

/// FHIR ServiceRequest.
model ServiceOrder {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  orderedById String       @map("ordered_by_id") @db.Uuid
  orderedBy   Practitioner @relation(fields: [orderedById], references: [id], onDelete: Restrict)

  category ServiceOrderCategory
  priority ServiceOrderPriority @default(ROUTINE)

  clinicalNoteText String? @map("clinical_note_text") @db.Text

  /// Denormalised count maintained by trigger. It exists only so the "pending
  /// results" worklist can be a partial index: index predicates cannot contain
  /// subqueries.
  pendingItems Int @default(0) @map("pending_items") @db.SmallInt

  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items   ServiceOrderItem[]
  reports DiagnosticReport[]

  /// DOC-003. The archived exam request as it was handed to the patient.
  documentRenders DocumentRender[]

  @@index([encounterId])
  @@index([siteId, requestedAt])
  @@map("service_order")
}

model ServiceOrderItem {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  serviceOrderId String       @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  conceptId String         @map("concept_id") @db.Uuid
  concept   CatalogConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  testCode    String @map("test_code") @db.VarChar(32)
  testDisplay String @map("test_display") @db.VarChar(240)

  status ServiceOrderItemStatus @default(REQUESTED)

  /// NULL means pending. The pending-results worklist is a partial index on
  /// this column, so rows LEAVE the index when they complete and it stays
  /// permanently small and cache-resident.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  results ObservationResult[]

  @@index([serviceOrderId])
  @@map("service_order_item")
}

/// FHIR DiagnosticReport.
model DiagnosticReport {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  serviceOrderId String       @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)

  status DiagnosticReportStatus @default(PARTIAL)

  performedById String?       @map("performed_by_id") @db.Uuid
  performedBy   Practitioner? @relation(fields: [performedById], references: [id], onDelete: Restrict)

  conclusion String?   @db.Text
  issuedAt   DateTime? @map("issued_at") @db.Timestamptz(6)

  /// Corrections follow the same rule as clinical notes: a new report that
  /// supersedes the previous one, never an in-place edit. A result already read
  /// by a clinician may have changed a treatment decision.
  supersedesId String?           @unique @map("supersedes_id") @db.Uuid
  supersedes   DiagnosticReport? @relation("ReportCorrection", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy DiagnosticReport? @relation("ReportCorrection")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  results ObservationResult[]

  @@index([serviceOrderId])
  @@map("diagnostic_report")
}

/// FHIR Observation (laboratory). BigInt and not UUID: this is the one clinical
/// table with genuinely high row counts — a metabolic panel is ~20 rows — and
/// they are only ever read through their report.
model ObservationResult {
  id BigInt @id @default(autoincrement())

  reportId String           @map("report_id") @db.Uuid
  report   DiagnosticReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  orderItemId String?           @map("order_item_id") @db.Uuid
  orderItem   ServiceOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  analyteConceptId String?         @map("analyte_concept_id") @db.Uuid
  analyte          CatalogConcept? @relation("ObservationAnalyte", fields: [analyteConceptId], references: [id], onDelete: Restrict)

  analyteDisplay String @map("analyte_display") @db.VarChar(240)

  /// Three value columns because lab results are genuinely polymorphic:
  /// numeric (glucose 92), coded (blood group O+) and textual (culture: no
  /// growth at 48h). A CHECK enforces that exactly one is populated.
  valueNumeric Decimal? @map("value_numeric") @db.Decimal(18, 6)
  valueText    String?  @map("value_text") @db.Text
  valueCode    String?  @map("value_code") @db.VarChar(64)

  unit          String?  @db.VarChar(32)
  referenceLow  Decimal? @map("reference_low") @db.Decimal(18, 6)
  referenceHigh Decimal? @map("reference_high") @db.Decimal(18, 6)
  referenceText String?  @map("reference_text") @db.VarChar(160)

  abnormalFlag AbnormalFlag? @map("abnormal_flag")

  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)

  @@index([reportId])
  @@index([analyteConceptId, observedAt(sort: Desc)])
  @@map("observation_result")
}

// ---------------------------------------------------------------------------
// CERTIFICATES, REFERRAL, INTERCONSULTATION
// ---------------------------------------------------------------------------

model MedicalCertificate {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  issuedById String       @map("issued_by_id") @db.Uuid
  issuedBy   Practitioner @relation(fields: [issuedById], references: [id], onDelete: Restrict)

  type CertificateType

  /// Rest period for MEDICAL_REST. Two dates and not a daterange so Prisma can
  /// read and write them; the range is only needed inside constraints.
  restFrom DateTime? @map("rest_from") @db.Date
  restTo   DateTime? @map("rest_to") @db.Date

  /// The patient decides whether the diagnosis appears on the certificate their
  /// employer will read. Defaults to hidden: privacy by default is an LOPDP
  /// requirement, not a preference.
  includeDiagnosis Boolean @default(false) @map("include_diagnosis")

  body String @db.Text

  /// Printed as a QR so a third party can verify the certificate is genuine
  /// without receiving any clinical data.
  verificationCode String @unique @map("verification_code") @db.VarChar(24)

  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?   @map("revocation_reason") @db.Text

  /// DOC-003, DOC-075. The archived form 117 as it was handed over.
  documentRenders DocumentRender[]

  @@index([patientId, issuedAt(sort: Desc)])
  @@map("medical_certificate")
}

/// MSP form 053 (legacy numbering 011): referral, derivation and
/// counter-referral. One table with a direction, because the counter-referral
/// is the answer to a referral and belongs on the same thread.
model Referral {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  issuedById String       @map("issued_by_id") @db.Uuid
  issuedBy   Practitioner @relation("ReferralIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  direction ReferralDirection
  status    ReferralStatus    @default(ISSUED)

  /// MSP unique code of the destination establishment. A plain string and not
  /// an FK: the destination is normally outside this clinic.
  destinationMspUnicode String? @map("destination_msp_unicode") @db.VarChar(20)
  destinationName       String? @map("destination_name") @db.VarChar(240)

  specialtyConceptId String?         @map("specialty_concept_id") @db.Uuid
  specialty          CatalogConcept? @relation("ReferralSpecialty", fields: [specialtyConceptId], references: [id], onDelete: Restrict)

  reason   String               @db.Text
  summary  String?              @db.Text
  priority ServiceOrderPriority @default(ROUTINE)

  /// A counter-referral answers a referral. Self-relation on the same thread.
  respondsToId String?   @unique @map("responds_to_id") @db.Uuid
  respondsTo   Referral? @relation("ReferralThread", fields: [respondsToId], references: [id], onDelete: Restrict)
  response     Referral? @relation("ReferralThread")

  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([patientId, issuedAt(sort: Desc)])
  @@index([status, issuedAt])
  @@map("referral")
}

/// MSP form 007.
model Interconsultation {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  requestedById String       @map("requested_by_id") @db.Uuid
  requestedBy   Practitioner @relation("InterconsultRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  respondedById String?       @map("responded_by_id") @db.Uuid
  respondedBy   Practitioner? @relation("InterconsultResponder", fields: [respondedById], references: [id], onDelete: Restrict)

  specialtyConceptId String?         @map("specialty_concept_id") @db.Uuid
  specialty          CatalogConcept? @relation("InterconsultationSpecialty", fields: [specialtyConceptId], references: [id], onDelete: Restrict)

  status InterconsultationStatus @default(REQUESTED)

  reason   String  @db.Text
  findings String? @db.Text
  opinion  String? @db.Text

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)

  @@index([encounterId])
  @@index([status, requestedAt])
  @@map("interconsultation")
}

// ---------------------------------------------------------------------------
// MONEY — four pieces people collapse into one
// ---------------------------------------------------------------------------
//
// The classic mistake is putting the price ON the service. It breaks the first
// day an insurer pays differently, and it breaks again when prices rise and
// every past invoice silently changes with them. So:
//
//   1. `BillableService` — what the clinic knows how to do. NO PRICE.
//   2. `PriceList` + `Price` — a price per service PER PAYER, over a validity
//      range that cannot overlap, guaranteed by PostgreSQL rather than by code.
//   3. `ChargeItem` — this patient, this encounter, this service, with the
//      price FROZEN as it stood on the date of service.
//   4. `Invoice` — the tax document, and immutable.

/// Who pays.
///
/// A TABLE AND NOT AN ENUM, deliberately: this system runs in more than one
/// clinic, and the insurers, public networks and company agreements each of
/// them deals with are different lists that change without a deploy. An enum
/// would make «add the new insurer» a migration.
model Payer {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  code String @unique(map: "payer_code_unique") @db.VarChar(32)
  name String @db.VarChar(160)

  /// Distinguishes «the patient pays» from a third party, because the two
  /// behave differently at the cashier and on the invoice. This is NOT the
  /// payer list: there can be many private insurers, all of them THIRD_PARTY
  /// in behaviour. Constrained to SELF_PAY, PUBLIC_NETWORK, PRIVATE_INSURANCE
  /// and COMPANY_AGREEMENT by `payer_kind_is_known`, and kept as a CHECK
  /// rather than an enum for the same reason the table exists.
  kind String @db.VarChar(24)

  /// RUC of the third party, when there is one. The patient's own document
  /// lives on `patient`. Its shape is `payer_ruc_format` (BI-036).
  ruc String? @db.VarChar(13)

  /// Informational, and what makes «convenio vencido» an answerable question.
  agreementReference String?   @map("agreement_reference") @db.VarChar(120)
  agreementValidTo   DateTime? @map("agreement_valid_to") @db.Date

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  priceLists PriceList[]
  accounts   PatientAccount[]

  @@map("payer")
}

/// A VAT rate as the SRI publishes it, with the period it was in force.
///
/// D-A-006. Health services are 0% (LRTI art. 56.2), but the 0% depends on the
/// PROVIDER and not on the service: art. 191 of the regulation conditions it on
/// an authorised establishment and a professional with a registered
/// third-level degree, and it EXCLUDES cosmetic surgery and cosmetology, which
/// go to the general rate. The system therefore does NOT infer the rate —
/// every service carries its own, editable, in plain sight, for someone with
/// accounting judgement to review.
model TaxRate {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// The SRI's `codigoPorcentaje` from the electronic-voucher technical sheet
  /// (table 17): 0 → 0%, 2 → 12%, 3 → 14%, 4 → 15%, 5 → 5%, 6 → no objeto,
  /// 7 → exento, 8 → diferenciado, 10 → 13%. Codes 6 and 7 are NOT synonyms of
  /// 0% and must never be used as a convenience.
  sriCode String @map("sri_code") @db.VarChar(4)
  name    String @db.VarChar(80)

  /// NULL for «no objeto» and «exento», where no percentage applies at all.
  percentage Decimal? @db.Decimal(5, 2)

  validFrom DateTime  @map("valid_from") @db.Date
  /// NULL means still in force.
  validTo   DateTime? @map("valid_to") @db.Date

  /// GENERATED ALWAYS AS daterange(valid_from, valid_to, '[)') STORED, written
  /// by the migration. Prisma has no syntax for a generated column — it would
  /// read the column as a stray one and drop it — so it is declared here as
  /// `Unsupported` purely so that it survives. STORED and not VIRTUAL because
  /// PostgreSQL 18 cannot constrain a virtual column, and constraining it is
  /// the entire reason it exists: `tax_rate_code_temporal_unique` is a
  /// `UNIQUE (sri_code, valid_period WITHOUT OVERLAPS)`, which is what stops
  /// one SRI code from having two simultaneous percentages.
  validPeriod Unsupported("daterange")?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  billableServices BillableService[]

  @@map("tax_rate")
}

/// What the clinic knows how to do — and WITHOUT A PRICE, which is the point.
model BillableService {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  code String @unique(map: "billable_service_code_unique") @db.VarChar(32)
  name String @db.VarChar(200)

  /// Grouping for the screen and for reporting. A table of its own would be
  /// over-engineering: this is a label, not an entity.
  category String @db.VarChar(60)

  /// The MSP tariff code, when the service has one. NOMENCLATURE ONLY — the
  /// Tarifario does NOT set what a private patient is charged, its scope having
  /// been narrowed by A.M. 0046-2017 to dealings inside the public network. It
  /// is kept because it is what makes billing TO that network possible.
  tariffCode String? @map("tariff_code") @db.VarChar(16)

  /// D-A-006: the rate is a property OF THE SERVICE, and editable.
  taxRateId String  @map("tax_rate_id") @db.Uuid
  taxRate   TaxRate @relation(fields: [taxRateId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "billable_service_tax_rate_fk")

  /// Ties the service to what actually happened, so a charge can be raised from
  /// the encounter instead of typed at the cashier. Optional because a service
  /// may be no procedure at all — a room fee, a supply.
  procedureConceptId String?         @map("procedure_concept_id") @db.Uuid
  procedureConcept   CatalogConcept? @relation(fields: [procedureConceptId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "billable_service_procedure_fk")

  /// BI-158. WHICH SERVICE IS «THE CONSULTATION» of a specialty, and whether
  /// it is the first visit or a subsequent one.
  ///
  /// A ROW AND NOT A RULE OVER THE CODE. Reading `CONS-DER-PV` as «dermatology,
  /// first visit» works with the seed and fails silently at the first clinic
  /// that uses its own coding: the consultation charge would simply stop being
  /// proposed, and an unbilled consultation raises no error at all — only less
  /// money. Same reasoning as BI-005 on not inferring the tax rate.
  ///
  /// Both or neither (`billable_service_consultation_states_both`), and one
  /// service per pair (`billable_service_one_per_consultation`, PARTIAL, in
  /// the migration).
  specialtyId   String?    @map("specialty_id") @db.Uuid
  specialty     Specialty? @relation(fields: [specialtyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "billable_service_specialty_fk")
  /// `FIRST_TIME` or `SUBSEQUENT`, as text and not as the clinical
  /// `visit_sequence` enum: the economic catalogue must be able to evolve
  /// without depending on a type of the clinical schema, and
  /// `billable_service_visit_sequence_is_known` refuses anything else just as
  /// early.
  visitSequence String?    @map("visit_sequence") @db.VarChar(16)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices          Price[]
  chargeItems     ChargeItem[]
  examDefinitions ExamDefinition[]
  /// WHO CHECKED THIS RATE, which is the whole point of D-A-006.
  ///
  /// The seed ships a DEFAULT: 0% for health services (LRTI art. 56.2), the
  /// general rate for supplies and cosmetic work (art. 191 of the regulation).
  /// A default is not a fiscal classification, and the system deliberately
  /// does NOT infer one — the 0% depends on the PROVIDER holding a current
  /// permit and a registered third-level degree, which no column can know.
  ///
  /// Until these existed there was no way to tell a rate somebody checked from
  /// one nobody has looked at since it was seeded. That difference is what an
  /// inspection asks about.
  taxReviewedAt   DateTime?        @map("tax_reviewed_at") @db.Timestamptz(6)
  taxReviewedById String?          @map("tax_reviewed_by_id") @db.Uuid
  taxReviewedBy   User?            @relation("TaxRateReviewer", fields: [taxReviewedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "billable_service_tax_reviewer_fk")

  @@index([category, name], map: "billable_service_by_category")
  @@map("billable_service")
}

/// A set of prices belonging to one payer. Self-pay is a payer like any other,
/// which is what keeps «the normal price» from being a special case in code.
model PriceList {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  name String @db.VarChar(120)

  payerId String @map("payer_id") @db.Uuid
  payer   Payer  @relation(fields: [payerId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "price_list_payer_fk")

  /// NULL means every site. A clinic whose branches charge differently sets it;
  /// one that does not never sees the field.
  siteId String? @map("site_id") @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "price_list_site_fk")

  /// LOS art. 184 obliges the clinic to «exhibir en sitios visibles para el
  /// público las tarifas que se cobran». A list marked public is what that
  /// screen reads.
  publiclyListed Boolean @default(false) @map("publicly_listed")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices   Price[]
  accounts PatientAccount[]

  @@map("price_list")
}

/// What one service costs in one list, over one period.
model Price {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  priceListId String    @map("price_list_id") @db.Uuid
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "price_list_fk")

  billableServiceId String          @map("billable_service_id") @db.Uuid
  billableService   BillableService @relation(fields: [billableServiceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "price_service_fk")

  /// Decimal, never Float. Money in binary floating point is a defect waiting
  /// for the invoice that is off by a cent.
  amount Decimal @db.Decimal(12, 2)

  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  /// GENERATED ALWAYS AS daterange(valid_from, valid_to, '[)') STORED, written
  /// by the migration. Prisma cannot express a generated column, so it is
  /// declared `Unsupported` only so that Prisma leaves it alone instead of
  /// dropping it as a column the schema does not know about.
  ///
  /// It carries THE guarantee of this table: `price_temporal_unique` is
  /// `UNIQUE (price_list_id, billable_service_id, valid_period WITHOUT
  /// OVERLAPS)`, so one service cannot hold two simultaneous prices in the same
  /// list. Enforced by PostgreSQL, so no application path can create the
  /// ambiguity that would make «what did this cost that day» unanswerable.
  validPeriod Unsupported("daterange")?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  chargeItems ChargeItem[]

  @@map("price")
}

/// What one visit owes.
model PatientAccount {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "patient_account_patient_fk")

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "patient_account_site_fk")

  /// NULL for an account opened outside a clinical act — a walk-in lab test
  /// bought at the counter.
  encounterId String?    @map("encounter_id") @db.Uuid
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "patient_account_encounter_fk")

  /// WHO PAYS, decided at arrival and not at the cashier. Asking at the end is
  /// asking too late: it is what decides the price of everything before it.
  payerId     String    @map("payer_id") @db.Uuid
  payer       Payer     @relation(fields: [payerId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "patient_account_payer_fk")
  priceListId String    @map("price_list_id") @db.Uuid
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "patient_account_price_list_fk")

  /// OPEN, SETTLED or CANCELLED (`patient_account_status_is_known`), and
  /// `patient_account_closed_states_its_instant` ties it to `closedAt` in both
  /// directions.
  status String @default("OPEN") @db.VarChar(16)

  openedAt DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  chargeItems ChargeItem[]
  invoices    Invoice[]

  /// `patient_account_one_open_per_encounter` — one OPEN account per encounter,
  /// because two would make «what does this visit owe» ambiguous — is NOT here
  /// and cannot be: it is a PARTIAL unique index (`WHERE status = 'OPEN' AND
  /// encounter_id IS NOT NULL`), and a plain `@@unique` would forbid the second
  /// account even after the first was settled. It lives in the migration.
  @@index([patientId, openedAt(sort: Desc)], map: "patient_account_by_patient")
  @@map("patient_account")
}

/// «This patient, this encounter, this service» — and the piece that prevents
/// every later problem.
///
/// What was done and what is charged are two records and must never be one:
/// the clinical fact does not change because the patient did not pay, and
/// deleting a charge cannot delete the act.
model ChargeItem {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  accountId String         @map("account_id") @db.Uuid
  account   PatientAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "charge_item_account_fk")

  billableServiceId String          @map("billable_service_id") @db.Uuid
  billableService   BillableService @relation(fields: [billableServiceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "charge_item_service_fk")

  /// Where it came from clinically. Optional because not every charge is a
  /// procedure and not every procedure is charged.
  encounterId String?    @map("encounter_id") @db.Uuid
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "charge_item_encounter_fk")

  /// Scalars with NO relation and NO foreign key, matching the migration: the
  /// billing side must not be able to hold a clinical row hostage under
  /// `RESTRICT`. Declaring the relation here would make Prisma create the key.
  encounterProcedureId String? @map("encounter_procedure_id") @db.Uuid
  serviceOrderItemId   String? @map("service_order_item_id") @db.Uuid

  /// BI-153. Where the line came from: MANUAL, CONSULTATION, PROCEDURE or EXAM
  /// (`charge_item_origin_is_known`), with
  /// `charge_item_origin_names_its_act` keeping it in agreement with the two
  /// identifiers above.
  ///
  /// It is a column and NOT «whichever identifier is filled in», because the
  /// consultation has no clinical row of its own to point at — the act IS the
  /// encounter — so without it «la consulta» and «una gasa que la cajera
  /// añadió» are indistinguishable, and
  /// `charge_item_one_consultation_per_encounter` could not be written.
  origin String @default("MANUAL") @db.VarChar(16)

  /// THE DATE THAT RESOLVES THE PRICE. Clinical, in `America/Guayaquil`, and
  /// not the instant the cashier typed it.
  serviceDate DateTime @map("service_date") @db.Date

  quantity Decimal @default(1) @db.Decimal(10, 3)

  /// FROZEN, and this is the whole reason the table exists. The unit price is
  /// the one resolved from the price list ON `serviceDate`, copied here — not
  /// looked up when the invoice prints. Without the copy, raising a tariff
  /// tomorrow rewrites every past invoice, and a visit from three months ago
  /// billed today is charged at today's rate. `resolvedPriceId` keeps the row
  /// it came from so the resolution is auditable years later.
  unitAmount      Decimal @map("unit_amount") @db.Decimal(12, 2)
  resolvedPriceId String? @map("resolved_price_id") @db.Uuid
  resolvedPrice   Price?  @relation(fields: [resolvedPriceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "charge_item_price_fk")

  /// Frozen too, for the same reason as `procedure_display` elsewhere in this
  /// schema: renaming a service in the catalogue — or losing the catalogue —
  /// must not change what a past invoice says was sold.
  serviceDisplay String @map("service_display") @db.VarChar(200)

  /// The tax rate AS IT APPLIED THAT DAY, copied and not joined. Rates change,
  /// and a 2024 invoice has to keep saying 12% forever.
  taxSriCode    String   @map("tax_sri_code") @db.VarChar(4)
  taxPercentage Decimal? @map("tax_percentage") @db.Decimal(5, 2)

  /// The money taken off, NEVER a percentage: a percentage re-derived at print
  /// time drifts by rounding. `charge_item_discount_states_a_reason` refuses a
  /// discount nobody can explain, and
  /// `charge_item_discount_within_line` refuses one larger than the line.
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason String? @map("discount_reason") @db.VarChar(300)

  /// Who authorised a discount above the role's ceiling, NULL when it was
  /// within it. This is the second pair of eyes, so it is a different column
  /// from `createdById` on purpose.
  discountAuthorisedById String? @map("discount_authorised_by_id") @db.Uuid
  discountAuthorisedBy   User?   @relation("ChargeItemDiscountAuthoriser", fields: [discountAuthorisedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "charge_item_discount_authorised_by_fk")

  /// PLANNED, BILLABLE, NOT_BILLABLE, BILLED or CANCELLED
  /// (`charge_item_status_is_known`).
  status String @default("BILLABLE") @db.VarChar(16)

  /// VOIDING A CHARGE, with the reason actually kept.
  ///
  /// The three travel together — `charge_item_void_states_who_when_and_why`
  /// refuses one without the others — because demanding a reason the system
  /// then throws away is worse than not asking: it looks like an audit trail
  /// and is not one.
  ///
  /// And this is NOT an invoice being edited. A charge is voided BEFORE it
  /// reaches an invoice; once billed the only correction is a credit note, and
  /// `charge_item_billed_is_not_voided` makes that structural.
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedById String?   @map("voided_by_id") @db.Uuid
  voidedBy   User?     @relation("ChargeVoider", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "charge_item_voided_by_fk")
  voidReason String?   @map("void_reason") @db.VarChar(500)

  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation("ChargeItemAuthor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "charge_item_created_by_fk")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// `charge_item_by_encounter` is not here: it is partial
  /// (`WHERE encounter_id IS NOT NULL`), which is what keeps it from indexing
  /// every counter sale. It lives in the migration. Neither are the three
  /// PARTIAL UNIQUE indexes that make BI-154 true —
  /// `charge_item_one_per_encounter_procedure`,
  /// `charge_item_one_per_service_order_item` and
  /// `charge_item_one_consultation_per_encounter` — nor
  /// `charge_item_derived_by_encounter`: a plain `@@unique` would forbid every
  /// counter sale with a NULL identifier from having a second sibling.
  @@index([accountId], map: "charge_item_by_account")
  @@map("charge_item")
}

/// The tax document, and IMMUTABLE.
///
/// D-A-007. The SRI does not allow modifying or deleting an authorised
/// invoice: online voiding runs until the 10th of the following month, after
/// that only a credit note, for twelve months — and from 2026 invoices issued
/// to «Consumidor Final» cannot be voided at all.
///
/// So this system has no «edit invoice» screen. It has «issue a credit note»,
/// a different screen with a different permission and a mandatory reason.
/// `trg_invoice_immutable` freezes every meaningful column once the status is
/// AUTHORISED or VOIDED, and `trg_invoice_no_delete` refuses DELETE outright,
/// which is what makes that true in the DATABASE and not merely in the UI.
/// Neither trigger is expressible here — see the migration.
model Invoice {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  accountId String         @map("account_id") @db.Uuid
  account   PatientAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "invoice_account_fk")

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "invoice_site_fk")

  /// SRI sequence: establishment · emission point · sequential.
  emissionPointId String        @map("emission_point_id") @db.Uuid
  emissionPoint   EmissionPoint @relation(fields: [emissionPointId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "invoice_emission_point_fk")
  sequential      String        @db.VarChar(9)

  /// The 49-digit access key, once the SRI authorises the voucher.
  accessKey String? @map("access_key") @db.VarChar(49)

  /// WHO THE INVOICE IS MADE OUT TO, and deliberately not nullable: issuing to
  /// «consumidor final» destroys the patient's personal-expense rebate and,
  /// since 2026, cannot even be voided. It has to be a choice somebody makes,
  /// which is why `isFinalConsumer` is a flag surfaced as an exception rather
  /// than the comfortable default — and why
  /// `invoice_final_consumer_identification` forces the SRI's own placeholder
  /// identification when it is set.
  buyerIdentificationType String  @map("buyer_identification_type") @db.VarChar(2)
  buyerIdentification     String  @map("buyer_identification") @db.VarChar(20)
  buyerName               String  @map("buyer_name") @db.VarChar(300)
  buyerEmail              String? @map("buyer_email") @db.VarChar(320)
  isFinalConsumer         Boolean @default(false) @map("is_final_consumer")

  /// `invoice_total_is_consistent` keeps the five in agreement in the database,
  /// so a rounding bug cannot leave a document the SRI will reject.
  subtotalTaxed   Decimal @map("subtotal_taxed") @db.Decimal(12, 2)
  subtotalUntaxed Decimal @map("subtotal_untaxed") @db.Decimal(12, 2)
  discountTotal   Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal        Decimal @map("tax_total") @db.Decimal(12, 2)
  total           Decimal @db.Decimal(12, 2)

  /// DRAFT, ISSUED, AUTHORISED, REJECTED or VOIDED
  /// (`invoice_status_is_known`). AUTHORISED carries its access key and its
  /// instant, or it is not authorised (`invoice_authorised_carries_its_key`).
  status String @default("DRAFT") @db.VarChar(24)

  issuedAt     DateTime? @map("issued_at") @db.Timestamptz(6)
  authorisedAt DateTime? @map("authorised_at") @db.Timestamptz(6)

  issuedById String   @map("issued_by_id") @db.Uuid
  issuedBy   User     @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "invoice_issued_by_fk")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creditNotes CreditNote[]

  /// DOC-003, DOC-076. The archived RIDE. The invoice itself is the electronic
  /// voucher; this is the printable representation the SRI's Anexo 2 describes.
  documentRenders DocumentRender[]

  @@unique([emissionPointId, sequential], map: "invoice_sequential_unique")
  @@index([accountId], map: "invoice_by_account")
  @@map("invoice")
}

/// The one legal way to correct an authorised invoice.
model CreditNote {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "credit_note_invoice_fk")

  emissionPointId String        @map("emission_point_id") @db.Uuid
  emissionPoint   EmissionPoint @relation(fields: [emissionPointId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "credit_note_emission_point_fk")
  sequential      String        @db.VarChar(9)
  accessKey       String?       @map("access_key") @db.VarChar(49)

  /// NEVER optional. A correction with no stated motive is indistinguishable
  /// from an error being buried.
  reason String @db.VarChar(500)

  amount Decimal @db.Decimal(12, 2)

  /// DRAFT, ISSUED, AUTHORISED or REJECTED (`credit_note_status_is_known`).
  /// There is no VOIDED: a credit note that was wrong is corrected by the
  /// documents that follow it, never by unwinding this one.
  status String @default("DRAFT") @db.VarChar(24)

  issuedById String    @map("issued_by_id") @db.Uuid
  issuedBy   User      @relation("CreditNoteIssuer", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "credit_note_issued_by_fk")
  issuedAt   DateTime? @map("issued_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([emissionPointId, sequential], map: "credit_note_sequential_unique")
  @@map("credit_note")
}

// ---------------------------------------------------------------------------
// WHAT CAN BE ORDERED, AND WHAT COMES BACK
// ---------------------------------------------------------------------------
//
// The distinction that decides this whole design: what is ORDERED and what is
// RESULTED are different things, 1:N. «Biometría hemática» is one line on the
// order and one line on the invoice, and it returns twenty analytes, each with
// its own unit, reference range and abnormal flag.
//
// Every standard separates them — HL7 v2 puts them in different segments,
// LOINC classifies them with a field of its own — and the MSP already did too:
// form 010A is a closed list of «determinaciones» ticked with an X, and form
// 010B reports DETERMINACIÓN · RESULTADO · UNIDAD DE MEDIDA · VALOR DE
// REFERENCIA. Ordering by free text was already impossible here; what did not
// exist is the DEFINITION of what an order yields.

/// An analyte: the thing that returns a value.
model AnalyteDefinition {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  code String @unique(map: "analyte_definition_code_unique") @db.VarChar(32)
  name String @db.VarChar(160)

  /// OPTIONAL ON PURPOSE, and it stays that way. No Ecuadorian norm requires
  /// LOINC: form 010 has no code column at all, and the only official mention
  /// is in the telehealth norm, binding only on whoever provides telehealth.
  /// Mapping is expert human work — automated mapping scores around 0.59
  /// precision — so requiring it would either stall the catalogue or fill it
  /// with wrong codes. It is a SECONDARY code for the 20–60 analytes worth the
  /// effort, never the identity of the row: `code` is.
  loincCode String? @map("loinc_code") @db.VarChar(16)

  /// UCUM, so that 'mg/dL' means one thing. Required for NUMERIC analytes by
  /// `analyte_definition_numeric_carries_a_unit`: a number with no unit is not
  /// a result.
  unit String? @db.VarChar(32)

  /// NUMERIC, CODED, TEXT or ORDINAL
  /// (`analyte_definition_value_type_is_known`).
  valueType String @map("value_type") @db.VarChar(16)
  decimals  Int?   @db.SmallInt

  /// The allowed answers when the type is coded: positive/negative, S/I/R.
  allowedValues Json? @map("allowed_values") @db.JsonB

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  referenceRanges AnalyteReferenceRange[]
  exams           ExamDefinitionAnalyte[]

  @@map("analyte_definition")
}

/// A reference range qualified by sex and age. The reason `abnormal_flag` can
/// be computed at all rather than typed by whoever reads the report.
model AnalyteReferenceRange {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  analyteDefinitionId String            @map("analyte_definition_id") @db.Uuid
  analyteDefinition   AnalyteDefinition @relation(fields: [analyteDefinitionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "analyte_reference_range_analyte_fk")

  /// NULL means it applies to everyone. Age in DAYS, not years, because the
  /// ranges that differ most are a neonate's.
  sex        String? @db.VarChar(16)
  ageMinDays Int?    @map("age_min_days")
  ageMaxDays Int?    @map("age_max_days")

  /// REFERENCE, CRITICAL or ABSOLUTE
  /// (`analyte_reference_range_kind_is_known`). CRITICAL is not a narrower
  /// REFERENCE: it is the band that has to reach a human today.
  rangeKind String @default("REFERENCE") @map("range_kind") @db.VarChar(16)

  /// At least one of the three is present
  /// (`analyte_reference_range_says_something`) — a range that says nothing is
  /// a row that costs a join and answers no question. `text` carries the
  /// qualitative ones, where there are no bounds to compare against.
  low  Decimal? @db.Decimal(14, 4)
  high Decimal? @db.Decimal(14, 4)
  text String?  @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([analyteDefinitionId], map: "analyte_reference_range_by_analyte")
  @@map("analyte_reference_range")
}

/// The orderable: what the doctor asks for and what the invoice charges. One
/// of these yields many `AnalyteDefinition`s.
model ExamDefinition {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  code String @unique(map: "exam_definition_code_unique") @db.VarChar(32)
  name String @db.VarChar(200)

  /// The section of MSP form 010A this belongs to, so that a compliant order
  /// can be printed. That form binds the private sector too:
  /// A.M. 00002393 art. 42.
  form010Section String? @map("form_010_section") @db.VarChar(60)

  /// What the patient must do beforehand, printed on the order itself.
  specimenType       String? @map("specimen_type") @db.VarChar(80)
  patientPreparation String? @map("patient_preparation") @db.VarChar(500)
  turnaroundHours    Int?    @map("turnaround_hours") @db.SmallInt

  /// Which lab performs it. External is the realistic case (D-A-012), so it is
  /// the default rather than the exception.
  performedExternally Boolean @default(true) @map("performed_externally")
  externalLabName     String? @map("external_lab_name") @db.VarChar(160)
  externalLabCode     String? @map("external_lab_code") @db.VarChar(64)

  /// What it costs — by pointing at the same four-piece model as everything
  /// else. The price is NOT here; it is in a price list, per payer, per period.
  billableServiceId String?          @map("billable_service_id") @db.Uuid
  billableService   BillableService? @relation(fields: [billableServiceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "exam_definition_service_fk")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  analytes ExamDefinitionAnalyte[]

  @@map("exam_definition")
}

/// Which analytes an exam yields — the relation without which a result has
/// nothing to be validated against.
model ExamDefinitionAnalyte {
  examDefinitionId String         @map("exam_definition_id") @db.Uuid
  examDefinition   ExamDefinition @relation(fields: [examDefinitionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "exam_definition_analyte_exam_fk")

  analyteDefinitionId String            @map("analyte_definition_id") @db.Uuid
  analyteDefinition   AnalyteDefinition @relation(fields: [analyteDefinitionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "exam_definition_analyte_analyte_fk")

  /// The order they are printed and displayed in. Stored, because a laboratory
  /// report read in alphabetical order is a report nobody can scan.
  position Int @db.SmallInt

  /// A reflex analyte is only produced when another comes back positive, so it
  /// is expected to be missing and its absence is not an incomplete result.
  isReflex Boolean @default(false) @map("is_reflex")

  @@id([examDefinitionId, analyteDefinitionId])
  @@map("exam_definition_analyte")
}

/// How much each role may discount without asking a second person.
///
/// A ROW and not a constant, because the user's answer on discounts was
/// «flexible, el admin asigna» — and roles are already data in this system, so
/// a limit keyed to a hardcoded role list would be the one piece that still
/// needed a deploy.
///
/// Above the ceiling the answer is not «no»: it is «ask someone else», which
/// is what `billing:discount-override` exists for.
model RoleDiscountLimit {
  roleId String @id @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_discount_limit_role_fk")

  /// A percentage and not an amount: a fixed sum means something different on
  /// a $25 consultation than on a $600 procedure, and the clinic thinks in
  /// percentages.
  maxDiscountPercentage Decimal @map("max_discount_percentage") @db.Decimal(5, 2)

  /// Below this, no second signature at all. Lets a clinic waive rounding
  /// without turning every cent into a two-person ceremony.
  autoApproveBelowAmount Decimal @default(0) @map("auto_approve_below_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("role_discount_limit")
}

/// El rastro del estado del paciente, que `subject_status_at` no puede dar.
///
/// Esa columna guarda SÓLO el último instante: al tercer cambio ya no se puede
/// contestar cuándo fueron los dos primeros. Es literalmente el defecto que
/// `last_contacted_at` tenía y que se cerró construyendo
/// `waitlist_contact_attempt`.
///
/// «Cuánto esperó esta persona» es la pregunta para la que existe el tablero
/// entero, y una sola columna sólo la contesta para el tramo actual.
model AgendaSubjectStatusHistory {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  agendaEntryId String      @map("agenda_entry_id") @db.Uuid
  agendaEntry   AgendaEntry @relation(fields: [agendaEntryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "agenda_subject_status_history_entry_fk")

  fromStatus PatientSubjectStatus? @map("from_status")
  toStatus   PatientSubjectStatus  @map("to_status")

  /// QUÉ LO CAUSÓ, no quién lo tecleó. Sólo `ARRIVED` se teclea; los otros
  /// cinco son consecuencia de documentar algo, así que la columna útil es el
  /// hecho —«se guardaron los signos», «se abrió la nota»— y el actor es quien
  /// realizó ese acto.
  causedBy    String  @map("caused_by") @db.VarChar(64)
  changedById String? @map("changed_by_id") @db.Uuid
  changedBy   User?   @relation("SubjectStatusChanger", fields: [changedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "agenda_subject_status_history_actor_fk")

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// Append-only por disparador: un rastro que se puede reescribir no es un
  /// rastro. Prisma no expresa el disparador; vive en la migración.
  @@index([agendaEntryId, occurredAt], map: "agenda_subject_status_history_by_entry")
  @@map("agenda_subject_status_history")
}

// ---------------------------------------------------------------------------
// DOCUMENTS — the printable representation, and the artefact that stays
// ---------------------------------------------------------------------------
//
// D-A-014, D-A-015. Ley 67 art. 8(b) says a data message is kept «con el
// formato en el que se haya generado … o con algún formato que sea demostrable
// que reproduce con exactitud», and ACESS-2023-0030 art. 9 says a prescription
// «debe contar con una copia de respaldo para su archivo». Neither is satisfied
// by re-drawing an HTML page on demand, and ETSI EN 319 142-1 closes the
// discussion: a PAdES signature «shall cover the entire file», so signing and
// regenerating are mutually exclusive.
//
// This project already freezes the DATA — the diagnosis snapshot, the DCI of a
// prescription, the age of an attention. What was missing was freezing the
// REPRESENTATION.

/// DOC-003. What an artefact represents. One value per subject table, so
/// `document_render_kind_matches_subject` can hold the two in agreement.
enum DocumentKind {
  PRESCRIPTION
  SERVICE_ORDER
  MEDICAL_CERTIFICATE
  INVOICE_RIDE

  @@map("document_kind")
}

/// DOC-077. The RIMPE regime legend the RIDE carries, per the SRI's Ficha
/// Técnica Anexo 2. `NONE` is the general regime and prints nothing.
enum RimpeRegime {
  NONE
  ENTREPRENEUR
  POPULAR_BUSINESS

  @@map("rimpe_regime")
}

/// DOC-050 to DOC-058. An image printed on a document: the establishment's
/// logo, or a practitioner's seal or signature.
///
/// ═══════════════════════════════════════════════════════════════════════════
/// ONE TABLE FOR THE THREE, AND WHY THAT IS NOT PREMATURE SHARING
/// ═══════════════════════════════════════════════════════════════════════════
///
/// The three carry the SAME six facts and pass through the SAME hostile-input
/// pipeline — byte cap before decoding, pixel cap against decompression bombs,
/// re-encode from pixels, flatten the alpha channel because PDF/A-1b forbids
/// transparency. Repeating six columns three times across two tables would be
/// three places to forget one of those steps, and the step nobody would repeat
/// is the alpha flattening, whose absence produces PDFs that look right and do
/// not validate. WHOSE image it is stays where it belongs: on the foreign key.
///
/// THE BYTES LIVE HERE AND NOT ON A DISK (D-A-015): `pg_dump` and a filesystem
/// copy are not a coherent snapshot of each other, so restoring the database at
/// 03:00 and the disk at 03:15 leaves rows pointing at files that do not exist.
/// A 200 KB logo goes out of line via TOAST and leaves 18 bytes in the row.
model DocumentImage {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// DOC-050. `image/png` or `image/jpeg` and nothing else
  /// (`document_image_mime_type_allowed`). NEVER `image/svg+xml`: an SVG DOES
  /// execute scripts when navigated to directly, and «we only paint it in an
  /// `img`» holds until somebody opens the image in a new tab.
  mimeType String @map("mime_type") @db.VarChar(32)

  /// DOC-054. The RE-ENCODED bytes. Never the ones that arrived: re-encoding is
  /// what removes metadata, odd colour profiles and mixed payloads.
  bytes Bytes

  /// `document_image_byte_size_is_consistent` keeps this equal to
  /// `octet_length(bytes)`. It exists so a listing can show the size without
  /// dragging the image out of TOAST.
  byteSize Int @map("byte_size")

  /// Lowercase hex, 64 characters (`document_image_sha256_format`).
  sha256 String @db.Char(64)

  width  Int
  height Int

  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  uploadedBy   User     @relation("DocumentImageUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_image_uploaded_by_fk")

  /// DOC-058. Insert-only by trigger. Replacing an image means inserting a new
  /// row and repointing the reference — an image that changes underneath would
  /// change what a seal says with nothing recording it, and the seal is one of
  /// the two things art. 5 asks for twice.
  establishmentLogos     Establishment[] @relation("EstablishmentLogo")
  practitionerSeals      Practitioner[]  @relation("PractitionerSeal")
  practitionerSignatures Practitioner[]  @relation("PractitionerSignature")

  @@map("document_image")
}

/// DOC-030 to DOC-037. The versioned template of one class of document.
///
/// ⚠️ FIXED SLOTS, NOT AN EDITABLE TEMPLATE. The general risk has a name —
/// INTERNAL PLATFORM EFFECT: making something so configurable that it becomes a
/// badly-made programming language inside your application — but the argument
/// this project owns is stronger: A VERIFIABLE EARS REQUIREMENT CANNOT BE
/// WRITTEN AGAINST A TEMPLATE THE CLINIC REWROTE ON TUESDAY. The chain
/// normativa → REQ → DOC → prueba stops being checkable the moment the
/// structure of the document is tenant data. What is parameterised is exactly
/// what Stripe parameterises, and it is enough.
///
/// ⚠️ THE CURRENT VERSION IS THE HIGHEST ONE, AND THERE IS NO `active` COLUMN.
/// A flag would need an `UPDATE` to move, and an `UPDATE` on a versions table
/// is precisely the change-underneath-your-feet this module exists to prevent.
/// Insert-only by trigger (`trg_document_template_immutable`).
model DocumentTemplate {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  kind    DocumentKind
  version Int

  /// DOC-035. `#rrggbb`, lowercase (`document_template_accent_colour_format`).
  accentColour String @map("accent_colour") @db.Char(7)

  /// DOC-034. Free text at the foot of every page. Spanish: the patient reads it.
  footerText String? @map("footer_text") @db.VarChar(500)

  /// DOC-036. At most SIX `{ "label": …, "value": … }` entries
  /// (`document_template_header_fields_bounded`). The cap IS the slot made into
  /// a rule: without it, «a few key-value fields» becomes the free-form table
  /// this design refuses, one field a week.
  headerFields Json @default("[]") @map("header_fields")

  /// DOC-034. THE THREE FIELDS ART. 5 DOES NOT REQUIRE. The only establishment
  /// datum the prescription must carry is the NAME; RUC, address and telephone
  /// are the clinic's choice, so they are switches and not columns of the
  /// document.
  showEstablishmentRuc     Boolean @default(false) @map("show_establishment_ruc")
  showEstablishmentAddress Boolean @default(false) @map("show_establishment_address")
  showEstablishmentPhone   Boolean @default(false) @map("show_establishment_phone")

  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedById String   @map("published_by_id") @db.Uuid
  publishedBy   User     @relation("DocumentTemplatePublisher", fields: [publishedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_template_published_by_fk")

  renders DocumentRender[]

  @@unique([kind, version], map: "document_template_kind_version_unique")
  @@map("document_template")
}

/// DOC-002 to DOC-014. THE ARTEFACT: the bytes that were emitted, and the proof
/// they have not moved since.
///
/// ═══════════════════════════════════════════════════════════════════════════
/// IMMUTABLE. NO `UPDATE`, NO `DELETE`, BY TRIGGER.
/// ═══════════════════════════════════════════════════════════════════════════
///
/// Ley 67 art. 7 requires being able to show the document «ha conservado la
/// integridad de la información … desde que se generó en su forma definitiva».
/// An `UPDATE` nobody prevents makes that claim impossible to assert — not for
/// the row that changed, but for every row, because nothing distinguishes them.
///
/// Reprinting is serving these bytes. Correcting is emitting a NEW artefact
/// that declares `supersedes_id` over this one and says why; this one is never
/// touched. That is the pattern `prescription.discarded_at` and the credit note
/// already use: in a clinical system nothing is deleted.
///
/// ⚠️ NO `updated_at`, AND ITS ABSENCE IS THE POINT. Every other table here
/// carries one; a table that cannot be updated has nothing to put in it, and a
/// column Prisma would try to write on every save would fight the trigger.
///
/// > **Falta esquema.** There is NO column for an electronic signature: not the
/// > certificate, not the instant, not the time-stamp token, not the validation
/// > outcome. PAdES «shall cover the entire file», so a signature either arrives
/// > with the bytes or needs a superseding row — and neither is decided. The
/// > candidate library covers only the basic level, WITHOUT time-stamping, and
/// > it is not verified that time-stamping authorities operate in Ecuador. A
/// > signature that stops validating when the doctor's certificate expires — two
/// > years — while the archive has to last five (art. 15) is worse than none,
/// > because it looks valid.
model DocumentRender {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  kind DocumentKind

  templateId String           @map("template_id") @db.Uuid
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_render_template_fk")

  /// DOC-033. The version NUMBER, copied. The foreign key says WHICH template;
  /// this says what number it was, and keeps saying it. Same argument as the
  /// prescription freezing the DCI while holding `concept_id`.
  templateVersion Int @map("template_version")

  /// DOC-003. EXACTLY ONE of the four (`document_render_one_subject`), and it
  /// has to match `kind` (`document_render_kind_matches_subject`).
  ///
  /// FOUR COLUMNS AND NOT A `(type, id)` PAIR: with real columns there are real
  /// foreign keys, so the archive can never point at a prescription that does
  /// not exist. A polymorphic pair has none, and the day a row is removed the
  /// archive points at nothing and nothing complains.
  prescriptionId String?       @map("prescription_id") @db.Uuid
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_render_prescription_fk")

  serviceOrderId String?       @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_render_service_order_fk")

  certificateId String?             @map("certificate_id") @db.Uuid
  certificate   MedicalCertificate? @relation(fields: [certificateId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_render_certificate_fk")

  invoiceId String?  @map("invoice_id") @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_render_invoice_fk")

  /// DOC-012. The site the subject belongs to, copied so the scope filter does
  /// not have to join four tables to answer «is this one of mine?».
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_render_site_fk")

  /// The file itself.
  content  Bytes
  byteSize Int    @map("byte_size")
  /// DOC-002. Lowercase hex, 64 characters
  /// (`document_render_sha256_format`). SC-061 is measured over this column.
  sha256   String @db.Char(64)
  mimeType String @default("application/pdf") @map("mime_type") @db.VarChar(64)

  /// DOC-020. `PDF/A-1b`. Stored rather than assumed: the day a second profile
  /// exists, the archived rows still say which one they are.
  pdfProfile String @default("PDF/A-1b") @map("pdf_profile") @db.VarChar(16)

  issuedAt   DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById String   @map("issued_by_id") @db.Uuid
  issuedBy   User     @relation("DocumentRenderIssuer", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_render_issued_by_fk")

  /// DOC-007 to DOC-010. The artefact this one annuls, and why. UNIQUE both
  /// ways: an artefact annuls at most one and is annulled by at most one, or
  /// «which is the current document?» has two answers.
  supersedesId    String?         @unique(map: "document_render_supersedes_unique") @map("supersedes_id") @db.Uuid
  supersedes      DocumentRender? @relation("DocumentSupersession", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_render_supersedes_fk")
  supersededBy    DocumentRender? @relation("DocumentSupersession")
  supersedeReason String?         @map("supersede_reason") @db.VarChar(500)

  @@index([prescriptionId], map: "document_render_by_prescription")
  @@index([invoiceId], map: "document_render_by_invoice")
  @@index([siteId, issuedAt(sort: Desc)], map: "document_render_by_site")
  @@map("document_render")
}

// ===========================================================================
// PRIVACY (LOPDP) — module `privacy`, PD-001..PD-043
//
// The relation to `patient` IS declared: PA-055 reads a person's history
// through `chartScope`, which filters on it. The foreign keys to `app_user`
// exist in SQL (`20261001034254_privacy_consent_and_requests`) and are NOT
// declared as relations: that would add back-relation fields to `User`, a
// model owned by `auth`, for queries nobody makes from that side. All three
// tables are append-only by trigger.
// ===========================================================================

enum ConsentMedium {
  SIGNED_PAPER
  ON_SCREEN

  @@map("consent_medium")
}

/// Who acts: the data subject or their legal representative.
enum DataSubjectParty {
  HOLDER
  REPRESENTATIVE

  @@map("data_subject_party")
}

/// LOPDP arts. 13 to 17 and 19.
enum DataSubjectRight {
  ACCESS
  RECTIFICATION
  ERASURE
  OBJECTION
  PORTABILITY
  SUSPENSION

  @@map("data_subject_right")
}

enum DataRequestOutcome {
  GRANTED
  PARTIALLY_GRANTED
  DENIED

  @@map("data_request_outcome")
}

/// PD-001..PD-006. A published consent text. Consecutive version numbers
/// (trigger `consent_text_version_is_next`), never rewritten. The current one
/// is the highest version.
model ConsentTextVersion {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  version     Int      @unique(map: "consent_text_version_number_unique")
  body        String   @db.Text
  /// DEFAULT statement_timestamp() in SQL (PD-012); `now()` here only tells
  /// Prisma there is a default.
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedBy String   @map("published_by") @db.Uuid

  consents PatientConsent[]

  @@map("consent_text_version")
}

/// PD-010..PD-017. A patient's consent, bound to the exact text version shown.
model PatientConsent {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  patientId     String             @map("patient_id") @db.Uuid
  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  textVersionId String             @map("text_version_id") @db.Uuid
  textVersion   ConsentTextVersion @relation(fields: [textVersionId], references: [id], onDelete: Restrict)
  medium        ConsentMedium
  grantedBy     DataSubjectParty   @map("granted_by")
  recordedAt    DateTime           @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedBy    String             @map("recorded_by") @db.Uuid

  @@index([patientId, recordedAt(sort: Desc)], map: "patient_consent_by_patient")
  @@map("patient_consent")
}

/// PD-030..PD-038. A right exercised by the data subject. The only update the
/// base admits is the answer, whole and once.
model DataSubjectRequest {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  patientId    String              @map("patient_id") @db.Uuid
  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  right        DataSubjectRight
  requestedBy  DataSubjectParty    @map("requested_by")
  description  String              @db.Text
  receivedAt   DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  /// PD-032. Clinical date, fixed on registration, never recomputed.
  dueOn        DateTime            @map("due_on") @db.Date
  registeredAt DateTime            @default(now()) @map("registered_at") @db.Timestamptz(6)
  registeredBy String              @map("registered_by") @db.Uuid
  outcome      DataRequestOutcome?
  response     String?             @db.Text
  answeredAt   DateTime?           @map("answered_at") @db.Timestamptz(6)
  answeredBy   String?             @map("answered_by") @db.Uuid

  @@index([patientId, receivedAt(sort: Desc)], map: "data_subject_request_by_patient")
  @@map("data_subject_request")
}
