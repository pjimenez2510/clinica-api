// Database schema.
//
// Project-wide conventions:
//   - snake_case table and column names (@map / @@map), PascalCase models.
//   - Every timestamp is `timestamptz` (@db.Timestamptz), never `timestamp`.
//   - Money is `Decimal(12,2)`, never Float.
//   - `relationJoins` enabled: without it Prisma splits every relation into
//     several queries and merges them in the application — the classic N+1.
//
// Domain nouns with no English equivalent keep their Spanish name (`cedula`,
// `ruc`, `acess`), the same way nobody translates IBAN.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

// Prisma 7 removed `url` from the datasource. The migration connection now
// lives in `prisma.config.ts`, and the runtime client receives a driver
// adapter (@prisma/adapter-pg) built by the application.
// Real benefit: the connection pool is yours to control, not Prisma's.
datasource db {
  provider = "postgresql"
}

/// System user (clinical and administrative staff).
///
/// NOT the patient: a patient is a separate clinical entity. Merging them
/// forces you later to split two concepts with completely different lifecycles
/// and permissions.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Login identifier. Stored lowercase so signing in does not depend on how
  /// the user typed it.
  email String @unique @db.VarChar(255)

  /// Argon2id. The algorithm and its parameters travel inside the hash itself,
  /// so they can be hardened later without migrating existing rows.
  passwordHash String @map("password_hash") @db.VarChar(255)

  firstName String @map("first_name") @db.VarChar(120)
  lastName  String @map("last_name") @db.VarChar(120)

  /// Practitioner's cedula. Required by RDACAA reporting and for signing.
  ///
  /// `app_user_cedula_valid` (manual migration) refuses anything that is not a
  /// real cedula: ten digits, an existing province, third digit below 6 and a
  /// matching check digit. NULL stays legitimate and is the majority case —
  /// reception and billing staff have an account and no clinical profile.
  cedula String? @unique @db.VarChar(10)

  /// ACESS registration of the health professional. Without it they cannot
  /// sign prescriptions or medical certificates.
  acessRegistration String?   @map("acess_registration") @db.VarChar(32)
  acessExpiresOn    DateTime? @map("acess_expires_on") @db.Date

  active Boolean @default(true)

  // --- Second factor ---
  /// TOTP secret encrypted with AES-256-GCM. Never stored in clear text.
  mfaSecretEncrypted String?   @map("mfa_secret_encrypted") @db.Text
  mfaEnabledAt       DateTime? @map("mfa_enabled_at") @db.Timestamptz(6)

  /// AU-037. Secret of a second-factor change that has been STARTED and not
  /// yet confirmed, encrypted the same way.
  ///
  /// A COLUMN OF ITS OWN, and that is the requirement rather than a
  /// convenience: the factor in `mfa_secret_encrypted` has to keep working
  /// until the new one is confirmed. Reusing that column would mean a person
  /// who closes the tab halfway — or whose scan fails — is left with no second
  /// factor at all and no way to enrol another one. It is cleared in the same
  /// statement that installs the new secret, and that claim is what arbitrates
  /// two simultaneous changes.
  mfaPendingSecretEncrypted String? @map("mfa_pending_secret_encrypted") @db.Text

  /// Last consumed TOTP time step. Stops an intercepted code from being reused
  /// during the 30 seconds it remains valid.
  mfaLastStep BigInt? @map("mfa_last_step")

  // --- Brute force defence ---
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  backupCodes   BackupCode[]
  roleGrants    UserRoleGrant[] @relation("GrantHolder")
  grantsIssued  UserRoleGrant[] @relation("GrantIssuer")

  /// AU-021: the single-use links that let this person set their first
  /// password, and the ones they sent to somebody else.
  credentialInvitations     CredentialInvitation[] @relation("InvitationHolder")
  credentialInvitationsSent CredentialInvitation[] @relation("InvitationIssuer")

  /// Clinical profile. Optional: receptionists and billing staff have an
  /// account but no clinical role.
  practitioner Practitioner?

  /// AG-035, D-005: the overbookings this person AUTHORISED. Not the ones they
  /// booked — `agenda_entry.created_by_id` carries no relation, and keeping
  /// the two apart is the control itself (AG-103).
  overbookingsAuthorised AgendaEntry[] @relation("OverbookingAuthoriser")

  /// PA-039: the priority group records this person wrote, and the ones they
  /// closed. Two relations because they are two acts by two people at two
  /// moments, and «¿quién lo cerró?» is a question the closing has to answer
  /// as much as the recording does.
  priorityGroupsRecorded PatientPriorityGroup[] @relation("PriorityGroupRecorder")
  priorityGroupsClosed   PatientPriorityGroup[] @relation("PriorityGroupCloser")
  patientCorrections     PatientChangeHistory[] @relation("PatientChangeAuthor")

  /// PA-044. Merges and undos this person performed. `performed_by` is NOT
  /// NULL and carries a foreign key: merging joins two people's clinical
  /// records, and a trail nobody answers for is not a weaker trail, it is a
  /// useless one.
  patientMerges PatientMerge[] @relation("PatientMergeAuthor")

  /// AG-064. The waiting-list calls this person made. `RESTRICT` on the way
  /// back: the trail names whoever called, and an account is deactivated, never
  /// deleted (AU-024).
  waitlistContacts WaitlistContactAttempt[] @relation("WaitlistContactRecorder")

  @@index([email])
  @@map("app_user")
}

/// A permission the code actually checks.
///
/// The CATALOGUE is anchored to the code — a permission only means something
/// if some route asks for it, so you cannot invent one here and expect it to
/// protect anything. It is mirrored into this table so that role assignments
/// have referential integrity and so the admin interface can list what exists
/// without importing TypeScript. A test asserts the table and the code agree.
model Permission {
  code String @id @db.VarChar(64)

  /// Grouping for the administration screen: patient, agenda, record, billing.
  resource String @db.VarChar(32)
  /// What it allows, in Spanish, for whoever assigns it.
  description String @db.VarChar(255)

  roles RolePermission[]

  @@index([resource])
  @@map("permission")
}

/// A role, as DATA.
///
/// Deliberately not an enum. A clinic hires an external auditor, splits
/// nursing into ward and outpatient, or brings in a health-insurance
/// liaison — none of which should require a migration and a deploy.
model Role {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Stable identifier used in seeds and logs. Uppercase, no spaces.
  code String @unique @db.VarChar(48)
  name String @db.VarChar(120)
  description String? @db.Text

  /// Ships with the product. Its permissions remain editable, but it cannot be
  /// deleted: an empty role table would lock everyone out, including whoever
  /// would fix it.
  isSystem Boolean @default(false) @map("is_system")
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  grants      UserRoleGrant[]

  @@map("role")
}

/// Which permissions a role carries. Editable by an administrator.
model RolePermission {
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionCode String     @map("permission_code") @db.VarChar(64)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedById String?  @map("granted_by_id") @db.Uuid

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

/// A role held by a user, scoped to one site or granted globally.
///
/// Permissions are NOT stored: they are derived from the role in code. A
/// permission only means something if some route checks it, and an editable
/// permission table produces rows that protect nothing. Roles are data — a
/// clinic adds an external auditor without a deploy — but the permission
/// catalogue is part of the code's contract.
model UserRoleGrant {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  /// Restrict, not Cascade: a grant is revoked, never deleted, so a cascade
  /// here could only ever fail — and it would fail with a message about role
  /// grants when the caller was trying to delete a user. Staff accounts are
  /// deactivated, not removed.
  user   User   @relation("GrantHolder", fields: [userId], references: [id], onDelete: Restrict)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// NULL means every site. A receptionist is hired at one site; the clinic
  /// director is not.
  siteId String? @map("site_id") @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// Who granted it. Nullable only for the seed, which has no author.
  grantedById String? @map("granted_by_id") @db.Uuid
  grantedBy   User?   @relation("GrantIssuer", fields: [grantedById], references: [id], onDelete: Restrict)

  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// Revoked, never deleted: who could do what and when is part of the audit
  /// trail, and a deleted row cannot answer that.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@index([roleId])
  @@map("user_role_grant")
}

/// Refresh token with rotation and reuse detection.
///
/// Tokens from the same sign-in form a FAMILY. If an already-used one arrives,
/// somebody holds a copy: the whole family is revoked. That turns a stolen
/// token into an alarm instead of a silent breach.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Groups every token derived from the same sign-in.
  familyId String @map("family_id") @db.Uuid

  /// SHA-256 of the token, never the token itself. If the database is stolen,
  /// active sessions are not.
  tokenHash String @unique @map("token_hash") @db.Char(64)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// Why it was revoked: ROTATION (normal use), REUSE (attack detected),
  /// SIGN_OUT, or PASSWORD_CHANGE.
  revocationReason String? @map("revocation_reason") @db.VarChar(32)

  ip        String? @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_token")
}

/// Single-use recovery codes.
///
/// Without these, a doctor who loses their phone is locked out of the medical
/// records. In an emergency that is not a usability problem, it is a patient
/// safety problem.
model BackupCode {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hashed with Argon2id like a password: it is a credential.
  codeHash String @map("code_hash") @db.VarChar(255)

  usedAt DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, usedAt])
  @@map("backup_code")
}

/// The first credential of an account, as a single-use link (AU-021, D-013).
///
/// AU-021 forbids the administrator choosing somebody else's password. D-013
/// settled how the first one reaches them instead: the system mails a link to
/// the institutional address and the person sets their own, so nobody else
/// ever knows it.
///
/// Like `RefreshToken`, only the SHA-256 of the token is stored — a stolen
/// dump contains no usable credential — and the token itself exists for the
/// length of one HTTP response.
///
/// NOT IN THIS FILE, and it cannot be: `credential_invitation_one_live_per_user`
/// is a PARTIAL unique index (`WHERE used_at IS NULL`) which `schema.prisma`
/// has no way to express. It is what makes a re-send invalidate the previous
/// link instead of adding a second one (AU-027), and it is on the protected
/// list of `scripts/check-migrations.mts` so nothing proposes dropping it.
model CredentialInvitation {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  /// Cascade, like `RefreshToken`: this is a credential artefact, not clinical
  /// evidence. An invitation outliving its account would be a live way to set
  /// the password of an account that no longer exists.
  user   User   @relation("InvitationHolder", fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, never the token. 64 hex characters, always.
  tokenHash String @unique @map("token_hash") @db.Char(64)

  /// 72 hours after issue. The number lives in one constant in the code,
  /// `CREDENTIAL_INVITATION_TTL_HOURS`, not in a database default: two
  /// definitions of one deadline is one that gets forgotten.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// NULL means live. It stops being live for two reasons and deliberately
  /// answers the same to both: the person redeemed it (AU-021), or somebody
  /// re-sent the invitation and this one was superseded (AU-027).
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Who invited them. NULL only for a seed, which has no author.
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("InvitationIssuer", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("credential_invitation")
}

/// Access log for personal and health data.
///
/// Required by Ecuador's LOPDP: you must be able to answer who read which
/// medical record, when, and from where. It is the primary evidence before the
/// data protection authority.
///
/// Append-only by design. Immutability is NOT enforced here but with a
/// PostgreSQL trigger in a separate migration: a convention that only lives in
/// application code is not auditable.
model AccessAudit {
  id BigInt @id @default(autoincrement())

  /// When the access happened. Always timestamptz.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// Who. Internal user identifier, NEVER their cedula.
  userId String? @map("user_id") @db.Uuid

  /// What was touched: resource type and its internal identifier.
  resourceType String @map("resource_type") @db.VarChar(64)
  resourceId   String @map("resource_id") @db.VarChar(64)

  /// What was done: READ, CREATE, UPDATE, EXPORT, PRINT...
  action String @db.VarChar(32)

  /// From where. The IP is personal data under LOPDP: it is stored because it
  /// is necessary to investigate improper access, and it is declared in the
  /// processing activities register.
  ip        String? @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)

  /// Correlation with the OpenTelemetry trace: lets you reconstruct the whole
  /// request from a single audit entry.
  traceId String? @map("trace_id") @db.VarChar(32)

  /// Reason stated during an emergency access (break-the-glass).
  /// Mandatory free text in that flow: a dropdown gets filled in on autopilot.
  emergencyReason String? @map("emergency_reason") @db.Text

  /// D-017, AG-097, CF-066. The state of the resource before the mutation and
  /// after it, so the trail says «desde qué valor» and not only who and when.
  ///
  /// ⚠️ WHICH RESOURCE TYPES MAY CARRY THESE IS DECIDED BY A `CHECK` THAT THIS
  /// FILE CANNOT DESCRIBE: `access_audit_payload_only_for_declared_resources`,
  /// in `20260814161031_access_audit_previous_value`. Today the whitelist is
  /// exactly `'configuration'`. Clinical resource types are NOT on it and must
  /// not be added — this table is append-only and never purged, so a chart's
  /// contents landing here could never be removed. Read the migration's header
  /// before touching either column.
  ///
  /// Null on every read, which is almost every row: a NULL lives in the row's
  /// null bitmap and costs no space.
  before Json? @db.JsonB
  after  Json? @db.JsonB

  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("access_audit")
}

// ===========================================================================
// CLINICAL CORE
//
// Rule of thumb: a value set only our code cares about is a Prisma enum; a
// value set the ministry publishes, versions and expects back in a report is a
// row in `catalog_concept`. Ministries change code lists far more often than
// we change state machines.
// ===========================================================================

enum PatientSex {
  MALE
  FEMALE
  /// Deliberately outside the RDACAA export mapping: the ministry form only
  /// accepts H/M. The export layer decides how to collapse these; the record
  /// itself must not lie about what was documented.
  INTERSEX
  UNKNOWN

  @@map("patient_sex")
}

enum IdentifierType {
  CEDULA
  PASSPORT
  REFUGEE_CARD
  FOREIGN_ID
  /// Newborn or unidentified patient. Never globally unique on its own.
  PROVISIONAL

  @@map("identifier_type")
}

enum IdentifierUse {
  OFFICIAL
  OLD
  TEMP

  @@map("identifier_use")
}

enum AgendaEntryKind {
  APPOINTMENT
  BLOCK

  @@map("agenda_entry_kind")
}

enum AgendaStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  FULFILLED
  CANCELLED
  NO_SHOW
  /// Only valid for kind = BLOCK, and a BLOCK only ever holds BOOKED, BLOCKED
  /// or CANCELLED. Enforced by `agenda_entry_kind_status_coherence` in a manual
  /// migration: the other five statuses assert something about a patient, and a
  /// block has none.
  BLOCKED

  @@map("agenda_status")
}

/// How the clinic was asked for the appointment. A closed list because AG-080
/// reports the no-show rate grouped by it: as free text it accepted 'telefono'
/// and 'Phone' as different channels.
enum BookingChannel {
  PHONE
  WALK_IN
  WEB
  REFERRAL

  @@map("booking_channel")
}

enum CareModality {
  MORBIDITY
  PREVENTION

  @@map("care_modality")
}

enum CareSetting {
  INTRAMURAL
  EXTRAMURAL

  @@map("care_setting")
}

enum VisitSequence {
  FIRST_TIME
  SUBSEQUENT

  @@map("visit_sequence")
}

enum DischargeCondition {
  ALIVE
  REFERRED
  DECEASED
  ABANDONED

  @@map("discharge_condition")
}

/// RDACAA: presuntivo vs definitivo.
enum DiagnosisCertainty {
  PRESUMPTIVE
  DEFINITIVE

  @@map("diagnosis_certainty")
}

/// RDACAA: first time vs subsequent, PER DIAGNOSIS — not per encounter. A
/// patient can get a first-time diabetes diagnosis during a subsequent visit
/// for hypertension.
enum DiagnosisOccurrence {
  FIRST_TIME
  SUBSEQUENT

  @@map("diagnosis_occurrence")
}

enum NoteStatus {
  DRAFT
  SIGNED
  SUPERSEDED
  /// Retracted with no replacement. Different from SUPERSEDED, which always
  /// points at the version that took over.
  ENTERED_IN_ERROR

  @@map("note_status")
}

enum ViolenceScreeningResult {
  NOT_APPLIED
  NO_SIGNS
  SUSPECTED
  CONFIRMED

  @@map("violence_screening_result")
}

enum ViolenceType {
  PHYSICAL
  PSYCHOLOGICAL
  SEXUAL
  NEGLECT
  ECONOMIC

  @@map("violence_type")
}

enum PrescriptionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("prescription_status")
}

enum ServiceOrderCategory {
  LABORATORY
  IMAGING
  PROCEDURE

  @@map("service_order_category")
}

enum ServiceOrderPriority {
  ROUTINE
  URGENT
  STAT

  @@map("service_order_priority")
}

enum ServiceOrderItemStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("service_order_item_status")
}

enum DiagnosticReportStatus {
  PARTIAL
  FINAL
  CORRECTED
  CANCELLED

  @@map("diagnostic_report_status")
}

enum AbnormalFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH

  @@map("abnormal_flag")
}

enum CertificateType {
  ATTENDANCE
  MEDICAL_REST
  FITNESS
  DISABILITY_SUPPORT

  @@map("certificate_type")
}

enum ReferralDirection {
  REFERRAL
  DERIVATION
  COUNTER_REFERRAL

  @@map("referral_direction")
}

enum ReferralStatus {
  ISSUED
  ACCEPTED
  REJECTED
  COMPLETED
  EXPIRED

  @@map("referral_status")
}

enum InterconsultationStatus {
  REQUESTED
  ANSWERED
  CANCELLED

  @@map("interconsultation_status")
}

enum WaitlistStatus {
  WAITING
  CONTACTED
  SCHEDULED
  EXPIRED
  CANCELLED

  @@map("waitlist_status")
}

/// AG-064. What happened on a contact attempt.
///
/// THREE VALUES BECAUSE THREE THINGS HAPPEN TO THE SLOT, not for the sake of
/// detail: nobody answering expires the entry (AG-066), a refusal closes it by
/// the patient's own decision, and an acceptance is the only confirmation that
/// authorises converting the entry into an appointment — which is the half of
/// AG-064 that says the slot is not reassigned without one.
enum WaitlistContactOutcome {
  NO_ANSWER
  ACCEPTED
  DECLINED

  @@map("waitlist_contact_outcome")
}

enum AllergyCriticality {
  LOW
  HIGH
  UNABLE_TO_ASSESS

  @@map("allergy_criticality")
}

// ---------------------------------------------------------------------------
// CATALOGS
// ---------------------------------------------------------------------------

/// A code system: CIE-10, CNMB, INEC DPA, ethnicity, priority groups, tariff.
///
/// One generic machine instead of one table per catalogue. All of them need
/// validity periods, the official release that introduced each code, and
/// accent-insensitive search, and none needs typed columns badly enough to
/// justify duplicating that machinery five times.
model CatalogSystem {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// CIE10, CNMB, DPA, TARIFF, ETHNICITY, NATIONALITY, PRIORITY_GROUP,
  /// SERVICE_TYPE, SPECIALTY, GENDER_IDENTITY.
  code String @unique @db.VarChar(32)
  name String @db.VarChar(160)

  /// FHIR CodeSystem.url, so the translation layer never hardcodes a URI.
  canonicalUri String? @map("canonical_uri") @db.VarChar(255)

  /// Whether concepts form a tree (DPA and CIE-10 do; ethnicity does not).
  hierarchical Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  releases CatalogRelease[]
  concepts CatalogConcept[]

  @@map("catalog_system")
}

/// An official publication of a catalogue. Provenance, not versioning:
/// versioning lives on each concept's validity period.
model CatalogRelease {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  systemId String        @map("system_id") @db.Uuid
  system   CatalogSystem @relation(fields: [systemId], references: [id], onDelete: Restrict)

  version       String    @db.VarChar(64)
  publishedOn   DateTime? @map("published_on") @db.Date
  effectiveFrom DateTime  @map("effective_from") @db.Date
  sourceUrl     String?   @map("source_url") @db.VarChar(512)

  /// Checksum of the imported file. Proves which artefact produced the rows,
  /// which matters when the ministry silently republishes a spreadsheet under
  /// the same version number.
  sourceChecksum String? @map("source_checksum") @db.Char(64)

  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  introducedConcepts CatalogConcept[] @relation("ConceptIntroducedBy")
  retiredConcepts    CatalogConcept[] @relation("ConceptRetiredBy")

  @@unique([systemId, version])
  @@map("catalog_release")
}

/// One version of one code.
///
/// The surrogate `id` is the whole point: clinical rows reference THIS ROW, not
/// the code string, so "resolve a 2024 diagnosis against the 2024 catalogue"
/// stops being a query everyone forgets to write and becomes a foreign key.
///
/// It is also forced: PostgreSQL 18 only lets a temporal PRIMARY KEY be
/// referenced by a temporal FOREIGN KEY (PERIOD), and those support NO ACTION
/// only. Without the surrogate key there could be no foreign key at all.
model CatalogConcept {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  systemId String        @map("system_id") @db.Uuid
  system   CatalogSystem @relation(fields: [systemId], references: [id], onDelete: Restrict)

  /// Not unique on its own: unique per non-overlapping validity period, via
  /// `UNIQUE (system_id, code, valid_period WITHOUT OVERLAPS)` in a manual
  /// migration. Prisma cannot express that.
  code    String @db.VarChar(32)
  display String @db.VarChar(512)

  /// Self-reference for DPA and CIE-10 chapters. DPA codes are hierarchical by
  /// prefix (province = left(code,2), canton = left(code,4)), so no
  /// denormalised province/canton columns are needed anywhere.
  parentId String?          @map("parent_id") @db.Uuid
  parent   CatalogConcept?  @relation("ConceptTree", fields: [parentId], references: [id], onDelete: Restrict)
  children CatalogConcept[] @relation("ConceptTree")

  validFrom DateTime  @map("valid_from") @db.Date
  /// NULL means still in force.
  validTo   DateTime? @map("valid_to") @db.Date

  /// Turned into `GENERATED ALWAYS AS daterange(...) STORED` by a manual
  /// migration. STORED and not VIRTUAL because PostgreSQL 18 cannot index or
  /// constrain virtual columns. Declared here so Prisma never drops it.
  validPeriod Unsupported("daterange")?

  /// Catalogue-specific payload: ATC code for CNMB, chapter for CIE-10,
  /// amount for TARIFF.
  attributes Json? @db.JsonB

  introducedByReleaseId String?         @map("introduced_by_release_id") @db.Uuid
  introducedByRelease   CatalogRelease? @relation("ConceptIntroducedBy", fields: [introducedByReleaseId], references: [id], onDelete: Restrict)

  retiredByReleaseId String?         @map("retired_by_release_id") @db.Uuid
  retiredByRelease   CatalogRelease? @relation("ConceptRetiredBy", fields: [retiredByReleaseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  patientsEthnicity       Patient[]                  @relation("PatientEthnicity")
  patientsNationality     Patient[]                  @relation("PatientNationality")
  patientsResidence       Patient[]                  @relation("PatientResidenceParish")
  patientsGenderIdentity  Patient[]                  @relation("PatientGenderIdentity")
  patientsPeople          Patient[]                  @relation("PatientPeople")
  patientsOrientation     Patient[]                  @relation("PatientSexualOrientation")
  sites                   Site[]                     @relation("SiteParish")
  scheduleRules           PractitionerScheduleRule[]
  /// NO HAY `agendaEntries` AQUÍ desde C4, y la ausencia es el arreglo: la
  /// cita registra su tipo de atención en `service_type` —el catálogo propio
  /// de la clínica, SP-020— y no en un concepto clínico del MSP.
  waitlistEntries         WaitlistEntry[]            @relation("WaitlistServiceType")
  encounterPriorityGroups EncounterPriorityGroup[]
  diagnoses               EncounterDiagnosis[]
  procedures              EncounterProcedure[]
  prescriptionItems       PrescriptionItem[]
  serviceOrderItems       ServiceOrderItem[]
  observationResults      ObservationResult[]        @relation("ObservationAnalyte")
  allergies               PatientAllergy[]
  referrals               Referral[]                 @relation("ReferralSpecialty")
  interconsultations      Interconsultation[]        @relation("InterconsultationSpecialty")

  @@index([systemId, code])
  @@index([parentId])
  @@map("catalog_concept")
}

// ---------------------------------------------------------------------------
// ORGANISATION
// ---------------------------------------------------------------------------

/// The health establishment as the MSP knows it (OR-001): typology, unique
/// code and RUC. Owns one or more sites.
///
/// SEPARATE FROM `Site` since ADR-011. `Site` conflated the two because the
/// clinic starts with a single establishment, and the code the RDACAA demands
/// per attention (REQ-020) belongs to the establishment, not to the building.
/// Splitting them while there is one row costs a migration; with two years of
/// history it would not be possible.
model Establishment {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Unique establishment code issued by the MSP (OR-002).
  mspUnicode String @unique @map("msp_unicode") @db.VarChar(20)

  /// MSP typology of A.M. 00000079: what determines the reporting duties.
  typology  String  @db.VarChar(64)
  legalName String  @map("legal_name") @db.VarChar(160)
  /// Shape guaranteed by `establishment_ruc_format`; the SRI check digit by
  /// the `Ruc` value object (OR-008).
  ruc       String? @db.VarChar(13)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sites Site[]

  @@map("establishment")
}

/// A physical site of the clinic. Not a tenant: the whole database belongs to
/// one clinic. It exists because RDACAA is reported per establishment code.
model Site {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Unique establishment code issued by the MSP. The single most important
  /// field for RDACAA reporting.
  mspUnicode String @unique @map("msp_unicode") @db.VarChar(20)

  /// NULLABLE only so the rows that predate `establishment` survived the
  /// migration; `seed-organization.mts` backfills them (OR-004).
  establishmentId String?        @map("establishment_id") @db.Uuid
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  name String  @db.VarChar(160)
  ruc  String? @db.VarChar(13)

  parishConceptId String?         @map("parish_concept_id") @db.Uuid
  parish          CatalogConcept? @relation("SiteParish", fields: [parishConceptId], references: [id], onDelete: Restrict)

  addressLine String? @map("address_line") @db.VarChar(255)
  phone       String? @db.VarChar(32)
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rooms           SiteRoom[]
  emissionPoints  EmissionPoint[]
  holidays        Holiday[]
  parameters      SiteParameter?
  workedHolidays  HolidaySiteException[]
  roleGrants      UserRoleGrant[]
  practitioners   PractitionerSite[]
  scheduleRules   PractitionerScheduleRule[]
  agendaEntries   AgendaEntry[]
  encounters      Encounter[]
  waitlistEntries WaitlistEntry[]
  serviceOrders   ServiceOrder[]

  @@map("site")
}

/// Consulting room (FHIR Location). It exists so two practitioners cannot be
/// assigned the same room at the same time — a second exclusion constraint.
model SiteRoom {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  name   String  @db.VarChar(80)
  active Boolean @default(true)

  agendaEntries AgendaEntry[]

  @@unique([siteId, name])
  /// Redundant as uniqueness — `id` is already the key — and REQUIRED as the
  /// TARGET of `agenda_entry_room_in_site`, the composite foreign key that
  /// moves OR-021 (AG-105) out of TypeScript and into the base. That foreign
  /// key itself CANNOT be expressed here: `siteId` already backs the `site`
  /// relation on `AgendaEntry`, and Prisma would read a second relation over
  /// the same scalar as a conflict. It lives in the migration, like the
  /// EXCLUDE constraints and the generated columns.
  @@unique([id, siteId], map: "site_room_id_site_unique")
  @@map("site_room")
}

/// SRI point of emission (OR-023). Stored here as DATA only: the sequential
/// numbering, the signature and the dialogue with the SRI belong to `billing`
/// (REQ-085, OR-025).
model EmissionPoint {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// Exactly three digits, leading zero significant: «001» is not 1.
  code        String  @db.Char(3)
  description String? @db.VarChar(120)
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([siteId, code], map: "emission_point_code_unique_per_site")
  @@map("emission_point")
}

/// A non-working day, for one site or for all of them (CF-060).
///
/// `date` and not a timestamp: a holiday is a day of the civil calendar, not
/// an instant. Storing it as an instant would force picking an hour and then
/// resolving it back in `America/Guayaquil` to know which day it was.
///
/// The uniqueness of CF-061 CANNOT be expressed here: it is
/// `UNIQUE NULLS NOT DISTINCT (date, site_id)`, which Prisma has no syntax
/// for, and a plain `@@unique` would leave the "all sites" rows unconstrained
/// — precisely the row that does the most damage, since every site obeys it.
/// It lives in the migration, like the EXCLUDE constraints.
model Holiday {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  date DateTime @db.Date
  name String   @db.VarChar(160)

  /// NULL means EVERY site. That is the «alcance» of CF-060.
  ///
  /// Cascade, against this schema's general RESTRICT rule and deliberately: a
  /// holiday of a site is not clinical evidence, nothing references it, and it
  /// has no meaning apart from its site. See the migration's header.
  siteId String? @map("site_id") @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// AG-092. The sites that work this holiday anyway.
  workedBy HolidaySiteException[]

  @@index([date], map: "holiday_by_date")
  @@map("holiday")
}

/// AG-092. The site WORKS that holiday: A&E opens on 25 December without the
/// holiday ceasing to apply to every other site.
///
/// A row and not a flag on `holiday`, because «working for whom» is N sites per
/// holiday. The meaning is uniform for both scopes: on a local holiday it
/// reads the same and amounts to deleting it, which is why nothing restricts
/// this to national ones. See the migration's header.
model HolidaySiteException {
  holidayId String  @map("holiday_id") @db.Uuid
  holiday   Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([holidayId, siteId])
  @@index([siteId], map: "holiday_site_exception_by_site")
  @@map("holiday_site_exception")
}

/// What is done with cancelled appointments once they are old (D-001, D-004).
///
/// ONE value today, on purpose. D-004 settled that the system never deletes
/// clinical history and D-001 chose «no borrar» for cancelled appointments, so
/// `NEVER` is the only policy that exists. It is an enum rather than a boolean
/// so that a future `PURGE_AFTER_DAYS` is `ALTER TYPE … ADD VALUE` plus a
/// column instead of rewriting the column and every row.
enum CancelledRetentionPolicy {
  NEVER

  @@map("cancelled_retention_policy")
}

/// The operating numbers of one site (CF-062, D-001).
///
/// One row per site, written by the database itself when the site is created
/// (`trg_site_parameter_defaults`): `organization` owns the site and must not
/// know this module's tables (ADR-011), and a site inserted by a data import
/// has to end up just as parametrised as one created from the screen.
///
/// The ranges of CF-065 are CHECK constraints in the migration; Prisma cannot
/// express them, and they are what makes the guarantee survive a `psql`.
model SiteParameter {
  /// The primary key IS the site: one row per site, never two.
  siteId String @id @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// Minutes that must pass between now and the appointment (D-001: 0).
  minLeadMinutes Int @default(0) @map("min_lead_minutes")
  /// How far ahead the agenda may be booked (D-001: 180 days).
  maxLeadDays    Int @default(180) @map("max_lead_days")
  /// Deliberate overbookings allowed per practitioner and day (D-001: 2).
  overbookingCap Int @default(2) @map("overbooking_cap")

  /// D-021. The atom of the agenda: the increment this site dices its day
  /// into, and the number every configurable duration must be a multiple of
  /// (D-021: 10 minutes).
  slotAtomMinutes Int @default(10) @map("slot_atom_minutes")

  /// AG-031. The site accepts appointments that start in the past (recording
  /// after the fact). `false` by default on purpose — see the migration.
  allowPastBooking Boolean @default(false) @map("allow_past_booking")

  /// AG-039, AG-094. The site admits overbookings. `true` by default, which is
  /// the OPPOSITE choice to `allowPastBooking` and deliberate: the overbooking
  /// is the documented way of breaking the grid (D-005), and what keeps it
  /// from becoming the normal route is `overbookingCap`, not a switch nobody
  /// turned on.
  overbookingEnabled Boolean @default(true) @map("overbooking_enabled")

  /// AG-101, AG-094. Which permission authorises an overbooking here.
  ///
  /// A PERMISSION CODE STORED AS DATA, and the only one in this schema. What
  /// keeps it from being any string: the application refuses a code the
  /// CATALOGUE does not declare (`UNKNOWN_PERMISSION`) and one this
  /// installation has not seeded (`PERMISSION_NOT_INSTALLED`), and
  /// `trg_site_parameter_overbooking_permission` refuses a CHANGE to a code
  /// that is not in `permission` — a trigger and not a foreign key, because a
  /// key would also be checked on the INSERT that `trg_site_parameter_defaults`
  /// performs for every new site, tying site creation to the permission mirror
  /// being seeded. See the migration.
  overbookingPermission String @default("agenda:overbook") @map("overbooking_permission") @db.VarChar(64)

  /// AG-066, AG-094. How many contact attempts exhaust a waiting-list entry
  /// here. The last of the eight parameters AG-094 enumerates and the only one
  /// that never had a column, because E5 had not been opened.
  ///
  /// THE NUMBER IS THE USER'S DECISION and is pending in
  /// `DECISIONES-PENDIENTES.md`: D-001 fixed the starting values of the others
  /// and did not include this one. It ships as 3 so that every site HAS a
  /// value, and being per-site and editable without a deploy (REQ-145) is what
  /// makes a wrong default cost a screen instead of a migration.
  waitlistMaxContactAttempts Int @default(3) @map("waitlist_max_contact_attempts")

  cancelledRetention CancelledRetentionPolicy @default(NEVER) @map("cancelled_retention")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_parameter")
}

/// Clinical profile of a system user.
///
/// Separate from `app_user` because they are different things with different
/// lifecycles: `app_user` is an account (credentials, MFA, lockout);
/// `Practitioner` is a clinical role. Receptionists have the first, not both.
model Practitioner {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Professional code assigned by the MSP, required per attention by RDACAA.
  /// Cedula and ACESS registration already live on `app_user`, not duplicated.
  mspCode String? @map("msp_code") @db.VarChar(32)

  /// Whether this practitioner takes appointments. A pathologist has a clinical
  /// profile but no agenda.
  schedulable Boolean @default(true)
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sites              PractitionerSite[]
  scheduleRules      PractitionerScheduleRule[]
  agendaEntries      AgendaEntry[]
  encounters         Encounter[]
  authoredNotes      ClinicalNote[]            @relation("NoteAuthor")
  signedNotes        ClinicalNote[]            @relation("NoteSigner")
  prescriptions      Prescription[]
  serviceOrders      ServiceOrder[]
  diagnosticReports  DiagnosticReport[]
  certificates       MedicalCertificate[]
  referralsIssued    Referral[]                @relation("ReferralIssuer")
  interconsultAsked  Interconsultation[]       @relation("InterconsultRequester")
  interconsultAnswer Interconsultation[]       @relation("InterconsultResponder")
  waitlistEntries    WaitlistEntry[]
  specialties        PractitionerSpecialty[]
  durationExceptions DurationException[]

  @@map("practitioner")
}

/// The clinic's specialty catalogue (D-008): MSP-preloaded, editable, never
/// deleted while referenced — deactivated instead (SP-003, SP-004).
model Specialty {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Stable English code: the contract for RDACAA and billing. Uniqueness is
  /// case-insensitive via a functional index in the manual migration; same
  /// for `name`, accent-insensitive (SP-006). Prisma cannot express either.
  code String @db.VarChar(64)
  name String @db.VarChar(160)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  practitioners PractitionerSpecialty[]
  serviceTypes  ServiceType[]

  @@map("specialty")
}

/// A practitioner holds one or more specialties, exactly one primary — the
/// "at most one" lives in a partial unique index (SP-005); the "at least one"
/// is the service's job when assigning.
model PractitionerSpecialty {
  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  specialtyId String    @map("specialty_id") @db.Uuid
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([practitionerId, specialtyId])
  @@index([specialtyId])
  @@map("practitioner_specialty")
}

/// Attention type within a specialty, with its base duration (SP-020). The
/// 5..240-in-multiples-of-5 range is a CHECK in the manual migration (SP-021).
model ServiceType {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  specialtyId String    @map("specialty_id") @db.Uuid
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  name            String @db.VarChar(120)
  durationMinutes Int    @map("duration_minutes") @db.SmallInt

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  durationExceptions DurationException[]
  /// SP-025. Declared so the `RESTRICT` foreign key is visible from this side
  /// too: a type nobody booked can be deleted, one an appointment names cannot.
  agendaEntries      AgendaEntry[]

  @@map("service_type")
}

/// One practitioner's own duration for one service type (D-007, SP-022): the
/// top of the resolution hierarchy, above the specialty·type base.
model DurationException {
  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  serviceTypeId String      @map("service_type_id") @db.Uuid
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  durationMinutes Int @map("duration_minutes") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([practitionerId, serviceTypeId])
  @@map("duration_exception")
}

/// FHIR PractitionerRole: which sites a practitioner works at.
model PractitionerSite {
  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([practitionerId, siteId])
  @@map("practitioner_site")
}

/// Weekly availability template (FHIR Schedule).
///
/// Slots are NOT stored: they are derived from this rule minus occupied
/// `agenda_entry` rows. Materialising every free slot creates millions of rows
/// whose only job is to be empty.
model PractitionerScheduleRule {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  serviceTypeConceptId String?         @map("service_type_concept_id") @db.Uuid
  serviceType          CatalogConcept? @relation(fields: [serviceTypeConceptId], references: [id], onDelete: Restrict)

  /// ISO-8601: 1 = Monday .. 7 = Sunday.
  weekday Int @db.SmallInt

  /// `time` and not `timestamptz`: this is a wall-clock rule ("Mondays from
  /// 08:00"), not an instant. The only deliberate exception to the timestamptz
  /// convention, and it is not a timestamp at all.
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  /// D-021: no slot length here. The grid is one atom per site
  /// (`SiteParameter.slotAtomMinutes`); the rule says WHEN the practitioner
  /// works, never how the day is diced.
  validFrom DateTime  @map("valid_from") @db.Date
  /// NULL means the rule is still in force (ST-041).
  validTo   DateTime? @map("valid_to") @db.Date

  active Boolean @default(true)

  /// Both are `GENERATED ALWAYS AS … STORED`, written by the manual migration
  /// `20260813031542_staff_schedule_rule_no_overlap`. STORED and not VIRTUAL
  /// because PostgreSQL 18 cannot index or constrain virtual columns, and they
  /// exist only to feed the `schedule_rule_no_overlap` EXCLUDE of ST-042:
  /// `&&` has no operator over `time`, so the span is rangified to minutes
  /// from midnight. Declared here so Prisma never reads them as surplus and
  /// proposes dropping them — same treatment as `CatalogConcept.validPeriod`.
  minutesRange Unsupported("int4range")? @map("minutes_range")
  validity     Unsupported("daterange")?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([practitionerId, weekday])
  @@index([siteId, weekday])
  @@map("practitioner_schedule_rule")
}

// ---------------------------------------------------------------------------
// PATIENT
// ---------------------------------------------------------------------------

model Patient {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Medical record number. THE identity anchor: assigned once, never changed,
  /// never dependent on a document the patient may not have. Every internal FK
  /// points at `id`; humans quote the `mrn`.
  mrn String @unique @db.VarChar(12)

  /// Ecuadorian names carry two surnames. A single `full_name` column makes
  /// sorting and ministry reporting impossible.
  familyName       String  @map("family_name") @db.VarChar(120)
  secondFamilyName String? @map("second_family_name") @db.VarChar(120)
  givenName        String  @map("given_name") @db.VarChar(120)
  secondGivenName  String? @map("second_given_name") @db.VarChar(120)

  sex PatientSex

  genderIdentityConceptId String?         @map("gender_identity_concept_id") @db.Uuid
  genderIdentity          CatalogConcept? @relation("PatientGenderIdentity", fields: [genderIdentityConceptId], references: [id], onDelete: Restrict)

  birthDate DateTime @map("birth_date") @db.Date

  /// Undocumented migrants arrive with an estimated age. Without this flag an
  /// estimate is reported to the ministry as a fact.
  birthDateEstimated Boolean @default(false) @map("birth_date_estimated")

  deceasedAt DateTime? @map("deceased_at") @db.Timestamptz(6)

  /// RDACAA ethnic self-identification. A catalogue and not an enum because
  /// INEC revises the categories, and every historical record must keep the
  /// wording it was recorded with.
  ethnicityConceptId String?         @map("ethnicity_concept_id") @db.Uuid
  ethnicity          CatalogConcept? @relation("PatientEthnicity", fields: [ethnicityConceptId], references: [id], onDelete: Restrict)

  nationalityConceptId String?         @map("nationality_concept_id") @db.Uuid
  nationality          CatalogConcept? @relation("PatientNationality", fields: [nationalityConceptId], references: [id], onDelete: Restrict)

  /// PA-056. RDACAA column 14, «Pueblos». THIRD STEP of a chain whose first two
  /// are above: ethnicity → indigenous nationality → people. The ministry's
  /// instructivo enables it ONLY when the indigenous nationality is «Kichwa»,
  /// and that condition is NOT here and cannot be: it depends on which row of
  /// the `NATIONALITY` catalogue is Kichwa, and a CHECK cannot query another
  /// table. `indigenous-people.ts` is the one place that decides.
  peopleConceptId String?         @map("people_concept_id") @db.Uuid
  people          CatalogConcept? @relation("PatientPeople", fields: [peopleConceptId], references: [id], onDelete: Restrict)

  /// PA-057, PA-058. RDACAA column 7, «Orientación sexual».
  ///
  /// ⚠️ SPECIAL CATEGORY DATA under the LOPDP, like the priority reason. It is
  /// WRITTEN with `patient:write` — it is typed at the desk on the same form as
  /// columns 6, 8 and 11 to 14 — and READ only behind `patient:sexual-
  /// orientation`, a permission no shipped role carries, through a route of its
  /// own that leaves an audit row. It travels neither on the chart nor on the
  /// listing: adding it to either `select` removes that door with nothing
  /// failing.
  ///
  /// The «from 10 years of age» rule of the instructivo is enforced in the
  /// service, not here: the age is DERIVED (PA-030) and a CHECK over it would
  /// expire with the calendar.
  sexualOrientationConceptId String?         @map("sexual_orientation_concept_id") @db.Uuid
  sexualOrientation          CatalogConcept? @relation("PatientSexualOrientation", fields: [sexualOrientationConceptId], references: [id], onDelete: Restrict)

  /// PA-053. Country of nationality, ISO 3166-1 alpha-3. NOT the column above:
  /// `nationality_concept_id` is the RDACAA's nationality or indigenous people
  /// (Kichwa, Shuar, Awa), a field the ministry's form only enables when the
  /// ethnic self-identification is indigenous. This one says the person is
  /// Venezuelan.
  ///
  /// A CODE AND NOT A FOREIGN KEY, exactly like `issuing_country` three tables
  /// down: two representations of the same country in one database eventually
  /// disagree. The `COUNTRY` catalogue is where the screen CHOOSES from and
  /// where the NAME comes from; the code is what is stored. Its shape is held
  /// by `patient_country_of_nationality_format` — an import never sees the DTO.
  countryOfNationalityCode String? @map("country_of_nationality_code") @db.Char(3)

  /// INEC DPA parish (6 digits). Province and canton are prefixes of this code,
  /// so they are derived, never stored twice.
  residenceParishConceptId String?         @map("residence_parish_concept_id") @db.Uuid
  residenceParish          CatalogConcept? @relation("PatientResidenceParish", fields: [residenceParishConceptId], references: [id], onDelete: Restrict)

  residenceAddressLine String? @map("residence_address_line") @db.VarChar(255)
  phone                String? @db.VarChar(32)
  email                String? @db.VarChar(255)
  bloodType            String? @map("blood_type") @db.VarChar(3)

  /// Registered with no definitive document yet (newborn, unidentified).
  isProvisional Boolean @default(false) @map("is_provisional")

  /// Newborns are registered under their mother before they have a document of
  /// their own. Also the fastest way to find the record 20 minutes after birth.
  motherPatientId String?   @map("mother_patient_id") @db.Uuid
  mother          Patient?  @relation("PatientMother", fields: [motherPatientId], references: [id], onDelete: Restrict)
  children        Patient[] @relation("PatientMother")

  /// Duplicate resolution. The losing record is NEVER deleted: printed
  /// documents and external systems still quote its MRN.
  ///
  /// Three guarantees live in SQL and cannot be written here (PA-046):
  /// `patient_merged_into_not_self`, `patient_merged_at_matches_link`, and
  /// `trg_patient_merge_not_chained`, which refuses A→B→C in either direction
  /// and locks the target row so two concurrent merges cannot build a chain
  /// between them. Nor can the PARTIAL index `patient_absorbed_charts`
  /// (`WHERE merged_into_id IS NOT NULL`), which is how the link is walked
  /// backwards.
  mergedIntoId String?   @map("merged_into_id") @db.Uuid
  mergedInto   Patient?  @relation("PatientMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom   Patient[] @relation("PatientMerge")
  mergedAt     DateTime? @map("merged_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  identifiers     PatientIdentifier[]
  priorityGroups  PatientPriorityGroup[]
  changeHistory   PatientChangeHistory[]
  contacts        PatientContact[]
  allergies       PatientAllergy[]
  agendaEntries   AgendaEntry[]
  encounters      Encounter[]
  waitlistEntries WaitlistEntry[]
  certificates    MedicalCertificate[]
  referrals       Referral[]
  mergesAsSource  PatientMerge[]       @relation("MergeSource")
  mergesAsTarget  PatientMerge[]       @relation("MergeTarget")

  @@index([familyName, givenName])
  @@index([birthDate])
  @@map("patient")
}

/// FHIR Patient.identifier[].
///
/// A child table and not columns on `patient`, because identification in
/// Ecuador is genuinely 0..n over time: a refugee arrives with a passport and a
/// refugee card, and later gets a cedula. Flat columns force you to overwrite,
/// which destroys the trail behind documents already issued.
model PatientIdentifier {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  type IdentifierType

  /// ISO 3166-1 alpha-3. Two passports may share a number if issued by
  /// different countries, so the real key is (type, issuing_country, value).
  issuingCountry String @default("ECU") @map("issuing_country") @db.Char(3)

  value String @db.VarChar(32)

  use IdentifierUse @default(OFFICIAL)

  validFrom DateTime? @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  /// Denormalised from `patient.merged_into_id`, maintained by trigger. It
  /// exists only so the uniqueness index can be partial: index predicates
  /// cannot contain subqueries, and a merged record must release its cedula so
  /// the surviving record can keep it.
  patientMerged Boolean @default(false) @map("patient_merged")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([patientId, use])
  @@index([value])
  @@map("patient_identifier")
}

/// How the system learnt the patient belongs to the group (PA-038).
///
/// «Lo dijo el paciente» and «consta en el carné del CONADIS» are not the same
/// thing, and without the distinction nobody can tell which of the two they are
/// looking at when they decide a turn.
enum PriorityGroupOrigin {
  SELF_DECLARED
  ACCREDITED

  @@map("priority_group_origin")
}

/// A dated assessment that the patient belongs to a priority group of article
/// 35 of the Constitution (REQ-024, PA-033..PA-039, D-026, D-027).
///
/// ═══════════════════════════════════════════════════════════════════════════
/// ONE ROW PER ASSESSMENT, NEVER A BOOLEAN COLUMN ON `patient`
/// ═══════════════════════════════════════════════════════════════════════════
///
/// HL7 FHIR models pregnancy as an `Observation` — a dated assessment — and
/// says expressly that it must NOT be captured as a `Condition`. A column
/// `embarazada` is exactly the one that stays switched on for ever. Disability
/// and catastrophic illness ARE `Condition`: persistent states, which is why
/// closing one sets `ends_on` and never deletes the row (PA-037) — otherwise
/// «¿por qué esta persona tuvo prioridad en marzo?» has no answer.
///
/// And a row absorbs with an INSERT the category the ministry adds, where ten
/// booleans need a migration and leave every historical row at `false` where
/// the honest value is «no se valoró».
///
/// ⚠️ AGE IS NOT HERE, and its absence is the design (PA-035). «Adulto mayor»
/// and «niña, niño o adolescente» are derived from `birth_date` on the clinical
/// date; stored, they would be data that expires on a birthday nobody processes.
/// `patient_priority_group_recordable` is what makes that true in the database.
///
/// ⚠️ THE VALIDITY IS RESOLVED WHEN READ. No process marks rows as expired: a
/// pregnancy whose expected date of delivery has passed simply stops counting,
/// with nobody touching the row.
///
/// `date` and not `timestamptz` for the period, deliberately: «hasta el 15 de
/// marzo» is a calendar fact, like `birth_date` and like
/// `catalog_concept.valid_from`. An instant would make the answer depend on the
/// hour it was asked.
model PatientPriorityGroup {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// One of the RECORDABLE codes of `priority-groups.ts`. A `varchar` with a
  /// CHECK and not a native enum: the enumeration of TEN lives in the domain —
  /// every entry drives a branch there — and only EIGHT may be written, so an
  /// enum would have to contain the two derived ones and then permit storing
  /// them. See `patient_priority_group_recordable`.
  groupCode String @map("group_code") @db.VarChar(48)

  startsOn DateTime  @map("starts_on") @db.Date
  /// Expected date of delivery or end date. NULL means still open, which a
  /// pregnancy may never be (`patient_priority_group_pregnancy_has_end`).
  endsOn   DateTime? @map("ends_on") @db.Date

  origin PriorityGroupOrigin

  /// Which document accredits it: carné del CONADIS, certificado médico.
  /// Required when `origin = ACCREDITED`, refused as blank by a CHECK.
  evidenceDocument String? @map("evidence_document") @db.VarChar(160)

  /// PA-039. Who recorded it and when. NOT NULL: a record nobody can be held
  /// to is not a weaker record, it is a useless one.
  recordedById String   @map("recorded_by") @db.Uuid
  recordedBy   User     @relation("PriorityGroupRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  /// Who closed it and when, for the same reason. Both NULL or both set.
  closedById String?   @map("closed_by") @db.Uuid
  closedBy   User?     @relation("PriorityGroupCloser", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)

  @@index([patientId, startsOn])
  @@map("patient_priority_group")
}

/// What was corrected on a chart, from which value, by whom and when
/// (PA-031, D-032).
///
/// ⚠️ THE ONLY TRAIL IN THIS SYSTEM THAT IS DELIBERATELY NOT APPEND-ONLY.
/// `access_audit`, `patient_merge` and the signed-note chain all carry
/// immutability triggers; this one must not. It holds the chart's own
/// contents, and REQ-113 obliges us to be able to correct and erase those.
/// The access trail watches WHO LOOKED and is immutable for that reason —
/// which is exactly why `access_audit_payload_only_for_declared_resources`
/// refuses `'patient'` and why this table exists at all.
///
/// One row PER FIELD, not one per correction with a JSON payload: erasing one
/// datum under REQ-113 then deletes a row instead of editing a document that
/// also holds data which must be kept.
model PatientChangeHistory {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// The DOMAIN field name (`familyName`), not the column. Restricted by
  /// `patient_change_history_field_known`, whose list is the one repeated in
  /// `patient-corrections.ts`. `mrn` is absent on purpose: PA-002 says it
  /// never changes.
  field String @db.VarChar(64)

  /// Both sides as text. NULL means "had no value" / "was cleared", which is a
  /// real change. A CHECK refuses a row where both sides are the same.
  valueBefore String? @map("value_before")
  valueAfter  String? @map("value_after")

  changedById String   @map("changed_by") @db.Uuid
  changedBy   User     @relation("PatientChangeAuthor", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([patientId, changedAt(sort: Desc)])
  @@map("patient_change_history")
}

/// Emergency contact or legal representative (minors, incapacitated adults).
model PatientContact {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  fullName     String  @map("full_name") @db.VarChar(240)
  relationship String  @db.VarChar(80)
  phone        String? @db.VarChar(32)
  cedula       String? @db.VarChar(10)

  /// Legal representative for consent purposes, not merely someone to call.
  isLegalRepresentative Boolean @default(false) @map("is_legal_representative")
  isPrimary             Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientId])
  @@map("patient_contact")
}

/// FHIR AllergyIntolerance. Structured rather than buried in the form-002 JSON
/// because prescribing has to check it, and "check it" means a query, not a
/// human reading prose.
model PatientAllergy {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// CNMB concept when the allergen is a drug; NULL plus free text otherwise
  /// (foods, latex, insect stings).
  substanceConceptId String?         @map("substance_concept_id") @db.Uuid
  substance          CatalogConcept? @relation(fields: [substanceConceptId], references: [id], onDelete: Restrict)

  substanceText String             @map("substance_text") @db.VarChar(240)
  reaction      String?            @db.VarChar(512)
  criticality   AllergyCriticality @default(UNABLE_TO_ASSESS)

  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  /// Refuted allergies are marked, never deleted: knowing an allergy was ruled
  /// out is clinical information in its own right.
  refutedAt    DateTime? @map("refuted_at") @db.Timestamptz(6)
  refutedNotes String?   @map("refuted_notes") @db.Text

  @@index([patientId, refutedAt])
  @@map("patient_allergy")
}

/// What a `patient_merge` row records: the merge, or undoing it.
enum PatientMergeEvent {
  MERGE
  UNDO

  @@map("patient_merge_event")
}

/// Append-only log of EVENTS in duplicate resolution: one row per merge and
/// another per undo, pointing at the merge it undoes (PA-043 a PA-049).
///
/// UNDOING IS A NEW ROW, NEVER AN EDIT. The obvious alternative — `undone_at`
/// and `undone_by` on the merge row — needs a hole in the immutability trigger
/// to allow that one transition, and an append-only table "except for these
/// two columns" is a convention somebody has to remember, not a guarantee.
///
/// The guarantees live in `20260817204801_patient_merge_events` and NOT in
/// this file, which cannot describe them: the trigger that refuses UPDATE,
/// DELETE and TRUNCATE, and the one that refuses an undo row naming a
/// different pair of charts than the merge it claims to undo.
model PatientMerge {
  id BigInt @id @default(autoincrement())

  event PatientMergeEvent

  sourcePatientId String  @map("source_patient_id") @db.Uuid
  sourcePatient   Patient @relation("MergeSource", fields: [sourcePatientId], references: [id], onDelete: Restrict)

  targetPatientId String  @map("target_patient_id") @db.Uuid
  targetPatient   Patient @relation("MergeTarget", fields: [targetPatientId], references: [id], onDelete: Restrict)

  /// PA-047. The merge this row undoes. UNIQUE, so a merge is undone exactly
  /// once and «is this merge undone?» is a lookup instead of a guess from
  /// dates — which stops being answerable the day the same pair is merged
  /// again.
  undoesMergeId BigInt?       @unique(map: "patient_merge_undone_once") @map("undoes_merge_id")
  undoes        PatientMerge? @relation("MergeUndo", fields: [undoesMergeId], references: [id], onDelete: Restrict)
  undoneBy      PatientMerge? @relation("MergeUndo")

  /// PA-044. NOT NULL and with a foreign key: merging joins two people's
  /// clinical records, and the question to answer twelve months later is who
  /// did it.
  performedBy String   @map("performed_by") @db.Uuid
  performedByUser User @relation("PatientMergeAuthor", fields: [performedBy], references: [id], onDelete: Restrict)

  performedAt DateTime @default(now()) @map("performed_at") @db.Timestamptz(6)

  /// PA-044, PA-047. Mandatory on BOTH events, and a CHECK refuses it blank:
  /// a mandatory reason is what tells this apart from a click.
  reason String @db.Text

  /// Snapshot of the source row and its children at merge time. Present on the
  /// MERGE row and absent on the UNDO one, tied to `event` by a CHECK: there is
  /// nothing to undo about an undo, and the chart cannot have changed while
  /// merged (PA-045), so a snapshot there would be invented.
  sourceSnapshot Json? @map("source_snapshot") @db.JsonB

  @@index([targetPatientId])
  @@index([sourcePatientId])
  @@map("patient_merge")
}

// ---------------------------------------------------------------------------
// AGENDA
// ---------------------------------------------------------------------------

/// Appointments AND calendar blocks in one table.
///
/// One table because they compete for the same resource — the practitioner's
/// time — and PostgreSQL cannot enforce an exclusion constraint across two
/// tables. Split them and "never book on top of a holiday" goes back to being
/// application logic, which is to say a race condition waiting for a Monday
/// morning with two receptionists.
///
/// The non-overlap guarantee lives in a manual migration:
///   EXCLUDE USING gist (practitioner_id WITH =,
///                       tstzrange(starts_at, ends_at, '[)') WITH &&)
///   WHERE (released_at IS NULL AND blocks_calendar)
model AgendaEntry {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  kind AgendaEntryKind

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  roomId String?   @map("room_id") @db.Uuid
  room   SiteRoom? @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /// NULL exactly when kind = BLOCK. Enforced by CHECK in a manual migration.
  patientId String?  @map("patient_id") @db.Uuid
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Restrict)

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  /// false = deliberate overbooking (an urgent case squeezed in). The exclusion
  /// constraint ignores these rows, so the rule gets broken on purpose and on
  /// the record instead of being worked around.
  blocksCalendar Boolean @default(true) @map("blocks_calendar")

  /// AG-035, AG-036, D-005. The constancy of an overbooking: WHO authorised it
  /// and WHY the grid was broken. Both are set exactly when
  /// `blocksCalendar` is false and both are null otherwise — guaranteed by
  /// `agenda_entry_overbooking_coherence` (manual migration), which Prisma
  /// cannot express.
  ///
  /// THE AUTHORISER IS NOT `createdById`, and that is the whole control: whoever
  /// books an overbooking may not authorise it (AG-103) unless they hold
  /// `agenda:overbook:self`. One column for both roles would make the rule
  /// unverifiable from the row.
  ///
  /// AND THE REASON IS NOT `reason`: that one is free text where reception
  /// writes the motive for the visit — health data no listing serves back
  /// (AG-072, AG-074). This one is administrative and travels in every listing.
  overbookingAuthorisedById String? @map("overbooking_authorised_by_id") @db.Uuid
  overbookingAuthorisedBy   User?   @relation("OverbookingAuthoriser", fields: [overbookingAuthorisedById], references: [id], onDelete: Restrict)
  overbookingReason         String? @map("overbooking_reason") @db.VarChar(512)

  /// NULL means the slot still occupies the calendar. A two-column predicate
  /// keeps the exclusion constraint stable when new statuses appear: adding
  /// RESCHEDULED to the enum must not force a rebuild of the GiST index.
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)

  status AgendaStatus @default(BOOKED)

  /// SP-028: el tipo de atención que recepción eligió al reservar, y con el
  /// que se resolvió la duración (SP-023). `RESTRICT` es lo que produce
  /// SP-025 — borrar un tipo con citas se rechaza en la base, no en TypeScript.
  serviceTypeId String?      @map("service_type_id") @db.Uuid
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  reason String? @db.VarChar(512)

  /// Required exactly when kind = APPOINTMENT (AG-029); NULL on a block, which
  /// nobody books. Enforced by `agenda_entry_booking_channel_coherence` in a
  /// manual migration — a CHECK and not NOT NULL, because half the rows may
  /// legitimately be empty.
  bookingChannel BookingChannel? @map("booking_channel")

  checkedInAt      DateTime? @map("checked_in_at") @db.Timestamptz(6)
  noShowAt         DateTime? @map("no_show_at") @db.Timestamptz(6)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationNote String?   @map("cancellation_note") @db.VarChar(512)

  /// AG-050, AG-051: la cita de la que ésta procede al reprogramar, y NULL en
  /// toda cita reservada directamente. Reprogramar no mueve el intervalo de la
  /// fila existente: la libera y crea ésta, que es la que apunta hacia atrás.
  ///
  /// DECLARADA COMO 1:N Y GARANTIZADA 1:1 POR LA BASE. El índice único es
  /// PARCIAL (`WHERE rescheduled_from_id IS NOT NULL`, migración
  /// `agenda_reschedule_link`) y Prisma no puede describir el predicado, así
  /// que `@unique` aquí generaría un índice distinto del que existe. La lista
  /// de abajo tiene, por tanto, cero o un elemento — nunca más.
  rescheduledFromId String?      @map("rescheduled_from_id") @db.Uuid
  rescheduledFrom   AgendaEntry? @relation("AgendaEntryReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  statusHistory  AgendaStatusHistory[]
  encounter      Encounter?
  waitlistOrigin WaitlistEntry[]
  /// AG-051, el sentido de ida: la cita que sustituyó a ésta. Cero o una.
  rescheduledTo  AgendaEntry[]         @relation("AgendaEntryReschedule")

  @@index([practitionerId, startsAt])
  @@index([siteId, startsAt])
  @@index([patientId, startsAt(sort: Desc)])
  @@map("agenda_entry")
}

/// Append-only transition log. Without it, "the appointment showed up as
/// cancelled" has no answer.
///
/// AG-005, SC-005, D-022: append-only is enforced by the DATABASE, not by the
/// habits of this module. `trg_agenda_status_history_immutable` refuses UPDATE
/// and DELETE, `trg_agenda_status_history_no_truncate` refuses TRUNCATE, and
/// neither is expressible here — see the migration
/// `agenda_status_history_immutable`.
model AgendaStatusHistory {
  id BigInt @id @default(autoincrement())

  agendaEntryId String @map("agenda_entry_id") @db.Uuid
  /// `Restrict` and not `Cascade` (D-022): deleting an appointment used to take
  /// its whole trail with it, in silence, which contradicts SPEC §5 — an
  /// appointment is not deleted, it is cancelled, released or marked.
  agendaEntry   AgendaEntry @relation(fields: [agendaEntryId], references: [id], onDelete: Restrict)

  fromStatus AgendaStatus? @map("from_status")
  toStatus   AgendaStatus  @map("to_status")

  changedById String?  @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  note        String?  @db.VarChar(512)

  @@index([agendaEntryId, changedAt])
  @@map("agenda_status_history")
}

model WaitlistEntry {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// NULL = any practitioner offering the requested service type.
  practitionerId String?       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  serviceTypeConceptId String?         @map("service_type_concept_id") @db.Uuid
  serviceType          CatalogConcept? @relation("WaitlistServiceType", fields: [serviceTypeConceptId], references: [id], onDelete: Restrict)

  /// AG-060. Between which dates the appointment is of any use to the patient.
  ///
  /// NOT NULL SINCE `agenda_waitlist_contact_trail`, and both of them: AG-060
  /// lists the range among what an entry carries and marks only practitioner
  /// and service type as optional, and AG-065 — «CUANDO la fecha preferida
  /// máxima quede en el pasado, márquela EXPIRED» — never triggers on a NULL,
  /// so an entry without an upper bound would compete for every slot of the
  /// site forever. `waitlist_entry_preferred_range_valid` refuses an inverted
  /// range.
  preferredFrom DateTime @map("preferred_from") @db.Date
  preferredTo   DateTime @map("preferred_to") @db.Date

  status WaitlistStatus @default(WAITING)

  /// AG-064. Every contact attempt, with its instant, its author and what
  /// happened. THE COUNT AND THE LAST INSTANT ARE DERIVED FROM HERE — the
  /// `contact_attempts` and `last_contacted_at` columns this table used to
  /// carry were dropped, because two statements of one fact drift and only the
  /// cached one can be wrong.
  contactAttempts WaitlistContactAttempt[]

  /// AG-063. The appointment this entry became, and `status = SCHEDULED`, are
  /// the same fact: `waitlist_entry_conversion_complete` is a biconditional,
  /// `waitlist_entry_one_per_converted_entry` (partial unique index, invisible
  /// to Prisma) refuses two entries claiming one slot, and
  /// `trg_waitlist_entry_conversion_consented` refuses an appointment of
  /// another patient or a conversion with no recorded acceptance.
  convertedEntryId String?      @map("converted_entry_id") @db.Uuid
  convertedEntry   AgendaEntry? @relation(fields: [convertedEntryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// NO INDEX BY `(site_id, status, …)` DECLARED HERE, and it is not missing:
  /// AG-061 only ever asks for the OPEN candidates of a site, so the index is
  /// PARTIAL (`waitlist_entry_open_candidates`, `WHERE status IN ('WAITING',
  /// 'CONTACTED')`) and Prisma cannot describe the predicate — declaring it
  /// here would create a second, wider index instead. The priority the listing
  /// orders by is not stored either (PA-041): it is derived from the groups in
  /// force on the day the candidates are proposed.
  @@index([patientId])
  @@map("waitlist_entry")
}

/// AG-064. One call, with who made it, when, and what came of it.
///
/// A TABLE AND NOT A COUNTER, which is what `waitlist_entry` carried until
/// `agenda_waitlist_contact_trail`: with `contact_attempts = 3` nobody can say
/// when the first two were, who called, or what the patient answered — and
/// «¿por qué el cupo se lo llevó ella y no yo, que estaba antes?» is the
/// question a waiting list exists to be able to answer.
///
/// APPEND-ONLY, ENFORCED BY THE DATABASE (`trg_waitlist_contact_attempt_immutable`
/// and `trg_waitlist_contact_attempt_no_truncate`, neither expressible here):
/// a trail that can be rewritten after the slot was given away proves nothing.
model WaitlistContactAttempt {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  waitlistEntryId String        @map("waitlist_entry_id") @db.Uuid
  waitlistEntry   WaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Restrict)

  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)

  /// Who called. NOT NULL for the same reason as
  /// `patient_priority_group.recorded_by`: «se le llamó tres veces» with no
  /// name can neither be checked nor denied.
  recordedById String @map("recorded_by") @db.Uuid
  recordedBy   User   @relation("WaitlistContactRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  outcome WaitlistContactOutcome

  @@index([waitlistEntryId, attemptedAt(sort: Desc)], map: "waitlist_contact_attempt_by_entry")
  @@map("waitlist_contact_attempt")
}

// ---------------------------------------------------------------------------
// ENCOUNTER — the RDACAA row
// ---------------------------------------------------------------------------

model Encounter {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  practitionerId String       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// Walk-ins have no appointment. One-to-one when it exists.
  agendaEntryId String?      @unique @map("agenda_entry_id") @db.Uuid
  agendaEntry   AgendaEntry? @relation(fields: [agendaEntryId], references: [id], onDelete: Restrict)

  startedAt DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)

  careModality CareModality
  careSetting  CareSetting  @default(INTRAMURAL)

  /// First-time vs subsequent AT THIS ESTABLISHMENT. Per-diagnosis
  /// first/subsequent is a different field on `encounter_diagnosis`.
  visitSequence VisitSequence

  /// RDACAA reports the age the patient HAD on the day of care. Computed once
  /// by a BEFORE INSERT trigger and frozen: derive it on the fly and
  /// reprocessing an old report yields different numbers, and fixing a mistyped
  /// birth date silently rewrites reports already filed with the ministry.
  ageYears  Int? @map("age_years") @db.SmallInt
  ageMonths Int? @map("age_months") @db.SmallInt
  ageDays   Int? @map("age_days") @db.SmallInt

  dischargeCondition DischargeCondition?

  /// When this encounter was included in an RDACAA/PRAS submission. NULL means
  /// not yet reported, and drives the pending-report partial index.
  reportedAt DateTime? @map("reported_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vitals             EncounterVitals?
  violenceScreening  ViolenceScreening?
  priorityGroups     EncounterPriorityGroup[]
  diagnoses          EncounterDiagnosis[]
  procedures         EncounterProcedure[]
  notes              ClinicalNote[]
  prescriptions      Prescription[]
  serviceOrders      ServiceOrder[]
  certificates       MedicalCertificate[]
  referrals          Referral[]
  interconsultations Interconsultation[]

  @@index([patientId, startedAt(sort: Desc)])
  @@index([practitionerId, startedAt(sort: Desc)])
  @@index([siteId, startedAt])
  @@map("encounter")
}

/// Anthropometry and vital signs. RDACAA mandates weight, height, head
/// circumference, abdominal circumference and BMI per attention.
model EncounterVitals {
  encounterId String    @id @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  weightKg                 Decimal? @map("weight_kg") @db.Decimal(6, 3)
  heightCm                 Decimal? @map("height_cm") @db.Decimal(5, 1)
  headCircumferenceCm      Decimal? @map("head_circumference_cm") @db.Decimal(5, 1)
  abdominalCircumferenceCm Decimal? @map("abdominal_circumference_cm") @db.Decimal(5, 1)

  /// Written by a BEFORE INSERT OR UPDATE trigger, never by the application.
  /// Not a PostgreSQL 18 generated column: Prisma does not model those and
  /// would try to INSERT into it, and a VIRTUAL column cannot be indexed — and
  /// BMI is filtered in nutritional screening.
  bmi Decimal? @db.Decimal(5, 2)

  systolicBp       Int?     @map("systolic_bp") @db.SmallInt
  diastolicBp      Int?     @map("diastolic_bp") @db.SmallInt
  heartRate        Int?     @map("heart_rate") @db.SmallInt
  respiratoryRate  Int?     @map("respiratory_rate") @db.SmallInt
  temperatureC     Decimal? @map("temperature_c") @db.Decimal(4, 1)
  oxygenSaturation Int?     @map("oxygen_saturation") @db.SmallInt

  measuredAt DateTime @default(now()) @map("measured_at") @db.Timestamptz(6)

  @@map("encounter_vitals")
}

/// RDACAA priority and vulnerable groups, recorded per attention.
///
/// A join table instead of ten booleans: when the ministry adds a category this
/// absorbs it with an INSERT. Booleans need a schema migration and leave every
/// historical row with `false` where the honest value is "did not apply".
model EncounterPriorityGroup {
  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  conceptId String         @map("concept_id") @db.Uuid
  concept   CatalogConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@id([encounterId, conceptId])
  @@map("encounter_priority_group")
}

/// RDACAA violence screening.
///
/// Its own table, not four columns on `encounter`, because its access regime
/// differs: it is the most sensitive item in the record. A table can be REVOKEd
/// TODO: no REVOKE, no separate permission and no distinct flow exists yet.
/// The separation is a design intent, not a property the schema currently has.
/// and audited separately; a column cannot without column-level grants.
model ViolenceScreening {
  encounterId String    @id @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  result ViolenceScreeningResult @default(NOT_APPLIED)

  /// Several types can coexist in a single case.
  types ViolenceType[]

  screeningTool       String? @map("screening_tool") @db.VarChar(80)
  actionTaken         String? @map("action_taken") @db.Text
  reportedToAuthority Boolean @default(false) @map("reported_to_authority")

  screenedById String?  @map("screened_by_id") @db.Uuid
  screenedAt   DateTime @default(now()) @map("screened_at") @db.Timestamptz(6)

  @@map("violence_screening")
}

/// FHIR Condition.
model EncounterDiagnosis {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  /// The exact VERSION of the CIE-10 concept in force on the day of care. This
  /// makes historical resolution automatic instead of a query somebody has to
  /// remember to write.
  conceptId String         @map("concept_id") @db.Uuid
  concept   CatalogConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  /// Deliberately redundant with the catalogue. In fifteen years the catalogue
  /// may have been migrated, pruned or reloaded; the record must still say what
  /// was diagnosed. Same reason an invoice stores the price, not just the
  /// product id.
  cie10Code    String @map("cie10_code") @db.VarChar(10)
  cie10Display String @map("cie10_display") @db.VarChar(512)

  certainty  DiagnosisCertainty
  occurrence DiagnosisOccurrence

  /// 1 = principal diagnosis. Unique per encounter via a partial unique index.
  rank Int @default(1) @db.SmallInt

  /// Mandatory epidemiological notification (dengue, tuberculosis...).
  notifiable Boolean @default(false)

  note String? @db.Text

  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@index([encounterId])
  @@index([cie10Code, recordedAt])
  @@map("encounter_diagnosis")
}

/// FHIR Procedure.
model EncounterProcedure {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  conceptId String         @map("concept_id") @db.Uuid
  concept   CatalogConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  procedureCode    String @map("procedure_code") @db.VarChar(20)
  procedureDisplay String @map("procedure_display") @db.VarChar(512)

  quantity Int @default(1) @db.SmallInt

  /// Frozen tariff amount. Money is always Decimal(12,2), never Float.
  tariffAmount Decimal? @map("tariff_amount") @db.Decimal(12, 2)

  performedAt DateTime @default(now()) @map("performed_at") @db.Timestamptz(6)
  note        String?  @db.Text

  @@index([encounterId])
  @@map("encounter_procedure")
}

// ---------------------------------------------------------------------------
// CLINICAL NOTES — MSP forms
// ---------------------------------------------------------------------------

/// Append-only clinical note with an amendment chain.
///
/// A signed note is never edited; it is superseded by a new version stating who
/// amended it and why. Chosen over system-versioned tables (which PostgreSQL 18
/// still does not provide natively) and over SCD-2, because an amendment is a
/// CLINICAL ACT that must be readable, printable and citable in a legal
/// proceeding — not a side effect of how rows are stored.
model ClinicalNote {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Lineage identifier, constant across every version. Version 1 sets it to
  /// its own id.
  chainId String @map("chain_id") @db.Uuid
  version Int    @default(1) @db.SmallInt

  /// MSP form code: 002 (consulta externa), 005 (evolución y prescripciones),
  /// 007 (interconsulta), 053 / legacy 011 (referencia-contrarreferencia).
  /// Stored as data, not baked into the schema, so a renumbering by the
  /// ministry costs an UPDATE and not a migration.
  formCode    String @map("form_code") @db.VarChar(8)
  formVersion String @default("1") @map("form_version") @db.VarChar(16)

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  status NoteStatus @default(DRAFT)

  /// Narrative sections of the form. Typed columns carry everything the
  /// ministry reports on or the system queries; prose that is only displayed
  /// and printed lives here, validated against a JSON Schema keyed by
  /// (form_code, form_version).
  content Json @db.JsonB

  authorId String       @map("author_id") @db.Uuid
  author   Practitioner @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  signedById String?       @map("signed_by_id") @db.Uuid
  signedBy   Practitioner? @relation("NoteSigner", fields: [signedById], references: [id], onDelete: Restrict)
  signedAt   DateTime?     @map("signed_at") @db.Timestamptz(6)

  /// SHA-256 of the canonicalised content plus signing metadata. Proves the
  /// content has not changed since signature WITHOUT relying on the
  /// immutability trigger never having been disabled.
  contentHash String? @map("content_hash") @db.Char(64)

  supersedesId String?       @unique @map("supersedes_id") @db.Uuid
  supersedes   ClinicalNote? @relation("NoteAmendment", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy ClinicalNote? @relation("NoteAmendment")

  /// Mandatory free text when creating an amendment. A dropdown gets filled in
  /// on autopilot; a text box does not.
  amendmentReason String? @map("amendment_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  prescriptions Prescription[]

  @@index([encounterId, formCode])
  @@index([chainId, version])
  @@map("clinical_note")
}

// ---------------------------------------------------------------------------
// PRESCRIPTION (form 005)
// ---------------------------------------------------------------------------

model Prescription {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  /// The form-005 note this prescription was issued with, when there is one.
  noteId String?       @map("note_id") @db.Uuid
  note   ClinicalNote? @relation(fields: [noteId], references: [id], onDelete: Restrict)

  prescriberId String       @map("prescriber_id") @db.Uuid
  prescriber   Practitioner @relation(fields: [prescriberId], references: [id], onDelete: Restrict)

  status   PrescriptionStatus @default(DRAFT)
  issuedAt DateTime?          @map("issued_at") @db.Timestamptz(6)

  /// Short code printed on the prescription so a pharmacy can verify it without
  /// receiving any clinical data.
  verificationCode String? @unique @map("verification_code") @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items PrescriptionItem[]

  @@index([encounterId])
  @@map("prescription")
}

/// FHIR MedicationRequest — one per line of the prescription.
model PrescriptionItem {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  prescriptionId String       @map("prescription_id") @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  /// CNMB concept version. NULL only when prescribing outside the CNMB, which
  /// then requires `offFormularyJustification` (enforced by CHECK).
  conceptId String?         @map("concept_id") @db.Uuid
  concept   CatalogConcept? @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  /// Frozen at prescription time, for the same reason as the CIE-10 display.
  genericName   String  @map("generic_name") @db.VarChar(240)
  presentation  String? @db.VarChar(160)
  concentration String? @db.VarChar(80)

  doseText      String   @map("dose_text") @db.VarChar(160)
  routeCode     String?  @map("route_code") @db.VarChar(32)
  frequencyText String   @map("frequency_text") @db.VarChar(160)
  durationDays  Int?     @map("duration_days") @db.SmallInt
  quantity      Decimal? @db.Decimal(10, 2)
  instructions  String?  @db.Text

  /// Prescribing outside the CNMB is allowed but must be justified in writing.
  offFormularyJustification String? @map("off_formulary_justification") @db.Text

  @@index([prescriptionId])
  @@map("prescription_item")
}

// ---------------------------------------------------------------------------
// ORDERS AND RESULTS
// ---------------------------------------------------------------------------

/// FHIR ServiceRequest.
model ServiceOrder {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  orderedById String       @map("ordered_by_id") @db.Uuid
  orderedBy   Practitioner @relation(fields: [orderedById], references: [id], onDelete: Restrict)

  category ServiceOrderCategory
  priority ServiceOrderPriority @default(ROUTINE)

  clinicalNoteText String? @map("clinical_note_text") @db.Text

  /// Denormalised count maintained by trigger. It exists only so the "pending
  /// results" worklist can be a partial index: index predicates cannot contain
  /// subqueries.
  pendingItems Int @default(0) @map("pending_items") @db.SmallInt

  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items   ServiceOrderItem[]
  reports DiagnosticReport[]

  @@index([encounterId])
  @@index([siteId, requestedAt])
  @@map("service_order")
}

model ServiceOrderItem {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  serviceOrderId String       @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  conceptId String         @map("concept_id") @db.Uuid
  concept   CatalogConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  testCode    String @map("test_code") @db.VarChar(32)
  testDisplay String @map("test_display") @db.VarChar(240)

  status ServiceOrderItemStatus @default(REQUESTED)

  /// NULL means pending. The pending-results worklist is a partial index on
  /// this column, so rows LEAVE the index when they complete and it stays
  /// permanently small and cache-resident.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  results ObservationResult[]

  @@index([serviceOrderId])
  @@map("service_order_item")
}

/// FHIR DiagnosticReport.
model DiagnosticReport {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  serviceOrderId String       @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)

  status DiagnosticReportStatus @default(PARTIAL)

  performedById String?       @map("performed_by_id") @db.Uuid
  performedBy   Practitioner? @relation(fields: [performedById], references: [id], onDelete: Restrict)

  conclusion String?   @db.Text
  issuedAt   DateTime? @map("issued_at") @db.Timestamptz(6)

  /// Corrections follow the same rule as clinical notes: a new report that
  /// supersedes the previous one, never an in-place edit. A result already read
  /// by a clinician may have changed a treatment decision.
  supersedesId String?           @unique @map("supersedes_id") @db.Uuid
  supersedes   DiagnosticReport? @relation("ReportCorrection", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy DiagnosticReport? @relation("ReportCorrection")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  results ObservationResult[]

  @@index([serviceOrderId])
  @@map("diagnostic_report")
}

/// FHIR Observation (laboratory). BigInt and not UUID: this is the one clinical
/// table with genuinely high row counts — a metabolic panel is ~20 rows — and
/// they are only ever read through their report.
model ObservationResult {
  id BigInt @id @default(autoincrement())

  reportId String           @map("report_id") @db.Uuid
  report   DiagnosticReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  orderItemId String?           @map("order_item_id") @db.Uuid
  orderItem   ServiceOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  analyteConceptId String?         @map("analyte_concept_id") @db.Uuid
  analyte          CatalogConcept? @relation("ObservationAnalyte", fields: [analyteConceptId], references: [id], onDelete: Restrict)

  analyteDisplay String @map("analyte_display") @db.VarChar(240)

  /// Three value columns because lab results are genuinely polymorphic:
  /// numeric (glucose 92), coded (blood group O+) and textual (culture: no
  /// growth at 48h). A CHECK enforces that exactly one is populated.
  valueNumeric Decimal? @map("value_numeric") @db.Decimal(18, 6)
  valueText    String?  @map("value_text") @db.Text
  valueCode    String?  @map("value_code") @db.VarChar(64)

  unit          String?  @db.VarChar(32)
  referenceLow  Decimal? @map("reference_low") @db.Decimal(18, 6)
  referenceHigh Decimal? @map("reference_high") @db.Decimal(18, 6)
  referenceText String?  @map("reference_text") @db.VarChar(160)

  abnormalFlag AbnormalFlag? @map("abnormal_flag")

  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)

  @@index([reportId])
  @@index([analyteConceptId, observedAt(sort: Desc)])
  @@map("observation_result")
}

// ---------------------------------------------------------------------------
// CERTIFICATES, REFERRAL, INTERCONSULTATION
// ---------------------------------------------------------------------------

model MedicalCertificate {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  issuedById String       @map("issued_by_id") @db.Uuid
  issuedBy   Practitioner @relation(fields: [issuedById], references: [id], onDelete: Restrict)

  type CertificateType

  /// Rest period for MEDICAL_REST. Two dates and not a daterange so Prisma can
  /// read and write them; the range is only needed inside constraints.
  restFrom DateTime? @map("rest_from") @db.Date
  restTo   DateTime? @map("rest_to") @db.Date

  /// The patient decides whether the diagnosis appears on the certificate their
  /// employer will read. Defaults to hidden: privacy by default is an LOPDP
  /// requirement, not a preference.
  includeDiagnosis Boolean @default(false) @map("include_diagnosis")

  body String @db.Text

  /// Printed as a QR so a third party can verify the certificate is genuine
  /// without receiving any clinical data.
  verificationCode String @unique @map("verification_code") @db.VarChar(24)

  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?   @map("revocation_reason") @db.Text

  @@index([patientId, issuedAt(sort: Desc)])
  @@map("medical_certificate")
}

/// MSP form 053 (legacy numbering 011): referral, derivation and
/// counter-referral. One table with a direction, because the counter-referral
/// is the answer to a referral and belongs on the same thread.
model Referral {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  issuedById String       @map("issued_by_id") @db.Uuid
  issuedBy   Practitioner @relation("ReferralIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  direction ReferralDirection
  status    ReferralStatus    @default(ISSUED)

  /// MSP unique code of the destination establishment. A plain string and not
  /// an FK: the destination is normally outside this clinic.
  destinationMspUnicode String? @map("destination_msp_unicode") @db.VarChar(20)
  destinationName       String? @map("destination_name") @db.VarChar(240)

  specialtyConceptId String?         @map("specialty_concept_id") @db.Uuid
  specialty          CatalogConcept? @relation("ReferralSpecialty", fields: [specialtyConceptId], references: [id], onDelete: Restrict)

  reason   String               @db.Text
  summary  String?              @db.Text
  priority ServiceOrderPriority @default(ROUTINE)

  /// A counter-referral answers a referral. Self-relation on the same thread.
  respondsToId String?   @unique @map("responds_to_id") @db.Uuid
  respondsTo   Referral? @relation("ReferralThread", fields: [respondsToId], references: [id], onDelete: Restrict)
  response     Referral? @relation("ReferralThread")

  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([patientId, issuedAt(sort: Desc)])
  @@index([status, issuedAt])
  @@map("referral")
}

/// MSP form 007.
model Interconsultation {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  encounterId String    @map("encounter_id") @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  requestedById String       @map("requested_by_id") @db.Uuid
  requestedBy   Practitioner @relation("InterconsultRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  respondedById String?       @map("responded_by_id") @db.Uuid
  respondedBy   Practitioner? @relation("InterconsultResponder", fields: [respondedById], references: [id], onDelete: Restrict)

  specialtyConceptId String?         @map("specialty_concept_id") @db.Uuid
  specialty          CatalogConcept? @relation("InterconsultationSpecialty", fields: [specialtyConceptId], references: [id], onDelete: Restrict)

  status InterconsultationStatus @default(REQUESTED)

  reason   String  @db.Text
  findings String? @db.Text
  opinion  String? @db.Text

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)

  @@index([encounterId])
  @@index([status, requestedAt])
  @@map("interconsultation")
}
