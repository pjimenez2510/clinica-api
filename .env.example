# Plantilla de configuración. Copiar a `.env` y rellenar.
# NUNCA poner valores reales aquí: este archivo SÍ va al repositorio.

NODE_ENV=development
PORT=3000
# Siempre UTC. Las fechas se renderizan en la zona de la sede, no en la del host.
TZ=UTC

DATABASE_URL=postgresql://clinica:clinica_dev@localhost:5432/clinica?schema=public

# --- Autenticación ---
# Claves Ed25519 en PEM, con saltos de línea escapados como \n.
# Generar con:
#   node -e "const{generateKeyPairSync}=require('node:crypto');const k=generateKeyPairSync('ed25519');console.log(JSON.stringify(k.privateKey.export({type:'pkcs8',format:'pem'}).toString()));console.log(JSON.stringify(k.publicKey.export({type:'spki',format:'pem'}).toString()))"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DIAS=7

# Cifra los secretos TOTP en reposo. 32 bytes en base64:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# --- Infraestructura ---
# Redis es solo caché y rate limiting. Las colas van en PostgreSQL (pg-boss),
# para poder encolar dentro de la misma transacción que el dato de negocio.
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=clinica
S3_REGION=us-east-1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-responder@clinica.local

# --- Ecuador ---
# 1 = pruebas (celcer), 2 = producción (cel).
# Explícito a propósito: emitir contra producción debe ser una decisión consciente.
SRI_AMBIENTE=1
SRI_RUC_EMISOR=

# OJO: para Galápagos es `Pacific/Galapagos`. `America/Galapagos` NO existe
# y lanza RangeError en tiempo de ejecución.
ZONA_HORARIA_DEFECTO=America/Guayaquil

# --- Observabilidad ---
LOG_LEVEL=debug
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Orígenes permitidos separados por coma. Nunca '*' con datos de salud.
CORS_ORIGINS=http://localhost:3001
