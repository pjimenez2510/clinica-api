# Configuration template. Copy to `.env` and fill in.
# NEVER put real values here: this file IS committed.

NODE_ENV=development
PORT=3000
# Number of reverse proxies in front of the API. NEVER `true`: trusting the
# whole X-Forwarded-For chain lets a client forge an address and mint itself a
# fresh rate-limit bucket on every request. 0 means the API is exposed
# directly; behind one nginx it is 1.
TRUST_PROXY_HOPS=0
# Always UTC. Dates render in the site's timezone, not the host's.
TZ=UTC

DATABASE_URL=postgresql://clinica:clinica_dev@localhost:5432/clinica?schema=public

# --- Authentication ---
# Ed25519 keys in PEM, with newlines escaped as \n. Generate with:
#   node -e "const{generateKeyPairSync}=require('node:crypto');const k=generateKeyPairSync('ed25519');console.log(JSON.stringify(k.privateKey.export({type:'pkcs8',format:'pem'}).toString()));console.log(JSON.stringify(k.publicKey.export({type:'spki',format:'pem'}).toString()))"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# AU-039: seconds in which the refresh token just rotated may be presented
# again by the same client (lost response) without revoking the session.
# 0-60, 0 disables it. See src/modules/auth/SPEC.md.
JWT_REFRESH_REUSE_GRACE_SECONDS=30

# Encrypts TOTP secrets at rest. 32 bytes in base64:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# --- Infrastructure ---
# Redis is cache and rate limiting only. Queues live in PostgreSQL (pg-boss),
# so a job can be enqueued inside the same transaction as the business data.
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=clinica
S3_REGION=us-east-1

# Mailpit en desarrollo (docker compose): SMTP en 1025, bandeja en
# http://localhost:8025. Sin SMTP_HOST el alta de una cuenta sigue
# funcionando, pero la invitación no sale y la respuesta lo dice
# (`invitationSent: false`).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@clinica.local

# Dónde vive la interfaz. El enlace de la invitación de credencial
# apunta aquí, a `/acceso/credencial`, no a la API.
WEB_BASE_URL=http://localhost:3001

# --- Ecuador ---
# 1 = testing (celcer), 2 = production (cel).
# Explicit on purpose: issuing against production must be a conscious decision.
SRI_ENVIRONMENT=1
SRI_ISSUER_RUC=

# --- SRI: comprobantes electrónicos (sri/SPEC.md) ---
# Los dos servicios offline SIN `?wsdl`. En desarrollo, el DOBLE LOCAL del SRI
# (`pnpm sri:double`, puerto 8099). Un host no local se rechaza al arrancar
# salvo SRI_ALLOW_REMOTE=true: conectar con el SRI real lo hace el autor (§9).
SRI_RECEPTION_URL=http://localhost:8099/comprobantes-electronicos-ws/RecepcionComprobantesOffline
SRI_AUTHORISATION_URL=http://localhost:8099/comprobantes-electronicos-ws/AutorizacionComprobantesOffline
SRI_ALLOW_REMOTE=false
# RUTA del fichero con la frase maestra que cifra el .p12 (Docker secret en
# producción). NUNCA la frase en una variable. `pnpm sri:certificate:dev` crea
# uno de desarrollo en .dev-secrets/ (ignorado por git).
SRI_CERTIFICATE_MASTER_KEY_FILE=.dev-secrets/sri-master-key
# Forma de pago de la Tabla 24 (D-092: la decide la clínica con su contador).
# `01` aquí es un VALOR DE PRUEBA para desarrollo, no una decisión.
SRI_DEFAULT_PAYMENT_METHOD=01
# Anexo 26 «RUC Proveedor» (D-091). Vacío: el campo no se emite.
SRI_SOFTWARE_PROVIDER_RUC=

# CAREFUL: for the Galapagos it is `Pacific/Galapagos`. `America/Galapagos`
# does NOT exist and throws a RangeError at runtime.
DEFAULT_TIMEZONE=America/Guayaquil

# --- Observability ---
LOG_LEVEL=debug
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Allowed origins, comma separated. Never '*' with health data.
CORS_ORIGINS=http://localhost:3001
